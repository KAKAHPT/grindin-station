<section class="p-5 rounded-2xl bg-surface border border-line shadow-raised">
  <h2 class="font-display text-xl font-semibold"><%= t("play.report_result") %></h2>
  <p class="text-[11px] font-semibold uppercase tracking-wide text-muted"><%= t("play.tables.table") %> <%= @pod.number %></p>

  <%= form_with url: play_pod_report_path(current_event.slug, @pod, locale: params[:locale]), class: "mt-4" do |f| %>
    <%= hidden_field_tag :type, "Win" %>
    <fieldset class="space-y-2">
      <legend class="text-sm text-muted mb-2"><%= t("play.reports.who_won") %></legend>
      <% @seatings.each do |seating| %>
        <% participant = seating.event_participant %>
        <label class="flex items-center gap-3 min-h-12 px-4 rounded-md bg-surface-raised border border-line has-[:checked]:border-accent/60 has-[:checked]:bg-accent/[0.08]">
          <%= radio_button_tag :winner_id, participant.id, participant.id == current_participant.id, class: "text-accent bg-surface border-line focus:ring-accent" %>
          <span><% unless @pod.event.one_v_one? %><span class="font-display font-semibold text-muted"><%= seating.order %></span> <% end %><%= participant.name %></span>
        </label>
      <% end %>
    </fieldset>
    <% if @pod.event.one_v_one? %>
      <fieldset class="mt-4 grid grid-flow-col auto-cols-fr gap-2">
        <legend class="text-sm text-muted mb-2"><%= t("play.score") %></legend>
        <% winner_score_options(@pod.event).each_with_index do |(label, value), i| %>
          <label title="<%= score_option_title(label, value) %>" class="flex items-center justify-center gap-2 min-h-12 px-4 rounded-md bg-surface-raised border border-line has-[:checked]:border-accent/60 has-[:checked]:bg-accent/[0.08]">
            <%= radio_button_tag :games, value, i.zero?, "aria-label": score_option_title(label, value), class: "text-accent bg-surface border-line focus:ring-accent" %>
            <span class="font-display font-semibold"><%= label %><% if value == TournamentsHelper::ON_TIME_SCORE %> <span class="text-[10px] font-normal text-muted"><%= t("rounds.on_time_hint") %></span><% end %></span>
          </label>
        <% end %>
      </fieldset>
    <% end %>
    <%= f.button t("play.submit"), class: button_classes(:primary, "mt-4 w-full") %>
  <% end %>

  <% unless @pod.round.is_a?(SingleEliminationRound) %>
    <% if @pod.event.one_v_one? %>
      <div class="mt-3 grid grid-flow-col auto-cols-fr gap-2">
        <% draw_score_options(@pod.event).each do |label, value| %>
          <%= form_with url: play_pod_report_path(current_event.slug, @pod, locale: params[:locale]) do |f| %>
            <%= hidden_field_tag :type, "Draw", id: nil %>
            <%= hidden_field_tag :games, value, id: nil %>
            <%= f.button "#{t('play.draw')} #{label}", class: button_classes(:secondary, "w-full") %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= form_with url: play_pod_report_path(current_event.slug, @pod, locale: params[:locale]), class: "mt-3" do |f| %>
        <%= hidden_field_tag :type, "Draw" %>
        <%= f.button t("play.draw"), class: button_classes(:secondary, "w-full") %>
      <% end %>
    <% end %>
  <% end %>
</section>
