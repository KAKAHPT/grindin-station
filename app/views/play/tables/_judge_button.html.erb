<% if local_assigns[:called] %>
  <p data-judge-called class="mt-3 flex h-12 items-center justify-center gap-2 rounded-md border border-warn/40 bg-warn/10 text-warn font-display text-[13px] font-semibold">
    <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span><%= t("play.judge_called") %>
  </p>
<% else %>
  <%= button_to t("play.call_judge"), play_judge_calls_path(current_event.slug, locale: params[:locale]),
                form_class: "mt-3", class: button_classes(:secondary, "w-full") %>
<% end %>
