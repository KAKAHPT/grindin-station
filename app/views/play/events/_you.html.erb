<%# "You" card of a participant (enrolled or waitlisted): own chips, own decklist link (editable until round 1
    is published, then read-only) and Cancel registration (before the swiss). Nobody else's data. %>
<section data-you class="card">
  <h2 class="card-title"><%= t("play.events.you") %></h2>
  <div class="p-4 flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <% if participant.waitlisted? %>
        <span data-you-state><%= desk_chip(:info) { t("play.events.you_are_waitlisted", position: participant.waitlist_position) } %></span>
      <% else %>
        <span data-you-state><%= desk_chip(:ok) { t("play.events.you_are_enrolled") } %></span>
      <% end %>
      <% if participant.checked_in? %>
        <span data-checked-in><%= desk_chip(:ok) { t("play.events.checked_in") } %></span>
      <% end %>
    </div>

    <div>
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <label for="event_participant_decklist" class="text-[10.5px] font-semibold uppercase tracking-[0.08em] text-muted"><%= t("play.events.your_decklist") %></label>
        <% if participant.decklist.blank? %>
          <%= desk_chip(:missing) { t("play.events.decklist_missing") } %>
        <% end %>
      </div>
      <% if locked %>
        <input id="event_participant_decklist" data-decklist-locked type="text" readonly value="<%= participant.decklist %>"
               class="field-input opacity-80">
        <p class="mt-2 text-[11.5px] text-muted"><%= t("play.events.decklist_locked") %></p>
      <% else %>
        <%= form_with model: participant, url: tournament_event_participant_path(event, participant, locale: params[:locale]),
                      method: :patch, data: { decklist_form: true }, class: "flex gap-2" do |f| %>
          <%= f.text_field :decklist, placeholder: "https://moxfield.com/decks/…", class: "field-input flex-1 min-w-0" %>
          <%= f.button t("play.events.save"), class: button_classes(:primary, size: :sm) %>
        <% end %>
        <p class="mt-2 text-[11.5px] text-muted"><%= t("play.events.decklist_help") %></p>
      <% end %>
    </div>

    <% unless event.points_locked? %>
      <%= button_to t("play.events.cancel_registration"), tournament_event_participant_path(event, participant, locale: params[:locale]),
                    method: :delete, form: { class: "self-start" }, class: button_classes(:ghost, size: :sm),
                    data: { turbo_confirm: t("play.events.cancel_confirm") } %>
    <% end %>
  </div>
</section>
