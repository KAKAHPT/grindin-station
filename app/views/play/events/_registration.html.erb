<%# Registration card for anyone not in the event: the counts only (no names), then sign in, the enrol form (Join
    waiting list once the event is full and keeps a waiting list; none when it is full without one) or why
    registration is not open. %>
<% full = event.sold_out?(enrolled) %>
<% join_waitlist = full && event.waitlist_enabled %>
<% shut = full && !event.waitlist_enabled %>
<section data-registration class="card">
  <h2 class="card-title"><%= t("play.events.registration") %></h2>
  <div class="p-4 flex flex-col gap-3">
    <p data-counters class="text-[13px] text-muted">
      <%= t(event.registration_open? && !shut ? "play.events.counts_open" : "play.events.counts", count: enrolled) %>
      <% if event.waitlist_enabled || waitlist.positive? %>
        <%= t("play.events.counts_waitlist", count: waitlist) %>
      <% end %>
    </p>
    <% if event.registration_open? && current_participant.nil? && shut %>
      <p data-full class="text-[13px] text-warn/80"><%= t("play.events.full") %></p>
    <% elsif event.registration_open? && current_participant.nil? %>
      <% if join_waitlist %>
        <p class="text-[13px] text-warn"><%= t("play.events.full_waitlist") %></p>
      <% end %>
      <% if authenticated? %>
        <%= form_with model: EventParticipant.new, url: tournament_event_participants_path(event, locale: params[:locale]),
                      class: "flex flex-col gap-3" do |f| %>
          <label class="field">
            <%= t("play.events.your_decklist") %>
            <%= f.text_field :decklist, placeholder: t("play.events.decklist_placeholder"), class: "field-input" %>
          </label>
          <label class="flex items-start gap-2 text-[13px]">
            <%= f.check_box :accepted_terms, required: true, class: "field-check mt-0.5" %>
            <span><%= EventParticipant.human_attribute_name(:accepted_terms) %></span>
          </label>
          <%= f.button t(join_waitlist ? "play.events.join_waitlist" : "play.events.enrol"), class: button_classes(:primary, "w-full") %>
        <% end %>
      <% else %>
        <%= link_to t("play.events.sign_in_to_enrol"), new_session_path(locale: params[:locale]), class: button_classes(:primary, "w-full") %>
      <% end %>
    <% end %>
  </div>
</section>
