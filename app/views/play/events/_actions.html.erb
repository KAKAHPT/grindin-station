<% if participant&.playing? %>
  <% if participant.waitlisted? %>
    <p class="text-sm text-muted"><%= t("play.events.you_are_waitlisted", position: participant.waitlist_position) %></p>
  <% else %>
    <p class="text-sm text-muted"><%= t("play.events.you_are_enrolled") %></p>
  <% end %>
  <% unless event.points_locked? %>
    <%= button_to t("play.events.cancel_registration"), tournament_event_participant_path(event, participant, locale: params[:locale]),
                  method: :delete, form: { class: "w-full" }, class: button_classes(:danger, "w-full"),
                  data: { turbo_confirm: t("play.events.cancel_confirm") } %>
  <% end %>
<% elsif participant.nil? && event.registration_open? %>
  <% if authenticated? %>
    <%= form_with model: EventParticipant.new, url: tournament_event_participants_path(event, locale: params[:locale]),
                  class: "flex flex-col gap-3" do |f| %>
      <div>
        <%= f.label :decklist, class: "block mb-1 text-sm text-muted" %>
        <%= f.text_field :decklist, placeholder: t("play.events.decklist_placeholder"),
                         class: "h-12 w-full rounded-md border border-line bg-surface px-3 text-sm" %>
      </div>
      <label class="flex items-start gap-2 text-sm">
        <%= f.check_box :accepted_terms, required: true, class: "mt-0.5" %>
        <span><%= EventParticipant.human_attribute_name(:accepted_terms) %></span>
      </label>
      <%= f.button t("play.events.enrol"), class: button_classes(:primary, "w-full") %>
    <% end %>
  <% else %>
    <%= link_to t("play.events.sign_in_to_enrol"), new_session_path(locale: params[:locale]), class: button_classes(:primary, "w-full") %>
  <% end %>
<% end %>
