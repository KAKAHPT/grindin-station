<% event = current_event %>
<% participant = current_participant if current_participant&.playing? %>
<% content_for :wide_main, "1" %>
<%= render "play/shared/header", section: :event, players: @enrolled_count %>

<div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr] gap-3 items-start">
  <%= render "play/events/about", event: event %>
  <div class="flex flex-col gap-3">
    <% if participant %>
      <%= render "play/events/you", event: event, participant: participant, locked: @decklist_locked %>
    <% else %>
      <%= render "play/events/registration", event: event, enrolled: @enrolled_count, waitlist: @waitlist_count %>
    <% end %>
    <% if @staff_role %>
      <%= link_to t("play.events.manage"), organizer_tournament_path(event, locale: params[:locale]), class: button_classes(:ghost, "w-full", size: :sm) %>
    <% end %>
  </div>
</div>
