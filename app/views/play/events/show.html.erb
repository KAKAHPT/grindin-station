<% event = current_event %>
<% if event.cover.attached? %>
  <%= image_tag event.cover, alt: "", class: "-mx-4 -mt-4 mb-4 w-[calc(100%+2rem)] max-w-none aspect-[16/9] object-cover" %>
<% end %>

<section class="space-y-3">
  <div class="flex flex-wrap items-center gap-2">
    <span data-event-state><%= event_state_chip(event, @round_number) %></span>
    <% if event.one_v_one? %>
      <span data-event-format><%= desk_chip(:info) { t("play.events.format_badge", games: event.match_games) } %></span>
    <% end %>
  </div>
  <h2 class="font-display text-2xl font-semibold leading-tight"><%= event.name %></h2>

  <dl class="space-y-2 text-sm">
    <div class="flex gap-2">
      <dt class="w-20 shrink-0 text-muted"><%= t("play.events.when") %></dt>
      <dd>
        <%= time_tag event.start_time, l(event.start_time, format: t("play.events.time_format")) %>
        <% if event.end_time && event.end_time.to_date != event.start_time.to_date %>
          – <%= time_tag event.end_time, l(event.end_time, format: t("play.events.time_format")) %>
        <% end %>
      </dd>
    </div>
    <% if event.address.present? %>
      <div class="flex gap-2">
        <dt class="w-20 shrink-0 text-muted"><%= t("play.events.where") %></dt>
        <dd>
          <%= event.address %>
          <%= link_to t("play.events.open_map"), "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(event.address)}",
                      target: "_blank", rel: "noopener", class: "block text-accent hover:underline" %>
        </dd>
      </div>
    <% end %>
    <div class="flex gap-2">
      <dt class="w-20 shrink-0 text-muted"><%= t("play.events.price") %></dt>
      <dd data-event-price>
        <%= (event.price || 0).zero? ? t("play.events.free") : number_to_currency(event.price, number_to_currency_options(event.currency)) %>
      </dd>
    </div>
  </dl>

  <p data-counters class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
    <span>
      <span class="font-display font-semibold tabular"><%= @enrolled.size %> / <%= event.maximum_participants.infinite? ? "∞" : event.maximum_participants %></span>
      <span class="text-muted"><%= t("play.events.enrolled_count") %></span>
    </span>
    <% if event.waitlist_enabled || @waitlist.any? %>
      <span>
        <span class="font-display font-semibold tabular"><%= @waitlist.size %></span>
        <span class="text-muted"><%= t("play.events.waitlist_count") %></span>
      </span>
    <% end %>
  </p>

  <div class="flex flex-col gap-2">
    <%= render "play/events/actions", event: event, participant: current_participant %>
    <% if @staff_role %>
      <%= link_to t("play.events.manage"), organizer_tournament_path(event, locale: params[:locale]), class: button_classes(:ghost, "w-full") %>
    <% end %>
  </div>
</section>

<% [[:description, event.description], [:schedule, event.schedule], [:rules, event.rules]].each do |key, text| %>
  <% next if text.blank? %>
  <section class="mt-6">
    <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-muted"><%= t("play.events.#{key}") %></h2>
    <div class="markdown mt-2 text-sm leading-relaxed"><%= marksmithed(text) %></div>
  </section>
<% end %>

<%= render "play/events/enrolled", event: event, enrolled: @enrolled, waitlist: @waitlist %>
