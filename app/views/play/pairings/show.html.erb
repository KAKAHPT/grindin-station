<%# The bracket of a top-cut round takes the full width (a Top 40 row is nine cards). %>
<% content_for :wide_main, @stages ? "full" : "1" %>
<%= render "play/shared/header", section: :pairings %>
<%# Live: any change to the event's pods morph-refreshes this page, on whichever round it shows.
    A top-cut round shows the whole cut as a bracket (play/pairings/bracket) instead of the grid. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from LiveBroadcasts.pairings_stream(current_event.id) %>
<% url_locale = params[:locale] %>

<% if @round %>
  <div data-controller="pod-filter" data-pod-filter-cards-value="[data-pairing-table]">
    <div class="mb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2 min-w-0">
        <% if @rounds.size > 1 %>
          <nav data-round-selector aria-label="<%= t("play.pairings.rounds") %>" class="seg max-w-full overflow-x-auto">
            <% @rounds.each do |round| %>
              <% active = round == @round %>
              <%= link_to round.number, play_pairings_path(current_event.slug, round: round.number, locale: url_locale),
                          "aria-current": ("page" if active), "aria-label": t("play.tables.round", number: round.number),
                          class: ["tabular", ("seg-on" if active)] %>
            <% end %>
          </nav>
        <% end %>
        <p data-round-number="<%= @round.number %>" class="text-[10.5px] font-semibold uppercase tracking-[0.08em] text-muted">
          <%= @round.is_a?(SingleEliminationRound) ? @round.display_name : t("play.tables.round", number: @round.number) %>
          <% if @round.started? && @round.finished_at.nil? %>
            ·
            <span data-time-left>
              <%= t("play.pairings.time_left_html", time: tag.span(clock_text(@round.started_at, @round.duration&.to_i), class: "tabular",
                      data: { controller: "round-timer", round_timer_round_time_value: @round.duration.to_i,
                              round_timer_started_at_value: @round.started_at.iso8601 })) %>
            </span>
          <% end %>
        </p>
      </div>
      <label class="relative block w-full sm:w-72">
        <span class="sr-only"><%= t("play.pairings.search") %></span>
        <svg aria-hidden="true" class="pointer-events-none absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/></svg>
        <input type="search" id="pairings-search" autocomplete="off" data-pairings-search data-turbo-permanent placeholder="<%= t("play.pairings.search") %>"
               data-pod-filter-target="input" data-action="input->pod-filter#filter" class="field-input ps-8">
      </label>
    </div>

    <% if @stages %>
      <%= render "play/pairings/bracket", stages: @stages, round: @round, my_pod: @my_pod %>
    <% else %>
      <div data-pairings class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 content-start">
        <%= render partial: "play/pairings/table", collection: @pods, as: :pod,
                   locals: { event: current_event, me: current_participant, my_pod: @my_pod } %>
      </div>
    <% end %>
  </div>

  <% if @byes.any? && !@stages %>
    <section data-byes class="card mt-4 overflow-clip">
      <h3 class="band px-4 py-2.5 font-display text-[15px] font-semibold text-ink"><%= t("play.pairings.byes") %></h3>
      <ul class="flex flex-col divide-y divide-line/60">
        <% @byes.each do |bye| %>
          <li data-participant-id="<%= bye.event_participant_id %>" class="px-4 py-2 text-[13px] min-w-0 truncate">
            <%= t("play.pairings.bye", name: bye.event_participant.name) %>
            <% if current_participant && bye.event_participant_id == current_participant.id %>
              <span data-me class="ms-1.5"><%= desk_chip(:ok) { t("play.tables.you") } %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% else %>
  <%= render "play/tables/waiting" %>
<% end %>
