<%# Role-free public card of one table: number, status, seats in order, the winner. No staff links or buttons. %>
<%# 1v1: two names, no seat squares, the winner's score. %>
<% one_v_one = event.one_v_one? %>
<% results = pod.current_results.index_by(&:event_participant_id) %>
<% status = pod.report_status %>
<% drawn = status == :completed && results.values.all? { |result| result.is_a?(Draw) } %>
<%= tag.article id: dom_id(pod), data: { pod_number: pod.number },
                class: "flex flex-col bg-surface border border-line rounded-xl shadow-card overflow-clip" do %>
  <div class="flex items-center justify-between gap-2 px-4 pt-3 pb-2">
    <h3 class="font-display text-lg font-semibold leading-none tracking-tight text-ink">
      <%= t("play.tables.table") %> <%= pod.number %>
    </h3>
    <div class="flex flex-wrap items-center justify-end gap-x-3 gap-y-0.5">
      <% if drawn %>
        <%= status_chip(:muted, data: { draw: true }) { t("play.draw") } %>
      <% end %>
      <%= status_chip(pod_status_tone(status), data: { pod_status: true }) { t("rounds.status.#{status}") } %>
    </div>
  </div>
  <ol class="flex flex-col divide-y divide-line/60 border-t border-line">
    <% pod.seatings.each do |seating| %>
      <% seated = seating.event_participant %>
      <% won = results[seated.id].class.in?([Win, Advance]) %>
      <%= tag.li data: { seat: (seating.order unless one_v_one), participant_id: seated.id, winner: (true if won) },
                 class: ["flex items-center gap-2.5 px-4 py-1.5 min-h-9", ("bg-accent/[0.08]" if won)] do %>
        <% unless one_v_one %>
          <span class="<%= PaletteHelper::SEAT_SQUARE_SM %> <%= won ? "text-accent" : "text-muted" %>"><%= seating.order %></span>
        <% end %>
        <span class="flex-1 min-w-0 text-[13px]">
          <span data-name class="block truncate <%= "font-semibold text-ink" if won %>"><%= profile_link(seated.player&.user, seated.name) %></span>
          <% if event.show_commanders_in_standings && commander_text(seated) %>
            <span class="block truncate text-xs text-muted"><%= commander_text(seated) %></span>
          <% end %>
        </span>
        <% if won && one_v_one && status == :completed && (score = results[seated.id].score) %>
          <span data-score class="font-display text-[12px] font-semibold text-accent"><%= score %></span>
        <% end %>
        <% if won %>
          <%= icon("medal", class: "text-[14px] text-accent") %><span class="sr-only"><%= t("play.pairings.winner") %></span>
        <% end %>
      <% end %>
    <% end %>
  </ol>
<% end %>
