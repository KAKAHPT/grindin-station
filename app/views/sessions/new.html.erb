<% content_for :title, t("auth.sign_in") %>

<%= modal_form_for :session, url: session_url, html: { id: "login-form", data: { turbo: false } } do |f| %>
  <%= f.email_field_with_label :email_address, required: true, autofocus: true, autocomplete: "username",
                               placeholder: t("auth.placeholders.email"), value: params[:email_address],
                               label: { text: User.human_attribute_name(:email_address) } %>
  <%= f.password_field_with_label :password, required: true, autocomplete: "current-password",
                                  placeholder: t("auth.placeholders.password"), maxlength: 72,
                                  label: { text: User.human_attribute_name(:password) } %>
  <%= f.submit t("auth.sign_in"), class: button_classes(:primary, "w-full mt-1") %>
<% end %>

<%= render "auth/oauth" %>

<div class="auth-foot" data-sign-up-copy>
  <%= t("auth.new_here") %> <%= link_to t("auth.create_account"), new_registration_path, data: modal_nav_data %>
  <div class="mt-1 text-[11.5px]"><%= t("auth.no_oauth_needed") %></div>
</div>
<div class="mt-2 flex items-center justify-center gap-4 text-xs text-muted">
  <%= link_to t("auth.forgot_password"), new_password_path, data: modal_nav_data, class: "hover:text-ink" %>
  ·
  <%= link_to t("auth.resend_confirmation"), new_confirmation_path, data: modal_nav_data, class: "hover:text-ink" %>
  <% if turbo_frame_request_id == "modal" %>
    <%= link_to t("auth.cancel"), root_path, data: modal_nav_data, class: "hover:text-ink" %>
  <% end %>
</div>
