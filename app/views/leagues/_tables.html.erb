<%# The Tables tab of an open-tables league: the viewer's own table, opening one, the tables waiting for players
    and the ones being played. Locals: league. Uses @participant, @my_table, @waiting, @in_play. %>
<%= turbo_stream_from league, :tables %>
<div class="col-span-full grid gap-4 pt-4" data-league-tables>
  <% if @my_table %>
    <%= render "leagues/my_table", league: league, table: @my_table, participant: @participant %>
  <% elsif !league.tables_open? %>
    <p class="card px-4 py-4 text-[13px] text-muted" data-tables-closed><%= t("leagues.tables.closed_#{league.play? ? "date" : "state"}") %></p>
  <% elsif @participant&.enrolled? %>
    <div class="card flex flex-wrap items-center justify-between gap-3 px-4 py-4" data-open-table>
      <p class="text-[13px] text-muted"><%= t("leagues.tables.open_lead") %></p>
      <%= button_to t("leagues.tables.open"), league_tables_path(league, locale: params[:locale]), class: button_classes(:primary) %>
    </div>
  <% else %>
    <p class="card px-4 py-4 text-[13px] text-muted" data-tables-visitor><%= t("leagues.tables.enrol_first") %></p>
  <% end %>

  <section class="card overflow-clip" data-waiting-tables>
    <h2 class="card-title"><%= t("leagues.tables.waiting_title") %></h2>
    <% if @waiting.any? %>
      <ul class="divide-y divide-line">
        <% @waiting.each do |table| %>
          <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3" data-waiting-table="<%= table.id %>">
            <div class="min-w-0 text-[13px]">
              <p class="text-ink"><%= safe_join(table.participants.map { |participant| league_player(participant) }, ", ") %></p>
              <p class="mt-0.5 text-[12px] text-muted">
                <%= t("leagues.tables.seats_left", count: League::TABLE_SIZE - table.participants.size) %> ·
                <%= t("leagues.tables.closes_at", time: l(table.expires_at, format: :short)) %>
              </p>
            </div>
            <% if @participant&.enrolled? && @my_table.nil? && league.tables_open? %>
              <%= button_to t("leagues.tables.join"), join_league_table_path(league, table, locale: params[:locale]), class: button_classes(:primary, size: :sm) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-4 py-6 text-center text-[12.5px] text-muted"><%= t("leagues.tables.none_waiting") %></p>
    <% end %>
  </section>

  <% if @in_play.any? %>
    <section class="card overflow-clip" data-tables-in-play>
      <h2 class="card-title"><%= t("leagues.tables.in_play_title") %></h2>
      <ul class="divide-y divide-line text-[13px]">
        <% @in_play.each do |table| %>
          <li class="px-4 py-3 text-ink"><%= safe_join(table.pod.seatings.map { |seating| league_player(seating.event_participant) }, ", ") %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
