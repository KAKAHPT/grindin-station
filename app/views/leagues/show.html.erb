<%# Public league page: the event header card, About (when, where, price, players, description, schedule, prizes,
    rules), the wager, the rounds and the standings by league score. %>
<% league = @league %>
<% playing = league.event_participants.reject(&:dropped) %>
<% content_for :event_header do %>
  <%= render "shared/event_header", event: league,
                                    eyebrow: [t("lists.league.eyebrow"), event_state_label(league, nil)].join(" · "),
                                    line: play_info_line(league, playing.size) %>
<% end %>

<div class="col-span-full grid grid-cols-1 gap-4 lg:grid-cols-[1.4fr_1fr] items-start pt-4">
  <section data-about class="card">
    <h2 class="card-title"><%= t("play.events.about") %></h2>
    <div class="p-4">
      <dl class="grid grid-cols-[4.5rem_1fr] gap-x-3 gap-y-1.5 text-[13px]">
        <dt class="text-muted"><%= t("play.events.when") %></dt>
        <dd>
          <%= time_tag league.start_time, l(league.start_time, format: t("play.events.time_format")) %>
          <% if league.end_time %>
            – <%= time_tag league.end_time, l(league.end_time, format: t("play.events.time_format")) %>
          <% end %>
        </dd>
        <% if league.address.present? %>
          <dt class="text-muted"><%= t("play.events.where") %></dt>
          <dd>
            <%= league.address %> ·
            <%= link_to t("play.events.open_map"), "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(league.address)}",
                        target: "_blank", rel: "noopener", class: "text-accent hover:underline" %>
          </dd>
        <% end %>
        <dt class="text-muted"><%= t("play.events.price") %></dt>
        <dd><%= tournament_price(league) %></dd>
        <dt class="text-muted"><%= t("lists.league.players") %></dt>
        <dd>
          <%= t("lists.league.players_line", registered: league.event_participants_count, min: league.minimum_participants,
                                             max: league.maximum_participants.infinite? ? t("lists.league.no_limit") : league.maximum_participants) %>
        </dd>
      </dl>

      <% [[t("lists.league.description"), league.description], [t("play.events.schedule"), league.schedule],
          [t("lists.league.prizes"), league.prizes], [t("play.events.rules"), league.rules]].each do |label, text| %>
        <% next if text.blank? %>
        <section class="mt-4">
          <h3 class="text-[10.5px] font-semibold uppercase tracking-[0.08em] text-muted"><%= label %></h3>
          <div class="markdown mt-1 text-[13px] leading-relaxed text-muted"><%= marksmithed(text) %></div>
        </section>
      <% end %>
    </div>
  </section>

  <div class="grid gap-4">
    <% if league.wager_percentage.present? %>
      <section class="card" data-league-wager>
        <h2 class="card-title"><%= t("lists.league.wager") %></h2>
        <div class="p-4">
          <p class="font-display text-2xl font-semibold text-ink"><%= league.wager_percentage %>%</p>
          <p class="mt-1 text-[12.5px] text-muted"><%= t("lists.league.wager_line", percent: league.wager_percentage) %></p>
        </div>
      </section>
    <% end %>

    <% if league.rounds.any? %>
      <section class="card overflow-clip" data-league-rounds>
        <h2 class="card-title"><%= t("lists.league.rounds") %></h2>
        <ul class="divide-y divide-line text-[13px]">
          <% league.rounds.sort_by(&:number).each do |round| %>
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span><%= t("lists.league.round", number: round.number) %></span>
              <% if round.finished_at %>
                <%= desk_chip(:info) { t("play.events.state.finished") } %>
              <% elsif round.started? %>
                <%= desk_chip(:ok) { t("play.header.live") } %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>

<% if league.finished? || league.playing? %>
  <section class="col-span-full card overflow-clip" data-league-standings>
    <h2 class="card-title"><%= t("lists.league.standings") %></h2>
    <% standings = playing.sort_by { |ep| -(ep.league_score || 0) } %>
    <% if standings.any? %>
      <div class="overflow-x-auto">
        <table class="ctable">
          <thead>
            <tr>
              <th class="r w-12"><%= t("lists.columns.rank") %></th>
              <th><%= t("lists.columns.player") %></th>
              <th class="r"><%= t("lists.columns.score") %></th>
              <th class="r"><%= t("lists.columns.wins") %></th>
              <th class="r"><%= t("lists.columns.draws") %></th>
              <th class="r"><%= t("lists.columns.losses") %></th>
              <% if league.finished? %><th class="r"><%= t("lists.columns.position") %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% standings.each.with_index(1) do |ep, rank| %>
              <tr>
                <td class="r font-display font-semibold text-muted"><%= rank %></td>
                <td class="text-ink"><%= ep.name %></td>
                <td class="r font-mono"><%= number_with_precision(ep.league_score, precision: 2) %></td>
                <td class="r"><%= ep.number_of_wins %></td>
                <td class="r"><%= ep.number_of_draws %></td>
                <td class="r"><%= ep.number_of_losses %></td>
                <% if league.finished? %><td class="r"><%= ep.final_position&.ordinalize %></td><% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-4 py-6 text-center text-[12.5px] text-muted"><%= t("lists.league.standings_empty") %></p>
    <% end %>
  </section>
<% end %>
