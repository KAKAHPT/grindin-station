<%# One league table as a pod card, the same look as a table on a tournament's pairings page: title band with the
    status, the players, and (waiting tables) the Join button. A waiting table lists who is in so far and grows as
    players join; it has no seat order yet, so its seats show a dot. Locals: league, table, viewer (participant or nil), joinable. %>
<% pod = table.pod %>
<% seats = pod ? pod.seatings.map { |seating| [seating.order, seating.event_participant] } : table.participants.map { |seated| [nil, seated] } %>
<% free = League::TABLE_SIZE - seats.size %>
<% mine = viewer && seats.any? { |_, seated| seated.id == viewer.id } %>
<% results = pod ? pod.current_results.index_by(&:event_participant_id) : {} %>
<% done = pod&.finished? %>
<% drawn = done && results.values.all? { |result| result.is_a?(Draw) } %>
<% correctable = done && mine && league.state.in?(Leagues::Tables::RequestCorrection::OPEN_STATES) %>
<%= tag.article data: { league_table: table.state, waiting_table: (table.id if table.waiting?), my_table: (true if mine), controller: ("dialog" if correctable) },
                class: ["card flex flex-col overflow-clip", ("border-accent/55 ring-1 ring-accent/20" if mine)] do %>
  <div class="band flex items-center justify-between gap-2 px-4 py-2.5">
    <h3 class="font-display text-[15px] font-semibold leading-none tracking-tight text-ink">
      <%= pod ? pod.round.display_name : t("leagues.tables.table_of", name: table.opener.name) %>
    </h3>
    <% if pod %>
      <span class="flex flex-wrap items-center justify-end gap-x-3 gap-y-0.5">
        <% if drawn %><%= status_chip(:muted, data: { draw: true }) { t("leagues.tables.draw") } %><% end %>
        <%= pod_status_chip(pod) %>
      </span>
    <% else %>
      <%= status_chip(:warn, data: { seats_left: free }) { t("leagues.tables.seats_left", count: free) } %>
    <% end %>
  </div>
  <ol class="flex flex-col divide-y divide-line/60">
    <% seats.each do |order, seated| %>
      <% you = viewer && seated.id == viewer.id %>
      <% won = done && results[seated.id].is_a?(Win) %>
      <%= tag.li data: { seat: order, me: (true if you), winner: (true if won) }, class: ["flex items-center gap-2.5 px-4 py-1.5 min-h-9", ("bg-accent/[0.08]" if you || won)] do %>
        <span class="<%= PaletteHelper::SEAT_SQUARE_SM %> <%= you || won ? "text-accent" : "text-muted" %>"><%= order || "·" %></span>
        <span class="flex flex-1 items-center gap-1.5 min-w-0 text-[13px]">
          <span class="truncate <%= "font-semibold text-ink" if you || won %>"><%= league_player(seated) %></span>
          <% if you %><%= desk_chip(:ok) { t("play.tables.you") } %><% end %>
        </span>
        <% if won %><%= icon("trophy", class: "text-[14px] text-muted") %><span class="sr-only"><%= t("play.pairings.winner") %></span><% end %>
      <% end %>
    <% end %>
  </ol>
  <% if correctable || (done && table.correction_state) %>
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-line px-4 py-2.5 text-[12px] text-muted" data-correction="<%= table.correction_state || "none" %>">
      <% if table.correction_state %><span><%= t("leagues.tables.correction_#{table.correction_state}") %></span><% else %><span></span><% end %>
      <% if correctable && !table.correction_pending? %>
        <button type="button" class="<%= button_classes(:ghost, size: :sm) %>" data-action="dialog#open" data-correction-open><%= t("leagues.tables.correction_ask") %></button>
      <% end %>
    </div>
    <% if correctable && !table.correction_pending? %>
      <dialog data-dialog-target="dialog" data-action="click->dialog#backdrop" class="card w-[min(28rem,92vw)] p-0 text-ink">
        <%= form_with url: correction_league_table_path(league, table, locale: params[:locale]), class: "p-4" do |form| %>
          <h3 class="font-display text-[15px] font-semibold"><%= t("leagues.tables.correction_title") %></h3>
          <p class="mt-1 text-[12.5px] text-muted"><%= t("leagues.tables.correction_lead") %></p>
          <%= form.text_area :reason, required: true, rows: 3, maxlength: 500, class: "field mt-3 w-full", "aria-label": t("leagues.tables.cancel_reason") %>
          <div class="mt-3 flex justify-end gap-2">
            <button type="button" class="<%= button_classes(:ghost, size: :sm) %>" data-action="dialog#close"><%= t("leagues.tables.cancel_back") %></button>
            <%= form.submit t("leagues.tables.correction_send"), class: button_classes(:primary, size: :sm) %>
          </div>
        <% end %>
      </dialog>
    <% end %>
  <% end %>
  <% if table.waiting? %>
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-line px-4 py-2.5">
      <span class="text-[12px] text-muted"><%= t("leagues.tables.closes_at", time: l(table.expires_at, format: :short)) %></span>
      <%# Join: a signed-in, enrolled player who is free. A visitor is sent to sign in; anyone else sees why not. %>
      <% if joinable %>
        <%= button_to t("leagues.tables.join"), join_league_table_path(league, table, locale: params[:locale]), class: button_classes(:primary, size: :sm) %>
      <% elsif !authenticated? %>
        <%= link_to t("leagues.tables.join"), new_session_path(locale: params[:locale]), class: button_classes(:primary, size: :sm), data: { join_sign_in: true } %>
      <% elsif !mine %>
        <button type="button" disabled class="<%= button_classes(:secondary, "opacity-50 cursor-not-allowed", size: :sm) %>" title="<%= t("leagues.tables.join_blocked") %>" data-join-blocked><%= t("leagues.tables.join") %></button>
      <% end %>
    </div>
  <% end %>
<% end %>
