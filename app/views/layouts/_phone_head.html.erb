<%# Head shared by the phone-first layouts (play, public, timer): meta for phones and the web fonts
    loaded without blocking the first paint (display=swap in the URL, print-media swap on load). %>
<meta name="theme-color" content="#111315">
<meta name="description" content="<%= content_for?(:description) ? content_for(:description) : description %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<% fonts_url = "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@600;700&display=swap" %>
<link rel="stylesheet" href="<%= fonts_url %>" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="<%= fonts_url %>"></noscript>
