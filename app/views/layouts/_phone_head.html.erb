<%# Head shared by the phone-first layouts (play, public, timer): meta for phones, the card of a pasted link and the web fonts
    loaded without blocking the first paint (display=swap in the URL, print-media swap on load). %>
<meta name="theme-color" content="#111315">
<% description = content_for(:description) if content_for?(:description) %>
<meta name="description" content="<%= description %>">
<%# The card a pasted link turns into (chats, social networks): the landing's headline over the commanders. %>
<meta property="og:site_name" content="<%= t("app.name") %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= local_assigns[:title].presence || t("app.name") %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= request.original_url %>">
<meta property="og:image" content="<%= "#{request.base_url}/og.jpg" %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<% fonts_url = "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@600;700&display=swap" %>
<link rel="stylesheet" href="<%= fonts_url %>" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="<%= fonts_url %>"></noscript>
