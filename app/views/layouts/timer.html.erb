<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= @event.name %> · <%= t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="refresh" content="30">
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@600;700&display=swap">
    <%= javascript_importmap_tags %>
    <style>
      html, body { margin: 0; height: 100%; }
      body { background: #111315; color: #eef0f2; font-family: "Manrope", system-ui, sans-serif; display: flex; align-items: center; justify-content: center; text-align: center; }
      main { padding: 2vh 4vw; }
      .event { font-size: 3vh; opacity: .7; margin: 0; }
      .round { font-size: 6vh; margin: 1vh 0; }
      .clock { font-family: "Sora", sans-serif; font-weight: 700; font-size: 20vh; line-height: 1.1; margin: 0; font-variant-numeric: tabular-nums; }
    </style>
  </head>
  <body>
    <main><%= yield %></main>
  </body>
</html>
