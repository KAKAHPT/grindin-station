<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="dark">
  <head>
    <title><%= [content_for(:title), t("app.name")].compact_blank.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" type="image/svg+xml" href="<%= asset_path("mark.svg") %>">
    <%= render "layouts/phone_head", description: t("app.description") %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-ground text-ink font-body antialiased">
    <%= render "shared/topbar" %>

    <%# Flashes as small toasts in the top-right corner: a check for notices, a cross for alerts. %>
    <% if flash.present? %>
      <div class="pointer-events-none fixed right-4 top-16 z-40 flex flex-col items-end gap-2" data-toasts>
        <% flash.each do |key, message| %>
          <p role="alert" data-flash="<%= key %>"
             class="pointer-events-auto flex items-center gap-2 rounded-lg border px-3 py-2 text-[12.5px] shadow-card <%= key.to_s == "alert" ? "bg-ground text-danger border-danger/40" : "bg-ground text-accent border-accent/40" %>">
            <%= icon(key.to_s == "alert" ? "x-circle" : "user-check", class: "text-[14px]") %><%= message %>
          </p>
        <% end %>
      </div>
    <% end %>

    <%# A full-width page (the landing) sets content_for(:full_main) and lays out its own columns; a wider one (the
        profile) sets content_for(:wide_main). %>
    <main class="<%= content_for?(:full_main) ? "pb-12" : content_for?(:wide_main) ? "max-w-2xl mx-auto px-4 pt-4 pb-12" : "max-w-md mx-auto px-4 pt-4 pb-12" %>">
      <%= yield %>
    </main>

    <footer class="<%= content_for?(:full_main) ? "max-w-5xl" : content_for?(:wide_main) ? "max-w-2xl" : "max-w-md" %> mx-auto px-4 py-6 border-t border-line text-sm text-muted">
      <%= yield :footer_note %>
      <% if authenticated? %>
        <%= link_to t("accounts.nav"), account_path(locale: params[:locale]), class: "hover:text-ink" %>
      <% else %>
        <%= link_to t("profiles.sign_in"), new_session_path(locale: params[:locale]), class: "hover:text-ink" %>
      <% end %>
    </footer>
  </body>
</html>
