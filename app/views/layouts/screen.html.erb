<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="dark">
  <head>
    <title><%= @event.name %> · <%= t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" type="image/svg+xml" href="<%= asset_path("mark.svg") %>">
    <%= render "layouts/phone_head", description: t("play.description", event: @event.name) %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-screen overflow-hidden bg-ground text-ink font-body antialiased">
    <%= yield %>
  </body>
</html>
