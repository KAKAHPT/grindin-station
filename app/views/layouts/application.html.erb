<!DOCTYPE html>

<html lang="<%= I18n.locale %>" class="dark">
  <head>
    <title><%= t("app.name") %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" type="image/svg+xml" href="<%= asset_path("mark.svg") %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@300;600;700;800&display=swap">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "organizer" %>
    <%= yield :head %>
  </head>
  <%# The grey card mosaic, still and very faint, behind the page (.mosaic-bg). %>
  <%= tag.body class: "mosaic-bg bg-ground text-ink font-body antialiased", style: mosaic_style do %>
    <%= render "shared/topbar", modal_sign_in: true %>
    <% if flash.present? %>
      <% flash.keys.each do |key| %>
        <%= render partial: key, object: flash[key] %>
      <% end %>
    <% end %>
    <% if content_for?(:event_header) %>
      <div class="max-w-screen-2xl mx-auto px-4 pt-6"><%= yield :event_header %></div>
    <% end %>
    <div class="flex <%= content_for?(:event_header) ? "pt-0" : "pt-4" %> overflow-hidden">
      <div
        class="
          relative w-full max-w-screen-2xl mx-auto h-full overflow-y-auto
        "
      >
        <main>
          <div
            class="
              grid grid-cols-1 gap-4 px-4 mb-4 md:grid-cols-2 lg:grid-cols-3
              xl:grid-cols-4
            "
          >
            <% if content_for?(:sub_navigation) %>
              <div class="my-4 col-span-full xl:my-2">
                <%= yield :sub_navigation %>
              </div>
            <% end %>

            <%= content_for?(:page_content) ? yield(:page_content) : yield %>
          </div>

          <%= turbo_frame_tag "modal", data: ({ turbo_permanent: true } if content_for?(:permanent_modal)) %>
        </main>
        <footer
          class="
            md:flex md:items-center md:justify-between px-4 2xl:px-0 py-6
            md:py-10
          "
        >
          <div class="container mx-auto text-center text-muted text-xs">
            <%= link_to t("privacy.link"), privacy_path(locale: params[:locale]), class: "underline", data: { privacy_link: true } %>
          </div>
        </footer>
      </div>
    </div>
  <% end %>
</html>
