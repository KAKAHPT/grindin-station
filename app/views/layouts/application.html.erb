<!DOCTYPE html>

<html lang="<%= I18n.locale %>" class="dark">
  <head>
    <title><%= t("app.name") %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@600;700&display=swap">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css", integrity: "sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=", crossorigin: "anonymous", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/light/style.css", integrity: "sha256-8uWWmfqu7ifantuG3Rj17TvVET2z5OOI/dI6/K8wiGU=", crossorigin: "anonymous", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-ground text-ink font-body antialiased">
    <header class="fixed z-30 w-full bg-surface/90 backdrop-blur border-b border-line shadow-card">
      <nav class="py-3 px-4">
        <div class="flex justify-between items-center max-w-screen-2xl mx-auto">
          <div class="flex justify-start items-center">
            <button
              id="toggleSidebarMobile"
              aria-expanded="true"
              aria-controls="sidebar"
              class="
                p-2 text-muted rounded cursor-pointer lg:hidden
                hover:text-ink hover:bg-line focus:ring-2 focus:ring-line
              "
            >
              <svg
                id="toggleSidebarMobileHamburger"
                class="w-6 h-6"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              <svg
                id="toggleSidebarMobileClose"
                class="hidden w-6 h-6"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </button>
            <%= link_to root_url, class: "flex ml-2 md:mr-24" do %>
              <%= icon("knife", class: "text-2xl mr-3 text-accent self-center") %>
              <strong
                class="
                  self-center font-display text-xl font-semibold sm:text-2xl
                  whitespace-nowrap text-ink
                "
              >
                <%= t("app.name") %>
              </strong>
            <% end %>
          </div>
          <div class="flex justify-between items-center lg:order-2">
            <% if current_user&.staff? %>
              <%= link_to organizer_path_builder, class: "me-2 text-muted hover:text-ink hover:bg-line focus:outline-none focus:ring-2 focus:ring-line rounded-lg text-sm p-2.5 flex items-center" do %>
                <%= label_tag "to_mode", class: "inline-flex items-center cursor-pointer" do %>
                  <%= check_box_tag "to_mode", "", organizer_mode?, class: "sr-only peer" %>
                  <div
                    class="
                      relative w-11 h-6 bg-line peer-focus:outline-none
                      peer-focus:ring-2 peer-focus:ring-accent/40 rounded-full peer
                      peer-checked:after:translate-x-full
                      rtl:peer-checked:after:-translate-x-full
                      peer-checked:after:border-ground after:content-['']
                      after:absolute after:top-[2px] after:start-[2px]
                      after:bg-ink after:border-line after:border
                      after:rounded-full after:h-5 after:w-5
                      after:transition-all peer-checked:bg-accent
                    "
                  ></div>
                  <span class="ms-3 text-sm font-medium text-ink">Organizer mode</span>
                <% end %>
              <% end %>
            <% end %>

            <% if authenticated? %>
              <%= link_to 'Logout', session_path(Current.session), data: { "turbo-method": :delete }, class: "text-muted hover:text-ink hover:bg-line focus:outline-none focus:ring-2 focus:ring-line rounded-lg text-sm p-2.5" %>
            <% else %>
              <%= link_to new_session_path, data: { turbo_frame: "modal" }, class: "inline-flex justify-center items-center py-3 px-5 text-base font-semibold text-center text-ground rounded-xl bg-accent hover:bg-accent/90 focus:ring-2 focus:ring-accent/40" do %>
                Log in
                <%= icon("arrow-right", class:"ml-2") %>
              <% end %>
            <% end %>
          </div>
        </div>
      </nav>
    </header>
    <% if flash.present? %>
      <% flash.keys.each do |key| %>
        <%= render partial: key, object: flash[key] %>
      <% end %>
    <% end %>
    <div class="flex pt-20 overflow-hidden bg-ground">
      <div
        class="
          relative w-full max-w-screen-2xl mx-auto h-full overflow-y-auto
          bg-ground
        "
      >
        <main>
          <div
            class="
              grid grid-cols-1 gap-4 px-4 mb-4 md:grid-cols-2 lg:grid-cols-3
              xl:grid-cols-4
            "
          >
            <div class="my-4 col-span-full xl:my-2">
              <%= yield :sub_navigation %>
            </div>

            <%= yield %>
          </div>

          <%= turbo_frame_tag "modal" %>
        </main>
        <footer
          class="
            md:flex md:items-center md:justify-between px-4 2xl:px-0 py-6
            md:py-10
          "
        >
          <div class="container mx-auto text-center text-muted text-xs">
            <%= t("app.name") %> is open-source software. Contribute here:
            <%= icon("github-logo") %>
            <%= link_to 'Github', 'https://github.com/KAKAHPT/grindin-station', class: 'underline', target: '_blank' %>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
