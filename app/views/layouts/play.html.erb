<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= current_event.name %> · <%= t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-white">
    <header class="px-4 py-3 border-b border-gray-200 bg-white dark:bg-gray-800 dark:border-gray-700">
      <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("app.name") %></p>
      <h1 class="text-lg font-semibold truncate"><%= current_event.name %></h1>
    </header>

    <% flash.each do |key, message| %>
      <p role="alert" data-flash="<%= key %>"
         class="mx-4 mt-4 p-3 rounded-lg text-sm <%= key.to_s == "alert" ? "bg-red-50 text-red-800" : "bg-green-50 text-green-800" %>">
        <%= message %>
      </p>
    <% end %>

    <main class="max-w-md mx-auto px-4 pt-4 pb-24">
      <%= yield %>
    </main>

    <nav data-play-nav class="fixed bottom-0 inset-x-0 border-t border-gray-200 bg-white dark:bg-gray-800 dark:border-gray-700">
      <ul class="max-w-md mx-auto grid grid-cols-3 text-center text-sm">
        <li><%= link_to t("play.nav.my_table"), play_me_path(current_event.slug, locale: params[:locale]), class: "block py-3" %></li>
        <li><%= link_to t("play.nav.standings"), tournament_event_participants_path(current_event, locale: params[:locale]), class: "block py-3" %></li>
        <li><%= link_to t("play.nav.event"), tournament_path(current_event, locale: params[:locale]), class: "block py-3" %></li>
      </ul>
    </nav>
  </body>
</html>
