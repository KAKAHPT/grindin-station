<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="dark">
  <head>
    <title><%= current_event.name %> · <%= t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@600;700&display=swap">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-ground text-ink font-body antialiased">
    <header class="sticky top-0 z-20 px-4 py-3 border-b border-line bg-surface/90 backdrop-blur shadow-card">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-muted"><%= t("app.name") %></p>
      <h1 class="font-display text-lg font-semibold truncate"><%= current_event.name %></h1>
    </header>

    <% flash.each do |key, message| %>
      <p role="alert" data-flash="<%= key %>"
         class="mx-4 mt-4 p-3 rounded-xl border text-sm <%= key.to_s == "alert" ? "bg-danger/10 text-danger border-danger/40" : "bg-accent/10 text-accent border-accent/40" %>">
        <%= message %>
      </p>
    <% end %>

    <main class="max-w-md mx-auto px-4 pt-4 pb-24">
      <%= yield %>
    </main>

    <nav data-play-nav class="fixed bottom-0 inset-x-0 z-20 border-t border-line bg-surface/95 backdrop-blur">
      <ul class="max-w-md mx-auto grid grid-cols-3 text-center text-sm font-medium text-muted">
        <% [[t("play.nav.my_table"), play_me_path(current_event.slug, locale: params[:locale])],
              [t("play.nav.standings"), tournament_event_participants_path(current_event, locale: params[:locale])],
              [t("play.nav.event"), tournament_path(current_event, locale: params[:locale])]].each do |label, path| %>
          <% active = request.path == URI(path).path %>
          <li>
            <%= link_to label, path, "aria-current": ("page" if active),
                        class: ["relative block py-4 transition-colors",
                                active ? "text-ink before:absolute before:inset-x-8 before:top-0 before:h-0.5 before:rounded-full before:bg-accent" : "hover:text-ink"] %>
          </li>
        <% end %>
      </ul>
    </nav>
  </body>
</html>
