<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="dark">
  <head>
    <title><%= current_event.name %> · <%= t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/phone_head", description: t("play.description", event: current_event.name) %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-ground text-ink font-body antialiased">
    <header class="sticky top-0 z-20 px-4 py-3 border-b border-line bg-surface/90 backdrop-blur shadow-card">
      <div class="flex items-baseline justify-between gap-3">
        <p class="text-[11px] font-semibold uppercase tracking-wide text-muted"><%= t("app.name") %></p>
        <% if authenticated? %>
          <div class="flex items-center gap-2 min-w-0">
            <p data-play-player class="text-xs text-muted truncate"><%= profile_link(current_user) %></p>
            <%= render "notifications/bell" %>
          </div>
        <% end %>
      </div>
      <h1 class="font-display text-lg font-semibold truncate"><%= current_event.name %></h1>
    </header>

    <% flash.each do |key, message| %>
      <p role="alert" data-flash="<%= key %>"
         class="mx-4 mt-4 p-3 rounded-xl border text-sm <%= key.to_s == "alert" ? "bg-danger/10 text-danger border-danger/40" : "bg-accent/10 text-accent border-accent/40" %>">
        <%= message %>
      </p>
    <% end %>

    <%# A page with a card grid (pairings) asks for a wider column with content_for(:wide_main). %>
    <main class="<%= content_for?(:wide_main) ? "max-w-6xl" : "max-w-md" %> mx-auto px-4 pt-4 pb-24">
      <%= yield %>
    </main>

    <nav data-play-nav aria-label="<%= current_event.name %>" class="fixed bottom-0 inset-x-0 z-20 border-t border-line bg-surface/95 backdrop-blur">
      <% nav = [[t("play.nav.event"), play_event_path(current_event.slug, locale: params[:locale])]]
         nav << [t("play.nav.pairings"), play_pairings_path(current_event.slug, locale: params[:locale])]
         nav << [t("play.nav.standings"), play_standings_path(current_event.slug, locale: params[:locale])]
         nav << [t("play.nav.my_table"), play_me_path(current_event.slug, locale: params[:locale])] if current_participant&.enrolled? %>
      <ul class="max-w-md mx-auto grid <%= { 2 => "grid-cols-2", 3 => "grid-cols-3", 4 => "grid-cols-4" }.fetch(nav.size) %> text-center text-sm font-medium text-muted">
        <% nav.each do |label, path| %>
          <% active = request.path == URI(path).path %>
          <li>
            <%= link_to label, path, "aria-current": ("page" if active),
                        class: ["relative block py-4 transition-colors",
                                active ? "text-ink before:absolute before:inset-x-8 before:top-0 before:h-0.5 before:rounded-full before:bg-accent" : "hover:text-ink"] %>
          </li>
        <% end %>
      </ul>
    </nav>
  </body>
</html>
