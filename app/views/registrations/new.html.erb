<% content_for :title, t("auth.sign_up") %>

<%= modal_form_for @user, url: registrations_path, html: { id: "signup-form", data: { turbo: false } } do |f| %>
  <% if @user.errors.present? %>
    <div class="mb-4 p-3 rounded-md border border-danger/40 bg-danger/10 text-danger text-[13px]" role="alert">
      <%= safe_join(@user.errors.full_messages, tag.br) %>
    </div>
  <% end %>

  <%= f.text_field_with_label :name, required: true, autofocus: true, autocomplete: "name", placeholder: t("auth.placeholders.name") %>
  <%= f.email_field_with_label :email_address, required: true, autocomplete: "username", placeholder: t("auth.placeholders.email") %>
  <%= f.password_field_with_label :password, required: true, autocomplete: "new-password", placeholder: t("auth.placeholders.new_password"), minlength: 8, maxlength: 72 %>
  <%= f.password_field_with_label :password_confirmation, required: true, autocomplete: "new-password", placeholder: t("auth.placeholders.repeat_password"), minlength: 8, maxlength: 72 %>
  <%= f.submit t("auth.sign_up"), class: button_classes(:primary, "w-full") %>
<% end %>

<%= render "auth/oauth" %>

<div class="auth-foot" data-sign-up-copy>
  <%= t("auth.no_oauth_needed") %>
  <div class="mt-1"><%= t("auth.have_account") %> <%= link_to t("auth.sign_in"), new_session_path, data: modal_nav_data %></div>
</div>
<% if turbo_frame_request_id == "modal" %>
  <div class="mt-2 text-center text-xs text-muted"><%= link_to t("auth.cancel"), root_path, data: modal_nav_data, class: "hover:text-ink" %></div>
<% end %>
