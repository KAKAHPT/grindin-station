<%# Rankings: every circuit as a card (name with the grey trophy, organizer, number of open events). %>
<% url_locale = params[:locale] %>
<div class="col-span-full pt-2">
  <h1 class="font-display text-2xl font-semibold text-ink"><%= t("lists.circuits.title") %></h1>
  <p class="mt-1 text-[13px] text-muted"><%= t("lists.circuits.lead") %></p>
</div>

<% if @circuits.any? %>
  <div class="col-span-full grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
    <% @circuits.each do |circuit| %>
      <% leagues_count = @league_counts.fetch(circuit.id, 0) %>
      <% events_count = @tournament_counts.fetch(circuit.id, 0) + leagues_count %>
      <%= link_to circuit_path(circuit, locale: url_locale), class: "card block overflow-clip hover:border-line-strong", data: { circuit: circuit.id } do %>
        <h2 class="card-title flex items-center justify-between gap-3">
          <span class="truncate"><%= circuit.name %></span>
          <%= icon("trophy", class: "text-muted") %>
        </h2>
        <div class="px-4 py-3 text-[12.5px] text-muted">
          <% if circuit.event_organizer %>
            <p><%= t("lists.organized_by_html", name: circuit.event_organizer.name) %></p>
          <% end %>
          <p class="mt-0.5" data-circuit-events>
            <%= t("lists.events_count", count: events_count) %><% if leagues_count.positive? %> · <%= t("lists.leagues_count", count: leagues_count) %><% end %>
          </p>
        </div>
      <% end %>
    <% end %>
  </div>
  <div class="col-span-full"><%= paginate @circuits %></div>
<% else %>
  <p class="col-span-full card px-4 py-8 text-center text-[13px] text-muted"><%= t("lists.circuits.empty") %></p>
<% end %>
