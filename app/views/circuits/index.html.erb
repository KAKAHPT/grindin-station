<%# Circuits: every circuit as a card (banner behind when the organizer set one, name with the grey trophy, organizer, number of open events). %>
<% url_locale = params[:locale] %>
<div class="col-span-full pt-2">
  <h1 class="font-display text-2xl font-semibold text-ink"><%= t("lists.circuits.title") %></h1>
  <p class="mt-1 text-[13px] text-muted"><%= t("lists.circuits.lead") %></p>
</div>

<% base = { locale: url_locale, sort: params[:sort].to_s.presence_in(CircuitsController::SORTS) }.compact %>
<div class="col-span-full">
  <%= render "shared/filter_bar", url: circuits_path, hidden: base, count: t("lists.circuits_count", count: @circuits.total_count),
                                  fields: event_filter_fields(@filters, @filter_options, search: t("circuits.filters.search"),
                                                              sort: [CircuitsController::SORTS, "circuits"]) %>
  <%= render "shared/filter_chips", chips: event_filter_chips(@filters, base, path: method(:circuits_path)),
                                    clear_url: circuits_path(**base) %>
</div>

<% if @circuits.any? %>
  <div class="col-span-full grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
    <% @circuits.each do |circuit| %>
      <% leagues_count = @league_counts.fetch(circuit.id, 0) %>
      <%= render "circuits/card", circuit: circuit, leagues_count: leagues_count, events_count: @tournament_counts.fetch(circuit.id, 0) + leagues_count %>
    <% end %>
  </div>
  <div class="col-span-full"><%= paginate @circuits %></div>
<% else %>
  <p class="col-span-full card px-4 py-8 text-center text-[13px] text-muted" data-list-empty><%= @filters.any? ? t("events.filters.empty") : t("lists.circuits.empty") %></p>
<% end %>
