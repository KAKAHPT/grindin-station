<%# The social feed: the card-art mosaic of the landing on both sides, a wide central column with the composer
    (about an event, or a thought) and the posts, newest first. %>
<% content_for :title, t("feed.title") %>
<% content_for :full_main, "1" %>
<% url_locale = params[:locale] %>
<% arts = (1..48).map { |n| image_path("landing/c#{n}.jpg") } %>
<% mentioned = User.where(handle: @posts.flat_map(&:mentioned_handles).uniq).index_by(&:handle) %>
<div class="feed-page">
  <div class="lp-mosaic" aria-hidden="true">
    <% 2.times do %>
      <div class="lp-sheet">
        <% arts.each do |src| %>
          <img src="<%= src %>" alt="" width="240" height="175" loading="lazy" decoding="async">
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="feed-vig" aria-hidden="true"></div>

  <div class="feed-col" data-feed>
    <div class="flex flex-wrap items-end justify-between gap-3 px-1" data-list-header>
      <div class="min-w-0">
        <h1 class="font-display text-2xl font-semibold text-ink"><%= t("feed.title") %></h1>
        <p class="mt-1 text-[13px] text-muted"><%= t("feed.lead") %></p>
      </div>
    </div>

    <% if @circuit %>
      <p class="rounded-lg border border-line bg-surface/80 px-4 py-2.5 text-[13px] text-muted" data-feed-circuit>
        <%= t("feed.circuit_filter_html", name: link_to(@circuit.name, circuit_path(@circuit, locale: url_locale), class: "text-ink underline")) %>
        <%= link_to t("feed.all_posts"), feed_path(locale: url_locale), class: "ms-2 text-ink underline" %>
      </p>
    <% end %>

    <% if authenticated? %>
      <div class="grid gap-2 sm:grid-cols-2" data-feed-composers>
        <% if @postable.any? %>
          <%= tag.details class: "feed-composer group", data: { feed_composer: "event" } do %>
            <summary class="feed-composer-sum"><%= icon("trophy", class: "me-2 text-muted") %><%= t("feed.write") %><span class="ms-auto text-muted group-open:hidden"><%= icon("plus") %></span></summary>
            <%= form_with model: @post, url: feed_posts_path(locale: url_locale), class: "border-t border-line p-4 space-y-3", data: { turbo: false } do |f| %>
              <div class="field">
                <%= f.label :event_id, t("feed.about_event") %>
                <%= f.select :event_id, @postable.map { |event| ["#{event.name} · #{l(event.start_time, format: '%d %b %Y')}", event.id] }, {}, class: "field-input" %>
              </div>
              <div class="field">
                <%= f.label :body, t("feed.your_report") %>
                <%= f.text_area :body, rows: 3, maxlength: Post::BODY_MAX, placeholder: t("feed.placeholder"), required: true, class: "field-input" %>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-[11.5px] text-muted" data-feed-rules><%= t("feed.rules_html") %></p>
                <%= f.button t("feed.post"), type: "submit", class: button_classes(:primary, size: :xs) %>
              </div>
            <% end %>
          <% end %>
        <% end %>
        <%= tag.details class: "feed-composer group", data: { feed_composer: "thought" } do %>
          <summary class="feed-composer-sum"><%= icon("pencil", class: "me-2 text-muted") %><%= t("feed.write_thought") %><span class="ms-auto text-muted group-open:hidden"><%= icon("plus") %></span></summary>
          <%= form_with model: @post, url: feed_posts_path(locale: url_locale), class: "border-t border-line p-4 space-y-3", data: { turbo: false } do |f| %>
            <%= f.hidden_field :kind, value: "thought" %>
            <div class="field">
              <%= f.label :body, t("feed.your_thought") %>
              <%= f.text_area :body, rows: 3, maxlength: Post::BODY_MAX, placeholder: t("feed.thought_placeholder"), required: true, class: "field-input" %>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-[11.5px] text-muted" data-feed-rules><%= t("feed.rules_html") %></p>
              <%= f.button t("feed.post"), type: "submit", class: button_classes(:primary, size: :xs) %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="rounded-lg border border-line bg-surface/80 px-4 py-3 text-[13px] text-muted" data-feed-signin><%= t("feed.sign_in_html", link: link_to(t("topbar.sign_in"), new_session_path(locale: url_locale), class: "text-ink underline")) %></p>
    <% end %>

    <div class="feed-list divide-y divide-line" data-feed-list>
      <% @posts.each do |post| %>
        <%= render "posts/post", post: post, liked: @liked_ids.include?(post.id), reported: @reported_ids.include?(post.id), url_locale: url_locale, flat: true, mentioned: mentioned %>
      <% end %>
      <% if @posts.empty? %>
        <p class="px-4 py-8 text-center text-[13px] text-muted" data-feed-empty><%= t("feed.empty") %></p>
      <% end %>
    </div>
    <div><%= paginate @posts %></div>
    <details class="rounded-lg border border-line bg-surface/80 px-4 py-3 text-[12.5px] text-muted" data-feed-policy>
      <summary class="cursor-pointer font-semibold text-ink"><%= t("feed.policy.title") %></summary>
      <ul class="mt-2 list-disc space-y-1 ps-5">
        <% t("feed.policy.rules").each do |rule| %><li><%= rule %></li><% end %>
      </ul>
    </details>
  </div>
</div>
