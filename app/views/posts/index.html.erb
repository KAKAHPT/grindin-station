<%# The social feed: the cEDH PT stream's grey card mosaic behind (tilted, like the kit's pod scenes), a wide central
    column with the composer (about an event, or a thought) and the posts, newest first. %>
<% content_for :title, t("feed.title") %>
<% content_for :full_main, "1" %>
<% url_locale = params[:locale] %>
<% mentioned = @paused ? {} : User.where(handle: @posts.flat_map(&:mentioned_handles).uniq).index_by(&:handle) %>
<div class="feed-page">
  <div class="feed-mosaic" style="background-image: url('<%= image_path("feed-mosaic.jpg") %>')" aria-hidden="true"></div>
  <div class="feed-vig" aria-hidden="true"></div>

  <div class="feed-col" data-feed>
    <%# Fixed banner: the Jeweled Lotus art (Alayna Danner, Scryfall art crop) behind a dark shade, the title over it. %>
    <section class="feed-hero" data-feed-hero>
      <div class="feed-hero-art" aria-hidden="true">
        <img src="<%= image_path("feed-hero.jpg") %>" alt="" width="626" height="457" decoding="async">
      </div>
      <div class="feed-hero-shade" aria-hidden="true"></div>
      <div class="feed-hero-in" data-list-header>
        <div class="min-w-0">
          <h1 class="font-display text-3xl font-semibold text-ink"><%= t("feed.title") %></h1>
          <p class="mt-1 text-[13px] text-ink/80"><%= t("feed.lead") %></p>
        </div>
      <% if authenticated? %>
        <span class="seg" data-feed-scope>
          <% User::FEED_SCOPES.each do |scope| %>
            <%= link_to t("feed.scopes.#{scope}"), feed_path(scope: scope, circuit: @feed.circuit&.id, locale: url_locale), class: ("seg-on" if scope == @feed.scope), "aria-current": ("page" if scope == @feed.scope) %>
          <% end %>
        </span>
      <% end %>
      </div>
    </section>

    <% if @paused %>
      <div class="feed-list px-5 py-10 text-center" data-feed-paused>
        <p class="font-display text-lg font-semibold text-ink"><%= t("feed.paused_title") %></p>
        <p class="mt-2 text-[13px] text-muted"><%= t("feed.paused_text") %></p>
      </div>
    <% else %>
    <% if @feed.circuit %>
      <p class="rounded-lg border border-line bg-surface/80 px-4 py-2.5 text-[13px] text-muted" data-feed-circuit>
        <%= t("feed.circuit_filter_html", name: link_to(@feed.circuit.name, circuit_path(@feed.circuit, locale: url_locale), class: "text-ink underline")) %>
        <%= link_to t("feed.all_posts"), feed_path(locale: url_locale), class: "ms-2 text-ink underline" %>
      </p>
    <% end %>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-start" data-feed-tools>
      <div class="min-w-0 flex-1">
        <% if authenticated? %>
          <div class="flex flex-col gap-2" data-feed-composers>
            <% if @postable.any? %>
              <%= tag.details class: "feed-composer group", data: { feed_composer: "event" } do %>
                <summary class="feed-composer-sum"><%= icon("trophy", class: "me-2 text-muted") %><%= t("feed.write") %><span class="ms-auto text-muted group-open:hidden"><%= icon("plus") %></span></summary>
                <%= form_with model: @post, url: feed_posts_path(locale: url_locale), class: "border-t border-line p-4 space-y-3", data: { turbo: false } do |f| %>
                  <div class="field">
                    <%= f.label :event_id, t("feed.about_event") %>
                    <%= f.select :event_id, @postable.map { |event| ["#{event.name} · #{l(event.start_time, format: '%d %b %Y')}", event.id] }, {}, class: "field-input" %>
                  </div>
                  <div class="field">
                    <%= f.label :body, t("feed.your_report") %>
                    <%= f.text_area :body, rows: 3, maxlength: Post::BODY_MAX, placeholder: t("feed.placeholder"), required: true, class: "field-input" %>
                  </div>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-[11.5px] text-muted" data-feed-rules><%= t("feed.rules_html") %></p>
                    <%= f.button t("feed.post"), type: "submit", class: button_classes(:primary, size: :xs) %>
                  </div>
                <% end %>
              <% end %>
            <% end %>
            <%= tag.details class: "feed-composer group", data: { feed_composer: "thought" } do %>
              <summary class="feed-composer-sum"><%= icon("pencil", class: "me-2 text-muted") %><%= t("feed.write_thought") %><span class="ms-auto text-muted group-open:hidden"><%= icon("plus") %></span></summary>
              <%= form_with model: @post, url: feed_posts_path(locale: url_locale), class: "border-t border-line p-4 space-y-3", data: { turbo: false } do |f| %>
                <%= f.hidden_field :kind, value: "thought" %>
                <div class="field">
                  <%= f.label :body, t("feed.your_thought") %>
                  <%= f.text_area :body, rows: 3, maxlength: Post::BODY_MAX, placeholder: t("feed.thought_placeholder"), required: true, class: "field-input" %>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="text-[11.5px] text-muted" data-feed-rules><%= t("feed.rules_html") %></p>
                  <%= f.button t("feed.post"), type: "submit", class: button_classes(:primary, size: :xs) %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
      <p class="rounded-lg border border-line bg-surface/80 px-4 py-3 text-[13px] text-muted" data-feed-signin><%= t("feed.sign_in_html", link: link_to(t("topbar.sign_in"), new_session_path(locale: url_locale), class: "text-ink underline")) %></p>
        <% end %>
      </div>
      <%# Filters: posts about events of one play pool and/or one organizer (?event= still works from links). %>
      <%= form_with url: feed_path, method: :get, local: true, class: "shrink-0 sm:w-56", data: { turbo_frame: "_top", feed_format: true } do %>
        <%= hidden_field_tag :scope, @feed.scope, id: nil %>
        <% if @feed.circuit %><%= hidden_field_tag :circuit, @feed.circuit.id, id: nil %><% end %>
        <div class="flex h-full flex-col justify-between gap-2">
          <%= select_tag :play, options_for_select([[t("feed.all_formats"), ""]] + Event::PLAYS.map { |play| [play_label(play), play] }, @feed.play),
                         "aria-label": t("feed.format"), class: "field-input h-10 text-[12.5px]",
                         data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
          <%= select_tag :organizer, options_for_select([[t("feed.all_organizers"), ""]] + @feed.organizers.map { |organizer| [organizer.name, organizer.user.handle] }, @feed.organizer&.user&.handle),
                         "aria-label": t("feed.organizer"), class: "field-input h-10 text-[12.5px]",
                         data: { controller: "submit-on-change", action: "change->submit-on-change#submit", feed_organizer: true } %>
          <% if @feed.top? %><%= hidden_field_tag :sort, "top", id: nil %><% end %>
          <% if @feed.mine? %><%= hidden_field_tag :mine, "1", id: nil %><% end %>
          <% if @feed.mentions? %><%= hidden_field_tag :mentions, "1", id: nil %><% end %>
        </div>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 px-1" data-feed-quick>
      <span class="seg" data-feed-sort>
        <%= link_to t("feed.sort.new"), feed_url_with(@feed, sort: nil), class: ("seg-on" if @feed.sort == "new"), "aria-current": ("page" if @feed.sort == "new") %>
        <%= link_to t("feed.sort.top"), feed_url_with(@feed, sort: "top"), class: ("seg-on" if @feed.sort == "top"), "aria-current": ("page" if @feed.sort == "top") %>
      </span>
      <% if authenticated? %>
        <span class="flex flex-wrap gap-1.5" data-feed-toggles>
          <%= link_to t("feed.mine"), feed_url_with(@feed, mine: (@feed.mine? ? nil : "1")), class: "filter-chip #{"bg-accent/15 text-ink" if @feed.mine?}", "aria-pressed": @feed.mine?.to_s, data: { feed_mine: true } %>
          <%= link_to t("feed.mentions_me"), feed_url_with(@feed, mentions: (@feed.mentions? ? nil : "1")), class: "filter-chip #{"bg-accent/15 text-ink" if @feed.mentions?}", "aria-pressed": @feed.mentions?.to_s, data: { feed_mentions: true } %>
        </span>
      <% end %>
    </div>

    <%# Visitors' default page is cached for 30 seconds: during a tournament peak the feed costs one query a minute. %>
    <%= cache_if @cacheable, ["feed-visitor-page", I18n.locale], expires_in: 30.seconds do %>
      <div class="feed-list" data-feed-list data-feed-cached="<%= @cacheable %>">
        <% @posts.each do |post| %>
          <%= render "posts/post", post: post, liked: @liked_ids.include?(post.id), reported: @reported_ids.include?(post.id), url_locale: url_locale, flat: true, mentioned: mentioned %>
        <% end %>
        <% if @posts.empty? %>
          <p class="px-4 py-8 text-center text-[13px] text-muted" data-feed-empty><%= t(@feed.scope == "following" ? "feed.empty_following" : "feed.empty") %></p>
        <% end %>
      </div>
    <% end %>
    <div><%= paginate @posts %></div>
    <% end %>
    <details class="rounded-lg border border-line bg-surface/80 px-4 py-3 text-[12.5px] text-muted" data-feed-policy>
      <summary class="cursor-pointer font-semibold text-ink"><%= t("feed.policy.title") %></summary>
      <ul class="mt-2 list-disc space-y-1 ps-5">
        <% t("feed.policy.rules").each do |rule| %><li><%= rule %></li><% end %>
      </ul>
    </details>
  </div>
</div>
