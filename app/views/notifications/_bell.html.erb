<% unread = current_user.unread_notifications_count %>
<%= link_to notifications_path(locale: params[:locale]), data: { notifications_bell: true },
            title: t("notifications.title"),
            class: ["relative inline-flex items-center gap-1 rounded-md p-1.5 text-muted hover:text-ink", local_assigns[:class]] do %>
  <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
  </svg>
  <span class="sr-only"><%= t("notifications.title") %></span>
  <% if unread.positive? %>
    <span data-unread-count class="min-w-5 h-5 px-1 inline-flex items-center justify-center rounded-full bg-accent text-ground text-[11px] font-semibold tabular"><%= unread %></span>
  <% end %>
<% end %>
