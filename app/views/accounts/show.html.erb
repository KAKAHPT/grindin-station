<%# Account (spec §4): the same cards (dark title band) and Settings-look fields as the organizer pages. %>
<% input = "field-input" %>
<% field = "field" %>
<% hint = "form-help" %>

<div class="col-span-full max-w-2xl mx-auto w-full py-4 space-y-5 text-ink" data-account>
  <h1 class="font-display text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @user, url: account_path(locale: params[:locale]), method: :patch, class: "space-y-6" do |f| %>
    <% if @user.errors.any? %>
      <div class="p-4 rounded-md border border-danger/40 text-danger text-sm" role="alert">
        <ul class="list-disc pl-5 space-y-1">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="card">
      <h2 class="card-title"><%= t(".profile") %></h2>
      <div class="p-4 space-y-4">
        <div class="flex items-center gap-4">
          <% if @user.avatar.attached? && @user.avatar.blob.persisted? %>
            <%= image_tag @user.avatar.variant(:thumb), alt: "", class: "size-20 rounded-full object-cover border border-line" %>
          <% else %>
            <div class="size-20 rounded-full bg-surface-raised border border-line flex items-center justify-center font-display text-2xl text-muted">
              <%= @user.name.to_s.first.upcase %>
            </div>
          <% end %>
          <div class="flex-1 <%= field %>">
            <%= f.label :avatar %>
            <%= f.file_field :avatar, accept: User::AVATAR_TYPES.join(","), class: "#{input} file:me-3 file:rounded file:border-0 file:bg-surface-raised file:px-2 file:py-1 file:text-ink" %>
            <p class="<%= hint %>"><%= t(".avatar_hint") %></p>
          </div>
        </div>

        <% if @user.event_organizer %>
          <div class="<%= field %>" data-banner-field>
            <% if @user.banner.attached? && @user.banner.blob.persisted? %>
              <%= image_tag @user.banner.variant(:card), alt: "", class: "mb-2 h-24 w-full rounded-lg object-cover border border-line" %>
            <% end %>
            <%= f.label :banner %>
            <%= f.file_field :banner, accept: User::AVATAR_TYPES.join(","), class: "#{input} file:me-3 file:rounded file:border-0 file:bg-surface-raised file:px-2 file:py-1 file:text-ink" %>
            <p class="<%= hint %>"><%= t(".banner_hint") %></p>
          </div>
        <% end %>

        <div class="<%= field %>">
          <%= f.label :name %>
          <%= f.text_field :name, required: true, class: input %>
        </div>
        <div class="<%= field %>">
          <%= f.label :email_address %>
          <%= f.email_field :email_address, required: true, autocomplete: "username", class: input %>
          <% if @user.password_set %>
            <p class="<%= hint %>"><%= t(".email_hint") %></p>
          <% end %>
        </div>
        <% if @user.player %>
          <div class="<%= field %>">
            <%= f.fields_for :player, update_only: true do |pf| %>
              <%= pf.label :wizards_email %>
              <%= pf.email_field :wizards_email, class: input %>
              <p class="<%= hint %>"><%= t(".wizards_email_hint") %></p>
            <% end %>
          </div>
        <% end %>
        <div class="<%= field %>">
          <%= f.label :handle %>
          <%= f.text_field :handle, required: true, pattern: "[a-z0-9\\-]{3,30}", class: input %>
          <p class="<%= hint %>"><%= t(".handle_hint") %></p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="<%= field %>">
            <%= f.label :country %>
            <%= f.text_field :country, maxlength: 2, placeholder: "PT", class: "#{input} uppercase" %>
          </div>
          <div class="<%= field %>">
            <%= f.label :visibility %>
            <%= f.select :visibility, User::VISIBILITIES.map { |v| [ t(".visibility.#{v}"), v ] }, {}, class: input %>
          </div>
        </div>
        <div class="<%= field %>">
          <%= f.label :feed_scope %>
          <%= f.select :feed_scope, User::FEED_SCOPES.map { |v| [ t(".feed_scope.#{v}"), v ] }, {}, class: input %>
          <p class="<%= hint %>"><%= t(".feed_scope_hint") %></p>
        </div>
        <div class="<%= field %>">
          <%= f.label :bio %>
          <%= f.text_area :bio, rows: 4, maxlength: 500, class: input %>
        </div>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title"><%= t(".password") %></h2>
      <div class="p-4 space-y-4">
        <% unless @user.password_set %>
          <p class="<%= hint %>"><%= t(".password_not_set") %></p>
        <% end %>
        <% if @user.password_set %>
          <div class="<%= field %>">
            <%= label_tag "user_current_password", User.human_attribute_name(:current_password) %>
            <%= password_field_tag "user[current_password]", nil, id: "user_current_password", autocomplete: "current-password", class: input %>
          </div>
        <% end %>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="<%= field %>">
            <%= f.label :password, t(".new_password") %>
            <%= f.password_field :password, autocomplete: "new-password", minlength: 8, maxlength: 72, class: input %>
          </div>
          <div class="<%= field %>">
            <%= f.label :password_confirmation, t("accounts.confirm_new_password") %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", minlength: 8, maxlength: 72, class: input %>
          </div>
        </div>
      </div>
    </section>

    <%= f.button t(".save"), class: button_classes(:primary, "w-full sm:w-auto") %>
  <% end %>

  <%= render "accounts/team", user: @user %>

  <section class="card">
    <h2 class="card-title"><%= t(".identities") %></h2>
    <div class="p-4 space-y-4">
      <% if @user.identities.empty? %>
        <p class="<%= hint %>"><%= t(".no_identities") %></p>
      <% else %>
        <ul class="divide-y divide-line">
          <% can_unlink = @user.can_unlink_identity? %>
          <% @user.identities.each do |identity| %>
            <li class="flex items-center justify-between gap-3 py-3">
              <span>
                <span class="font-display font-semibold"><%= OmniauthCallbacksController::PROVIDER_NAMES.fetch(identity.provider, identity.provider) %></span>
                <span class="text-sm text-muted"><%= identity.email.presence || identity.name %></span>
              </span>
              <% if can_unlink %>
                <%= button_to t(".unlink"), unlink_identity_path(identity, locale: params[:locale]), method: :delete, class: small_button_classes(:secondary) %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% unless can_unlink %>
          <p class="<%= hint %>"><%= t(".unlink_hint") %></p>
        <% end %>
      <% end %>
      <% linkable = OmniauthCallbacksController::PROVIDER_NAMES.select { |provider, _| oauth_enabled?(provider) && @user.identities.none? { |i| i.provider == provider } } %>
      <% if linkable.any? %>
        <div class="flex flex-wrap gap-2">
          <% linkable.each do |provider, name| %>
            <%= button_to t(".link", provider: name), "/auth/#{provider}", method: :post, data: { turbo: false }, class: small_button_classes(:secondary) %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="card border-danger/40">
    <h2 class="card-title text-danger"><%= t(".delete_title") %></h2>
    <div class="p-4 space-y-3">
      <p class="<%= hint %>"><%= t(".delete_explanation") %></p>
      <%= form_with url: account_path(locale: params[:locale]), method: :delete, class: "space-y-3" do |f| %>
        <div class="<%= field %>">
          <%= f.label :confirmation, t(".delete_prompt", word: t(".delete_word")) %>
          <%= f.text_field :confirmation, required: true, autocomplete: "off", class: input %>
        </div>
        <%= f.button t(".delete_button"), class: button_classes(:danger, "w-full sm:w-auto") %>
      <% end %>
    </div>
  </section>
</div>
