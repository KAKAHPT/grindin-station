<div class="col-span-full pt-2" data-my-events>
  <h1 class="font-display text-2xl font-semibold text-ink"><%= t("my_events.title") %></h1>
  <p class="mt-1 text-[13px] text-muted"><%= t("my_events.lead") %></p>
</div>

<%# The events the viewer runs or works as staff: straight into the organizer's side of each. %>
<% if @staffed.any? %>
  <section class="col-span-full card overflow-clip" data-my-staffed>
    <h2 class="card-title"><%= t("my_events.staffed") %></h2>
    <ul class="divide-y divide-line text-[13px]">
      <% @staffed.each do |event, role| %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3" data-staffed-event="<%= event.id %>">
          <div class="min-w-0">
            <p class="flex flex-wrap items-center gap-2 text-[14px] font-semibold text-ink">
              <%= event.name %>
              <%= desk_chip(:info) { t("organizer.staff.roles.#{role}") } %>
            </p>
            <p class="mt-0.5 text-[12px] text-muted"><%= l(event.start_time, format: :short) %> · <%= event_state_label(event, nil) %></p>
          </div>
          <%= link_to t("my_events.manage"), (event.is_a?(League) ? organizer_league_path(event) : organizer_tournament_path(event)), class: button_classes(:primary, size: :sm) %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @league_tables.present? %>
  <section class="col-span-full card overflow-clip" data-my-league-tables>
    <h2 class="card-title"><%= t("my_events.league_tables") %></h2>
    <ul class="divide-y divide-line text-[13px]">
      <% @league_tables.each do |table| %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="min-w-0">
            <p class="text-[12px] text-muted"><%= table.league.name %> · <%= t("my_events.league_table_#{table.state}") %></p>
            <p class="text-ink"><%= table.participants.map(&:name).join(", ") %></p>
          </div>
          <%= link_to t("my_events.league_table_open"), league_path(table.league, tab: "mine", locale: params[:locale]), class: button_classes(:primary, size: :sm) %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= render "shared/ticket_grid", events: @running, enrolled: @enrolled, heading: t("my_events.running"), dense: true, participants: @participants %>
<%= render "shared/ticket_grid", events: @upcoming, enrolled: @enrolled, heading: t("my_events.upcoming"), dense: true, participants: @participants %>
<%# Past events stay folded away: the button opens them. %>
<% if @past.any? %>
  <details class="col-span-full" data-my-past>
    <summary class="<%= button_classes(:secondary, size: :sm) %> cursor-pointer list-none [&::-webkit-details-marker]:hidden"><%= t("my_events.show_past", count: @past.size) %></summary>
    <div class="mt-4 grid">
      <%= render "shared/ticket_grid", events: @past, enrolled: @enrolled, dense: true, participants: @participants %>
    </div>
  </details>
<% end %>

<% if @running.empty? && @upcoming.empty? && @past.empty? && @staffed.empty? %>
  <div class="col-span-full card px-4 py-8 text-center" data-list-empty>
    <p class="text-[13px] text-muted"><%= t("my_events.empty") %></p>
    <%= link_to t("my_events.browse"), events_path(locale: params[:locale]), class: button_classes(:secondary, "mt-4") %>
  </div>
<% end %>
