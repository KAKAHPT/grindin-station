<div class="col-span-full" data-my-events>
  <%= render "shared/list_header", title: t("my_events.title"), lead: t("my_events.lead") %>
</div>

<%# The events the viewer runs or works as staff, as tiles like the event tickets: the role on the cover and one
    button straight into the organizer's side. %>
<% if @staffed.any? %>
  <section class="col-span-full" data-my-staffed>
    <h2 class="mb-3 font-display text-[17px] font-semibold text-ink"><%= t("my_events.staffed") %></h2>
    <div class="lp-evl lp-evl-dense lp-evl-mine">
      <% @staffed.each do |event, role| %>
        <% manage = event.is_a?(League) ? organizer_league_path(event) : organizer_tournament_path(event) %>
        <article class="card lp-evr" data-staffed-event="<%= event.id %>">
          <div class="lp-evr-cov">
            <div class="lp-evr-ban" style="background-image: url('<%= ticket_banner(event) %>')" aria-hidden="true"></div>
            <div class="lp-evr-shade" aria-hidden="true"></div>
            <span class="lp-evr-tag"><%= t("organizer.staff.roles.#{role}") %></span>
            <div class="lp-evr-date">
              <% if event.date_tba %>
                <b data-date-tba><%= t("play.events.date_tba_short") %></b>
                <span><%= t("play.events.date_tba") %></span>
              <% else %>
                <b><%= l(event.start_time, format: "%d") %></b>
                <span><%= l(event.start_time, format: "%b · %a") %></span>
              <% end %>
            </div>
          </div>
          <div class="lp-evr-bd">
            <h3 class="lp-evr-t"><%= link_to event.name, manage %></h3>
            <p class="lp-evr-m"><%= event_state_label(event, nil) %></p>
          </div>
          <div class="lp-evr-stub">
            <div class="lp-evr-act"><%= link_to t("my_events.manage"), manage, class: button_classes(:primary, size: :xs) %></div>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<%# The league tables the viewer sits at, the same way: the league's cover, who is at the table, one button. %>
<% if @league_tables.present? %>
  <section class="col-span-full" data-my-league-tables>
    <h2 class="mb-3 font-display text-[17px] font-semibold text-ink"><%= t("my_events.league_tables") %></h2>
    <div class="lp-evl lp-evl-dense lp-evl-mine">
      <% @league_tables.each do |table| %>
        <% open = league_path(table.league, tab: "mine", locale: params[:locale]) %>
        <article class="card lp-evr" data-my-league-table="<%= table.id %>">
          <div class="lp-evr-cov">
            <div class="lp-evr-ban" style="background-image: url('<%= ticket_banner(table.league) %>')" aria-hidden="true"></div>
            <div class="lp-evr-shade" aria-hidden="true"></div>
            <span class="lp-evr-tag"><%= t("my_events.league_table_#{table.state}") %></span>
          </div>
          <div class="lp-evr-bd">
            <h3 class="lp-evr-t"><%= link_to table.league.name, open %></h3>
            <p class="lp-evr-m"><%= table.participants.map(&:name).join(", ") %></p>
          </div>
          <div class="lp-evr-stub">
            <div class="lp-evr-act"><%= link_to t("my_events.league_table_open"), open, class: button_classes(:primary, size: :xs) %></div>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<%= render "shared/ticket_grid", events: @running, enrolled: @enrolled, heading: t("my_events.running"), dense: true, participants: @participants %>
<%= render "shared/ticket_grid", events: @upcoming, enrolled: @enrolled, heading: t("my_events.upcoming"), dense: true, participants: @participants %>
<%# Past events stay folded away: the button opens them. %>
<% if @past.any? %>
  <details class="col-span-full" data-my-past>
    <summary class="<%= button_classes(:secondary, size: :sm) %> cursor-pointer list-none [&::-webkit-details-marker]:hidden"><%= t("my_events.show_past", count: @past.size) %></summary>
    <div class="mt-4 grid">
      <%= render "shared/ticket_grid", events: @past, enrolled: @enrolled, dense: true, participants: @participants %>
    </div>
  </details>
<% end %>

<% if @running.empty? && @upcoming.empty? && @past.empty? && @staffed.empty? %>
  <div class="col-span-full card px-4 py-8 text-center" data-list-empty>
    <p class="text-[13px] text-muted"><%= t("my_events.empty") %></p>
    <%= link_to t("my_events.browse"), events_path(locale: params[:locale]), class: button_classes(:secondary, "mt-4") %>
  </div>
<% end %>
