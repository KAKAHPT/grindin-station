<%# The landing (/): the scrolling card-art mosaic behind the hero (headline, tagline, lead), then the featured
    tournaments and circuits (when any), the next public tournaments, how seats are weighted (Why it is fair) and,
    last, the organisers' waiting-list card in its own labelled grey box. Signed-out visitors get a sign-up row under
    the upcoming tournaments. %>
<%# No page title: the browser tab reads just the app name. %>
<%# While 1v1 is paused (config/features.yml) the texts promise cEDH only. %>
<% cedh_only = !Features.on?(:one_v_one) %>
<% content_for :description, t(cedh_only ? "landing.description_cedh" : "landing.description") %>
<% content_for :full_main, "1" %>
<% content_for :footer_note do %>
  <p class="mb-3 text-xs" data-attribution><%= t("landing.attribution") %></p>
<% end %>
<% url_locale = params[:locale] %>
<% arts = (1..48).map { |n| image_path("landing/c#{n}.jpg") } %>

<div class="landing">
  <section class="lp-hero">
    <%# The backdrop fades to nothing at the bottom, so the cards rise out of the page itself. %>
    <div class="lp-backdrop" aria-hidden="true">
    <div class="lp-mosaic">
      <% 2.times do %>
        <div class="lp-sheet">
          <% arts.each do |src| %>
            <img src="<%= src %>" alt="" width="240" height="175" loading="lazy" decoding="async">
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="lp-vig"></div>
    </div>
    <div class="lp-hero-in">
      <div class="lp-mark"><%= render "shared/mark", size: 84, id_suffix: "hero", rotating: true %></div>
      <p class="lp-eyebrow"><%= t("landing.eyebrow") %></p>
      <h1><%= t("landing.headline") %></h1>
      <p class="lp-sub"><%= t("landing.tagline_html") %> <% if Features.on?(:fairness) %><%= link_to t("landing.why.tests"), fairness_path(locale: url_locale), class: "lp-sub-a", data: { tests: true } %><% end %></p>
      <p class="lp-lead"><%= t(cedh_only ? "landing.lead_cedh" : "landing.lead") %></p>
      <div class="lp-ctas">
        <%= link_to t("landing.cta_events"), "#upcoming", class: button_classes(:light, size: :sm) %>
      </div>
    </div>
  </section>

  <%# A small filter box that floats at the left edge of wide screens while the page scrolls; it opens /events
      with the results. %>
  <div class="lp-float" data-home-filters>
    <%= render "shared/filter_bar", url: events_path(locale: url_locale), count: "",
                                    fields: event_filter_fields({}, @filter_options).select { |name, *| name.in?(%i[q country organizer play]) } %>
  </div>

  <% if @featured.any? %>
    <section class="lp-feat" data-featured data-controller="rail">
      <%= render "pages/rail_header", title: t("landing.featured.title") %>
      <div class="lp-rail lp-ftl" data-rail-target="track">
        <% @featured.each do |event| %>
          <%= render "shared/featured_ticket", event: event, enrolled: @enrolled.fetch(event.id, 0) %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @featured_circuits.any? %>
    <section class="lp-feat" data-featured-circuits data-controller="rail">
      <%= render "pages/rail_header", title: t("landing.featured_circuits") %>
      <div class="lp-rail lp-crl" data-rail-target="track">
        <% @featured_circuits.each do |circuit| %>
          <% banner = circuit.banner.attached? %>
          <%= link_to circuit_path(circuit, locale: url_locale), class: "card org-card block p-4 hover:border-line-strong #{"org-card-banner" if banner}",
                      style: ("background-image: url('#{url_for(circuit.banner.variant(:card))}')" if banner), data: { featured_circuit: circuit.id } do %>
            <p class="text-[10.5px] font-semibold uppercase tracking-[0.08em] text-muted"><%= t("lists.circuits.one") %></p>
            <h3 class="mt-1 font-display text-[15px] font-semibold text-ink"><%= circuit.name %></h3>
            <% if circuit.event_organizer %><p class="mt-0.5 text-[12px] text-muted"><%= t("lists.organized_by_html", name: circuit.event_organizer.name) %></p><% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="lp-upc" id="upcoming" data-upcoming>
    <div class="lp-upc-hd">
      <h2><%= t("landing.upcoming.title") %></h2>
      <div class="lp-upc-side">
        <span>
          <% if @open_count.positive? %><%= t("landing.upcoming.open", count: @open_count) %> · <% end %>
          <%= link_to t("landing.upcoming.see_all"), events_path(locale: url_locale) %>
        </span>
        <% if @plays.size > 1 %>
          <%# Format filter: a small select (All formats, then every format with an upcoming event), submitted on change. %>
          <%= form_with url: root_path(locale: url_locale, anchor: "upcoming"), method: :get, class: "lp-upc-filter", data: { upcoming_filter: true } do |f| %>
            <%= f.label :play, t("landing.upcoming.format"), class: "sr-only" %>
            <%= f.select :play, [[t("landing.upcoming.all_formats"), ""]] + @plays.map { |play| [play_label(play), play] },
                         { selected: @play.to_s }, class: "field-input lp-upc-select",
                         data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
          <% end %>
        <% end %>
      </div>
    </div>
    <% if @upcoming.any? %>
      <div class="lp-evl">
        <% @upcoming.each do |event| %>
          <% count = @enrolled.fetch(event.id, 0) %>
          <%= render "shared/event_ticket", event: event, enrolled: count, sold_out: event.sold_out?(count) %>
        <% end %>
      </div>
    <% else %>
      <p class="card lp-empty"><%= t("landing.upcoming.empty") %></p>
    <% end %>
    <% unless authenticated? %>
      <%# Players were filling in the organisers' waiting list to register: the way to an account sits here. %>
      <div class="lp-join" data-signup-cta>
        <p><strong><%= t("landing.signup.title") %></strong> <%= t("landing.signup.text") %></p>
        <%= link_to t("auth.sign_up"), new_registration_path(locale: url_locale), class: button_classes(:light) %>
      </div>
    <% end %>
  </section>

  <div class="lp-fair" id="about">
    <section class="lp-why">
      <h2><%= t("landing.why.title") %></h2>
      <p><%= t("landing.why.intro") %></p>
      <%# The four steps come in one at a time when the list scrolls into view (reveal controller). %>
      <ol data-controller="reveal">
        <% t("landing.why.steps").each_with_index do |step, index| %>
          <li><b><%= index + 1 %></b><span><strong><%= step[:title] %></strong> <%= step[:text] %></span></li>
        <% end %>
      </ol>
      <p><%= t("landing.why.audit") %></p>
      <% if Features.on?(:fairness) %>
        <p class="lp-why-cta"><%= link_to t("landing.why.tests"), fairness_path(locale: url_locale), class: button_classes(:secondary, size: :sm), data: { tests: true } %></p>
      <% end %>
    </section>
  </div>

  <%# Last on the page: players looking for a tournament were filling it in by mistake when it sat under the hero. %>
  <%# The page ends as it began: the card wall behind, here rising out of nothing and sinking off the bottom. %>
  <div class="lp-end">
    <div class="lp-backdrop lp-backdrop-end" aria-hidden="true">
      <div class="lp-mosaic">
        <% 2.times do %>
          <div class="lp-sheet">
            <% arts.each do |src| %>
              <img src="<%= src %>" alt="" width="240" height="175" loading="lazy" decoding="async">
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="lp-vig"></div>
    </div>
    <section class="lp-org" data-organizers-box>
      <h2 class="lp-org-t"><%= t("landing.waitlist.heading") %></h2>
      <%= render "pages/waitlist", signup: @waitlist_signup, state: nil %>
    </section>
  </div>
</div>
