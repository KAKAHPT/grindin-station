<%# One row of the landing's upcoming events: the cover blurred behind (else a card-art crop picked from the slug),
    date block, name, format line, organizer, enrolled count, state chip, View event and, while registration is
    open, Register. Locals: event (Tournament, cover and organizer preloaded), enrolled (count). %>
<% url_locale = params[:locale] %>
<% banner = event.cover.attached? ? rails_blob_path(event.cover, only_path: true) : image_path("landing/c#{Zlib.crc32(event.slug) % 48 + 1}.jpg") %>
<% organizer = event.event_organizer&.user&.name %>
<% max = event.maximum_participants %>
<% city = event.address.to_s.split(",").last.to_s.strip.presence %>
<% line = [city, event_format_label(event),
           (t("organizer.shell.swiss_rounds", count: event.swiss_rounds_count) if event.swiss_rounds_count.to_i.positive?),
           (t("organizer.top_cut_option", size: event.top_cut_size) if event.top_cut_size.to_i.positive?),
           (tournament_price(event) if event.price.to_d.zero? || event.currency)].compact.join(" · ") %>
<article class="card lp-evr" data-upcoming-event="<%= event.slug %>">
  <div class="lp-evr-ban" style="background-image: url('<%= banner %>')" aria-hidden="true"></div>
  <div class="lp-evr-shade" aria-hidden="true"></div>
  <div class="lp-evr-date">
    <b><%= l(event.start_time, format: "%d") %></b>
    <span><%= l(event.start_time, format: "%b") %></span>
  </div>
  <div class="min-w-0">
    <h3 class="lp-evr-t"><%= link_to event.name, play_event_path(event.slug, locale: url_locale) %></h3>
    <p class="lp-evr-m"><%= line %></p>
    <% if organizer %>
      <p class="lp-evr-org"><i aria-hidden="true"><%= organizer.split.first(2).map { |word| word[0] }.join.upcase %></i><%= organizer %></p>
    <% end %>
  </div>
  <p class="lp-evr-n"><b><%= enrolled %></b><%= max.infinite? ? t("landing.upcoming.enrolled") : t("landing.upcoming.of_max", max: max) %></p>
  <div class="lp-evr-act">
    <%= event_state_chip(event, (event.rounds_count if event.rounds_count.positive?)) %>
    <%= link_to t("landing.upcoming.view"), play_event_path(event.slug, locale: url_locale), class: button_classes(:secondary, size: :sm) %>
    <% if event.registration_open? %>
      <%= link_to t("landing.upcoming.register"), play_event_path(event.slug, locale: url_locale), class: button_classes(:primary, size: :sm), data: { register: true } %>
    <% end %>
  </div>
</article>
