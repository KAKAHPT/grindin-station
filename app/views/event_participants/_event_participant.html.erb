<% pad = local_assigns.fetch(:pad, "px-3") %>
<tr
  id="<%= dom_id(event_participant) %>"
  class="<%= event_participant.playing? ? "" : "line-through text-muted" %> h-[34px] odd:bg-white/[0.015] hover:bg-white/[0.04] transition-colors"
>
  <th
    scope="row"
    class="<%= pad %> py-0.5 text-center whitespace-nowrap"
  >
    <% if local_assigns[:final] && event_participant.final_position %>
      <span data-final-position class="tabular font-semibold text-accent"><%= event_participant.final_position %></span>
    <% else %>
      <span class="tabular text-muted"><%= event_participant_iteration.index + 1 %></span>
    <% end %>
  </th>
  <th
    scope="row"
    data-tooltip-target="tooltip-<%= event_participant.id %>"
    class="<%= pad %> py-0.5 font-semibold text-ink whitespace-nowrap"
  >
    <span class="<%= "block max-w-[7.5rem] truncate @lg:max-w-none" if local_assigns[:wide_only].present? %>"><%= profile_link(event_participant.player.user, truncate(event_participant.name)) %></span>
  </th>
  <% columns = event_participant.standing_columns %>
  <td class="<%= pad %> py-0.5 tabular text-right font-display text-[12px] font-semibold text-accent"><%= columns[:points] %></td>
  <% if event_participant.event.one_v_one? %>
    <td class="<%= pad %> py-0.5 tabular text-right"><%= rate_label(columns[:omw]) %></td>
    <td class="<%= local_assigns[:wide_only] %> <%= pad %> py-0.5 tabular text-right"><%= rate_label(columns[:gw]) %></td>
    <td class="<%= local_assigns[:wide_only] %> <%= pad %> py-0.5 tabular text-right"><%= rate_label(columns[:ogw]) %></td>
    <td class="<%= pad %> py-0.5 tabular text-right"><%= win_rate_label(event_participant.win_rate) %></td>
  <% else %>
    <td class="<%= pad %> py-0.5 tabular text-right"><%= win_rate_label(event_participant.win_rate) %></td>
    <td class="<%= local_assigns[:wide_only] %> <%= pad %> py-0.5 tabular text-right">
      <%= number_to_percentage(columns[:owr] * 100, precision: 1) %>
    </td>
    <td class="<%= local_assigns[:wide_only] %> <%= pad %> py-0.5 tabular text-right"><%= columns[:beaten] %></td>
    <td class="<%= local_assigns[:wide_only] %> <%= pad %> py-0.5 tabular text-right"><%= columns[:unique] %></td>
    <td class="<%= local_assigns[:wide_only] %> <%= pad %> py-0.5 text-nowrap">
      <%= seat_grid(columns[:seats], seat_five: local_assigns.fetch(:seat_five, false)) %>
    </td>
  <% end %>
  <td class="<%= pad %> py-0.5 tabular text-right text-nowrap">
    <% wld = [event_participant.number_of_wins, event_participant.number_of_losses, event_participant.number_of_draws] %>
    <% if local_assigns[:wide_only].present? %>
      <span class="@lg:hidden"><%= wld.join("-") %></span>
      <span class="hidden @lg:inline"><%= safe_join(wld, raw("&nbsp;-&nbsp;")) %></span>
    <% else %>
      <%= safe_join(wld, raw("&nbsp;-&nbsp;")) %>
    <% end %>
  </td>
  <div
    id="tooltip-<%= event_participant.id %>"
    role="tooltip"
    class="
      absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium
      text-ink transition-opacity duration-300 bg-ground border border-line rounded-lg
    shadow-sm opacity-0 tooltip
    "
  >
    <%= event_participant.name %>
    <br>

    <%= event_participant.obfuscated_key %>
    <div class="tooltip-arrow" data-popper-arrow="true"></div>
  </div>
</tr>
