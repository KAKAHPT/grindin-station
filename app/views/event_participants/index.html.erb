<% content_for :title do %>
  <%= @tournament.name %>
  Participants
<% end %>

<% unless @standings_in_modal %>
  <% turbo_refreshes_with method: :morph, scroll: :preserve %>
  <%= turbo_stream_from LiveBroadcasts.standings_stream(@tournament.id) %>
<% end %>
<% latest_published = @tournament.rounds.published.max_by(&:number) %>
<% one_v_one = @tournament.one_v_one? %>
<% content_for :close do %>
  <% if latest_published %>
    <%= link_to [@tournament, latest_published.becomes(Round)], class: "ms-auto #{icon_button_classes}" do %>
      <svg
        class="w-3 h-3"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 14"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
        />
      </svg>
      <span class="sr-only">Close modal</span>
    <% end %>
  <% end %>
<% end %>

<% unless @standings_in_modal %>
  <h2 class="mb-3 font-display text-xl font-semibold"><%= @tournament.finished? ? t("play.standings.final_title") : t("play.nav.standings") %></h2>
<% end %>
<% if @standings.any? %>
  <div class="<%= @standings_in_modal ? "-m-4 md:-m-5 overflow-x-auto" : "-mx-4 sm:mx-0 rounded-none sm:rounded-xl bg-surface border-y sm:border border-line shadow-card overflow-clip" %>">
  <%# In the narrow play column (a container) OWR, Beaten, Unique and Seats (1v1: GW% and OGW%) show only from 32rem up; the modal shows all. %>
  <% wide_only = @standings_in_modal ? "" : "hidden @lg:table-cell" %>
  <% pad = @standings_in_modal ? "px-3" : "px-2 @lg:px-3" %>
  <div class="<%= "@container" unless @standings_in_modal %> overflow-x-auto">
  <table class="w-full text-[12px] text-left rtl:text-right text-ink">
    <thead class="sticky top-0 z-10 text-[10.5px] tracking-[0.06em] text-muted uppercase bg-surface-raised/95 backdrop-blur border-b border-line-strong">
      <tr>
        <th
          scope="col"
          class="<%= pad %> py-2 text-center"
          data-tooltip-target="tooltip-rank"
        >
          Rank
        </th>
        <th scope="col" class="<%= pad %> py-2 whitespace-nowrap">Player</th>
        <th scope="col" class="<%= pad %> py-2 whitespace-nowrap text-right" data-tooltip-target="tooltip-points">
          <%= t("standings.columns.points") %>
        </th>
        <% if one_v_one %>
          <% %w[omw gw ogw].each do |column| %>
            <th scope="col" class="<%= wide_only unless column == "omw" %> <%= pad %> py-2 whitespace-nowrap text-right" data-tooltip-target="tooltip-<%= column %>">
              <%= t("standings.columns.#{column}") %>
            </th>
          <% end %>
          <th scope="col" class="<%= pad %> py-2 whitespace-nowrap text-right"><%= t("standings.columns.win_rate") %></th>
        <% else %>
          <th scope="col" class="<%= pad %> py-2 whitespace-nowrap text-right"><%= t("standings.columns.win_rate") %></th>
          <th scope="col" class="<%= wide_only %> <%= pad %> py-2 whitespace-nowrap text-right" data-tooltip-target="tooltip-owr">
            <%= t("standings.columns.owr") %>
          </th>
          <th scope="col" class="<%= wide_only %> <%= pad %> py-2 whitespace-nowrap text-right" data-tooltip-target="tooltip-beaten">
            <%= t("standings.columns.beaten") %>
          </th>
          <th scope="col" class="<%= wide_only %> <%= pad %> py-2 whitespace-nowrap text-right" data-tooltip-target="tooltip-unique">
            <%= t("standings.columns.unique") %>
          </th>
          <th scope="col" class="<%= wide_only %> <%= pad %> py-2 whitespace-nowrap">
            <%= t("standings.columns.seats") %>
          </th>
        <% end %>
        <th scope="col" class="<%= pad %> py-2 whitespace-nowrap text-right" data-tooltip-target="tooltip-wld">
          W-L-D
        </th>

        <div
          id="tooltip-rank"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
          "
        >
          Player rank is calculated according to the tiebreakers you can see in
          this table:
          <br>
          <%= t(one_v_one ? "standings.order_tooltip_one_v_one" : "standings.order_tooltip") %>
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
        <div
          id="tooltip-points"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
          "
        >
          <%= t("standings.help.points", win: @tournament.points_win, draw: @tournament.points_draw, loss: @tournament.points_loss) %>
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
        <% if one_v_one %>
          <% %w[omw gw ogw].each do |column| %>
            <div
              id="tooltip-<%= column %>"
              role="tooltip"
              class="
                absolute z-10 invisible inline-block px-3 py-2 text-sm
                font-medium text-ink transition-opacity duration-300
                bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
              "
            >
              <%= t("standings.help.#{column}") %>
              <div class="tooltip-arrow" data-popper-arrow="true"></div>
            </div>
          <% end %>
        <% else %>
          <div
            id="tooltip-owr"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
              bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            <%= t("standings.help.owr") %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <div
            id="tooltip-beaten"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
              bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            <%= t("standings.help.beaten") %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <div
            id="tooltip-unique"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
              bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            <%= t("standings.help.unique") %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
        <% end %>
        <div
          id="tooltip-wld"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
          "
        >
          W-L-D is the tournament track record expressed in:
          <br>
          Wins - Losses - Draws
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
      </tr>
    </thead>
    <tbody id="<%= dom_id(@tournament, :event_participants) %>" class="divide-y divide-line/60">
      <!-- TODO updated by turbo stream -->
      <% case @tournament.state %>
      <% when 'registration_open', 'registration_closed' %>
        <%= render partial: "event_participants/event_participant", collection: @standings.sort_by(&:name), locals: { wide_only: wide_only, pad: pad } %>
      <% else %>
        <%# A finished event lists everyone by the final position recorded when it finished; anyone without one follows by rank. %>
        <% final = @tournament.finished? %>
        <% standings = @standings.reject(&:waitlisted?).sort_by do |p|
             [final && p.final_position ? 0 : 1, (p.final_position if final).to_i, p.playing? ? 0 : 1, -p.rank_score, p.name]
           end %>
        <%= render partial: "event_participants/event_participant", collection: standings, locals: { seat_five: !one_v_one && seat_five?(standings), wide_only: wide_only, pad: pad, final: final } %>
      <% end %>
    </tbody>
  </table>
  </div>
  </div>
  <%= render "tournaments/standings_help", event: @tournament %>
<% end %>

<% content_for :footer do %>
  <% if latest_published %>
    <%= link_to [@tournament, latest_published.becomes(Round)], class: "ms-3 #{small_button_classes(:secondary)}" do %>
      Close
    <% end %>
  <% end %>
<% end %>
