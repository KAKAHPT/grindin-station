<% content_for :title do %>
  <%= @tournament.name %>
  Participants
<% end %>

<% content_for :close do %>
  <% if @tournament.rounds.present? %>
    <%= link_to [@tournament, @tournament.rounds.published.max_by(&:number).becomes(Round)], class:"text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" do %>
      <svg
        class="w-3 h-3"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 14"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
        />
      </svg>
      <span class="sr-only">Close modal</span>
    <% end %>
  <% end %>
<% end %>

<% if @tournament.event_participants.present? %>
  <table
    class="
      col-span-full text-md -m-4 md:-m-5 text-left rtl:text-right
      text-gray-500 dark:text-gray-400
    "
  >
    <thead
      class="
        text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700
        dark:text-gray-400
      "
    >
      <tr>
        <th
          scope="col"
          class="px-5 py-3 text-center"
          data-tooltip-target="tooltip-rank"
        >
          Rank
        </th>
        <th scope="col" class="px-5 py-3">Player</th>
        <th scope="col" class="px-5 py-3" data-tooltip-target="tooltip-points">
          Pts
        </th>
        <th scope="col" class="px-5 py-3" data-tooltip-target="tooltip-owr">
          OWR
        </th>
        <th scope="col" class="px-5 py-3" data-tooltip-target="tooltip-beaten">
          Beaten
        </th>
        <th scope="col" class="px-5 py-3" data-tooltip-target="tooltip-unique">
          Unique
        </th>
        <th scope="col" class="px-5 py-3">
          Seats
        </th>
        <th scope="col" class="px-5 py-3" data-tooltip-target="tooltip-wld">
          W-L-D
        </th>

        <div
          id="tooltip-rank"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-white transition-opacity duration-300
            bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip
            dark:bg-gray-700
          "
        >
          Player rank is calculated according to the tiebreakers you can see in
          this table:
          <br>
          Pts > OWR > Beaten > Unique > seeded draw
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
        <div
          id="tooltip-points"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-white transition-opacity duration-300
            bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip
            dark:bg-gray-700
          "
        >
          <%= t("standings.help.points", win: @tournament.points_win, draw: @tournament.points_draw, loss: @tournament.points_loss) %>
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
        <div
          id="tooltip-owr"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-white transition-opacity duration-300
            bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip
            dark:bg-gray-700
          "
        >
          <%= t("standings.help.owr") %>
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
        <div
          id="tooltip-beaten"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-white transition-opacity duration-300
            bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip
            dark:bg-gray-700
          "
        >
          <%= t("standings.help.beaten") %>
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
        <div
          id="tooltip-unique"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-white transition-opacity duration-300
            bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip
            dark:bg-gray-700
          "
        >
          <%= t("standings.help.unique") %>
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
        <div
          id="tooltip-wld"
          role="tooltip"
          class="
            absolute z-10 invisible inline-block px-3 py-2 text-sm
            font-medium text-white transition-opacity duration-300
            bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip
            dark:bg-gray-700
          "
        >
          W-L-D is the tournament track record expressed in:
          <br>
          Wins - Losses - Draws
          <div class="tooltip-arrow" data-popper-arrow="true"></div>
        </div>
      </tr>
    </thead>
    <tbody id="<%= dom_id(@tournament, :event_participants) %>">
      <!-- TODO updated by turbo stream -->
      <% case @tournament.state %>
      <% when 'registration_open', 'registration_closed' %>
        <%= render @tournament.event_participants.sort_by(&:name) %>
      <% else %>
        <% standings = @tournament.event_participants.sort_by { |p| [p.playing? ? 0 : 1, -p.rank_score, p.name] } %>
        <%= render partial: "event_participants/event_participant", collection: standings, locals: { seat_five: seat_five?(standings) } %>
      <% end %>
    </tbody>
  </table>
  <%= render "tournaments/standings_help", event: @tournament %>
<% end %>

<% content_for :footer do %>
  <% if @tournament.rounds.present? %>
    <%= link_to [@tournament, @tournament.rounds.published.max_by(&:number).becomes(Round)], class:"py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700" do %>
      Close
    <% end %>
  <% end %>
<% end %>
