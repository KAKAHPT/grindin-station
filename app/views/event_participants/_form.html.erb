<%= modal_form_for [@event_participant.event, @event_participant], html: { data: { turbo: false } } do |f| %>
  <% content_for :title do %>
    Are you sure you want to Sign up for
    <%= @event_participant.event.name %>
  <% end %>

  <% if @event_participant.errors.present? %>
    <%= safe_join(@event_participant.errors.full_messages, tag.br) %>
  <% end %>

  <%= f.text_field_with_label :decklist, placeholder: "https://moxfield.com/xyz" %>
  <%= f.check_box_with_label :accepted_terms, checked: !@event_participant.new_record? %>

  <% content_for :footer do %>
    <%= f.submit "Confirm Sign up" %>
    <%= link_to @event_participant.event, class: button_classes(:ghost, "ms-3", size: :sm) do %>
      Cancel
    <% end %>
  <% end %>
<% end %>
