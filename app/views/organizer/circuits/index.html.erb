<div class="col-span-full flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-display text-2xl font-semibold text-ink"><%= t("organizer.circuits.title") %></h1>
  <%= link_to t("organizer.circuits.new"), new_organizer_circuit_path, class: button_classes(:primary, size: :xs) %>
</div>

<% if @circuits.any? %>
  <div class="col-span-full grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
    <%= render @circuits %>
  </div>
  <div class="col-span-full"><%= paginate @circuits %></div>
<% else %>
  <p class="col-span-full card px-4 py-8 text-center text-[13px] text-muted"><%= t("organizer.circuits.empty") %></p>
<% end %>
