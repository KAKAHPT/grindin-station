<%= link_to [:organizer, circuit], class: "card block px-4 py-3.5 transition-colors hover:border-line-strong" do %>
  <div class="flex items-center justify-between gap-3">
    <h3 class="min-w-0 truncate font-display text-[15px] font-semibold text-ink"><%= circuit.name %></h3>
    <span class="text-[12px] text-muted tabular"><%= t("organizer.circuits.events", count: circuit.events.size) %></span>
  </div>
  <% if circuit.event_organizer %>
    <p class="mt-1.5 text-[12px] text-muted"><%= t("organizer.circuits.organized_by", name: circuit.event_organizer.name) %></p>
  <% end %>
<% end %>
