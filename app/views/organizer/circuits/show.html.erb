<div class="col-span-full flex flex-wrap items-end justify-between gap-3">
  <div class="min-w-0">
    <%= link_to t("organizer.circuits.title"), organizer_circuits_path, class: "text-[12px] font-semibold uppercase tracking-[0.08em] text-accent hover:underline" %>
    <h1 class="mt-1 font-display text-2xl font-semibold text-ink"><%= @circuit.name %></h1>
    <% if @circuit.event_organizer %>
      <p class="mt-1 text-[13px] text-muted"><%= t("organizer.circuits.organized_by", name: @circuit.event_organizer.name) %></p>
    <% end %>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to t("organizer.shell.view_public"), circuit_path(@circuit), target: "_blank", rel: "noopener", class: button_classes(:secondary, size: :sm) %>
    <%= link_to t("organizer.tournaments.edit"), edit_organizer_circuit_path(@circuit), class: button_classes(:ghost, size: :sm) %>
  </div>
</div>

<% if @circuit.leagues.any? %>
  <h2 class="col-span-full font-display text-lg font-semibold text-ink"><%= t("organizer.circuits.leagues", count: @circuit.leagues.size) %></h2>
  <div class="col-span-full grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
    <%= render partial: "organizer/leagues/league", collection: @circuit.leagues %>
  </div>
<% end %>
<% if @circuit.tournaments.any? %>
  <h2 class="col-span-full font-display text-lg font-semibold text-ink"><%= t("organizer.circuits.tournaments", count: @circuit.tournaments.size) %></h2>
  <div class="col-span-full grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
    <%= render partial: "organizer/tournaments/tournament_card", collection: @circuit.tournaments, as: :tournament %>
  </div>
<% end %>
<% if @circuit.events.none? %>
  <p class="col-span-full card px-4 py-6 text-center text-[13px] text-muted"><%= t("organizer.circuits.no_events") %></p>
<% end %>

<section class="col-span-full card overflow-clip">
  <h2 class="card-title"><%= t("organizer.circuits.standings") %></h2>
  <% if @circuit.circuit_standings.any? %>
    <table class="ctable">
      <thead>
        <tr>
          <th>#</th>
          <th><%= t("organizer.circuits.player") %></th>
          <th class="r"><%= t("standings.columns.points") %></th>
          <th class="r"><%= t("organizer.circuits.events_column") %></th>
        </tr>
      </thead>
      <tbody>
        <% @circuit.circuit_standings.sort_by { |standing| -standing.points }.each_with_index do |standing, idx| %>
          <tr>
            <td class="text-muted tabular"><%= idx + 1 %></td>
            <td class="font-semibold"><%= standing.player.name %></td>
            <td class="r font-display font-semibold text-accent tabular"><%= number_with_precision(standing.points, precision: 2, strip_insignificant_zeros: true) %></td>
            <td class="r tabular"><%= standing.events_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-4 py-6 text-center text-[12px] text-muted"><%= t("organizer.circuits.no_standings") %></p>
  <% end %>
</section>
