<%= modal_form_for [:organizer, circuit], html: { data: { turbo: false } } do |f| %>
  <% content_for :title do %>
    <% if circuit.persisted? %>
      Edit <%= circuit.name %>
    <% else %>
      New Circuit
    <% end %>
  <% end %>

  <% if circuit.errors.present? %>
    <%= safe_join(circuit.errors.full_messages, tag.br) %>
  <% end %>

  <%= f.text_field_with_label :name, placeholder: "A name for this circuit", required: true %>
  <% if circuit.banner.attached? && circuit.banner.blob.persisted? %>
    <%= image_tag circuit.banner.variant(:card), alt: "", class: "mb-2 h-24 w-full rounded-lg object-cover border border-line" %>
  <% end %>
  <%= f.file_field_with_label :banner, accept: User::AVATAR_TYPES.join(",") %>
  <p class="form-help -mt-3 mb-4"><%= t("organizer.circuits.banner_hint") %></p>

  <% content_for :footer do %>
    <%= f.submit %>
    <%= link_to [:organizer, circuit], class: "ms-3 #{small_button_classes(:ghost)}" do %>
      Cancel
    <% end %>
  <% end %>
<% end %>
