<tr>
  <td><%= infraction.kind.titleize %></td>
  <td><%= infraction.category.titleize %></td>
  <td><%= infraction.penalty.titleize %></td>
  <td><%= infraction&.pod&.round&.display_name || '-' %></td>
  <td><%= infraction&.pod&.number || '-' %></td>
  <td><%= infraction.description %></td>
  <td>
    <%= button_to [:organizer, @event_participant.event, @event_participant, infraction], method: :delete, class: small_button_classes(:danger) do %>
      <%= icon("trash") %>
      Delete
    <% end %>
  </td>
</tr>
