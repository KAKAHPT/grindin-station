<%= modal_form_for [:organizer, @infraction.event, @infraction], html: { data: { turbo: false } } do |f| %>
  <% content_for :title do %>
    Record Infraction for
    <%= @infraction.player.name %>
  <% end %>

  <% if @infraction.errors.present? %>
    <%= safe_join(@infraction.errors.full_messages, tag.br) %>
  <% end %>

  <%= f.hidden_field :pod_id %>
  <%= f.hidden_field :player_id %>

  <p class="form-help mb-2">
    <% if @infraction.pod.present? %>
      This infraction is associated with an issue that occurred in Pod #
      <%= @infraction.pod.number %>
      during
      <%= @infraction.pod.round.display_name %>
      of
      <%= @infraction.event.name %>
      .
    <% else %>
      This infraction is associated with an issue that occurred in
      <%= @infraction.event.name %>
      , but is not associated with a specific Round or Pod.
    <% end %>
  </p>

  <%= f.select_with_label :kind, Infraction.kinds.keys.map { |k| [k.titleize, k] } %>
  <%= f.select_with_label :category, grouped_options_for_select(infraction_categories_grouped_by_kind, @infraction.category) %>
  <%= f.select_with_label :penalty, Infraction.penalties.keys.map { |p| [p.titleize, p] } %>
  <%= f.text_area_with_label :description %>

  <% content_for :footer do %>
    <%= f.submit "Record Infraction" %>
    <%= link_to [:organizer, @infraction.event, :event_participants, { layout: 'application' }], class: "ms-3 #{small_button_classes(:ghost)}" do %>
      Cancel
    <% end %>
  <% end %>
<% end %>
