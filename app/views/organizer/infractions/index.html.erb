<% content_for :title do %>
  Infractions recorded for
  <%= @event_participant.name %>
<% end %>

<% content_for :close do %>
  <%= link_to [:organizer, @event_participant.event, :event_participants, { layout: 'application' }], class: "ms-auto #{icon_button_classes(size: :sm)}" do %>
    <svg
      class="w-3 h-3"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 14 14"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
      />
    </svg>
    <span class="sr-only">Close modal</span>
  <% end %>
<% end %>

<table class="ctable col-span-full -m-4 md:-m-5 text-left rtl:text-right">
  <thead>
    <tr>
      <th scope="col">Kind</th>
      <th scope="col">Category</th>
      <th scope="col">Penalty</th>
      <th scope="col">Round</th>
      <th scope="col">Pod</th>
      <th scope="col">Description</th>
      <th scope="col">
        <span class="sr-only">Actions</span>
      </th>
    </tr>
  </thead>
  <tbody><%= render @infractions %></tbody>
</table>

<% content_for :footer do %>
  <%= link_to [:organizer, @event_participant.event, :event_participants, { layout: 'application' }], class: "ms-3 #{small_button_classes(:ghost)}" do %>
    Close
  <% end %>
<% end %>
