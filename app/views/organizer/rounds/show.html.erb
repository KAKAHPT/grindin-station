<%= content_for :sub_navigation do %>
  <nav class="flex mb-5" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
      <li class="inline-flex items-center">
        <%= link_to root_url, class:"inline-flex items-center text-muted hover:text-ink" do %>
          <svg
            class="w-5 h-5 mr-2.5"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
            ></path>
          </svg>
          Home
        <% end %>
      </li>
      <li>
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-line"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <%= link_to [:organizer, :tournaments], class: 'ml-1 text-muted hover:text-ink md:ml-2' do %>
            Tournaments
          <% end %>
        </div>
      </li>
      <li>
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-line"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <%= link_to [:organizer, @round.event], class: 'ml-1 text-muted hover:text-ink md:ml-2' do %>
            <%= @round.event.name %>
          <% end %>
        </div>
      </li>
      <li>
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-line"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span
            class="ml-1 text-ink md:ml-2"
            aria-current="page"
          >
            Bracket
          </span>
        </div>
      </li>
    </ol>
  </nav>
  <div class="flex flex-col gap-3 lg:flex-row lg:justify-between lg:items-center">
    <ul class="flex flex-wrap items-center gap-y-2 text-sm font-medium text-center text-muted">
      <%= link_to [:organizer, @round.event, :event_participants], data: {turbo_frame: "modal"}, class: "inline-flex items-center px-4 py-2.5 me-2 rounded-xl border border-line bg-surface text-ink hover:border-muted" do %>
        Standings
      <% end %>
      <%= link_to t("rounds.print.pairings_link"), print_organizer_tournament_round_path(@round.event, @round), target: "_blank", rel: "noopener", class: "inline-flex items-center px-4 py-2.5 me-2 rounded-xl border border-line bg-surface text-ink hover:border-muted" %>
      <%= link_to t("rounds.print.slips_link"), slips_organizer_tournament_round_path(@round.event, @round), target: "_blank", rel: "noopener", class: "inline-flex items-center px-4 py-2.5 me-2 rounded-xl border border-line bg-surface text-ink hover:border-muted" %>
      <%= render partial: "round", collection: @round.event.rounds.sort_by(&:number) %>
      <%= render "future_rounds" %>
    </ul>
    <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
      <% if @round.published? %>
        <% if @round.started? %>
          <span
            data-action="click->round-timer#toggleFullscreen"
            class="
              cursor-zoom-in font-display text-2xl font-semibold tabular-nums text-ink
              inline-flex items-center justify-center px-4 min-h-[52px] rounded-xl
              bg-surface border border-line sm:me-2
            "
            data-controller="round-timer"
            data-round-timer-round-time-value="<%= @round.duration %>"
            data-round-timer-started-at-value="<%= @round.started_at.iso8601 %>"
            data-round-timer-finished-at-value="<%= @round.finished_at&.iso8601 %>"
          >
            --:--
          </span>
          <% unless @round.past? %>
            <%= button_to [:organizer, @round.event, @round.becomes(Round)], method: :patch, params: {round: {action: :close}}, form_class: "w-full sm:w-auto", class: button_classes(:primary, "w-full sm:w-auto") do %>
              <%= t("rounds.close") %>
              <%= icon("arrow-right", class: "ms-2") %>
            <% end %>
          <% end %>
        <% else %>
          <%= button_to [:organizer, @round.event, @round.becomes(Round)], params: {round: {action: :start}}, form_class: "w-full sm:w-auto", class: button_classes(:primary, "w-full sm:w-auto") do %>
            <%= icon("play", class: "me-2") %>
            Start
          <% end %>
        <% end %>
        <% if @round.past? && @round.is_a?(SwissRound) && @round.last_swiss_round? && @round.event.swiss? && @round.event.rounds_info[:top] %>
          <%= button_to [:organizer, @round.event], method: :patch, params: { tournament: { state: :single_elimination } }, form_class: "w-full sm:w-auto", class: button_classes(:primary, "w-full sm:w-auto") do %>
            <%= t("rounds.make_cut") %>
            <%= icon("scissors", class: "ms-2") %>
          <% end %>
        <% end %>
      <% else %>
        <%= button_to [:organizer, @round.event, @round.becomes(Round)], params: {round: {action: :publish}}, form_class: "w-full sm:w-auto", class: button_classes(:primary, "w-full sm:w-auto") do %>
          <%= icon("megaphone", class: "me-2") %>
          Publish
        <% end %>
      <% end %>

      <% if !@round.past? %>
        <%= button_to [:organizer, @round.event, @round.becomes(Round)], method: :delete, data: {turbo_confirm: "Are you sure you want to destroy this round?"}, form_class: "w-full sm:w-auto", class: button_classes(:danger, "w-full sm:w-auto") do %>
          <%= icon("radioactive", class: "me-2") %>
          Destroy
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="col-span-full">
  <h1 class="mb-2 font-display text-2xl font-semibold tracking-tight text-ink">
    Pairings
  </h1>

  <div class="py-2">
    <label for="table-search" class="sr-only">Search</label>
    <div class="relative mt-1">
      <%= form_tag [:organizer, @round.event, @round.becomes(Round)], data: { turbo_frame: "player_list" }, method: "get", remote: true do %>
        <div
          class="
            absolute inset-y-0 rtl:inset-r-0 start-0 flex items-center ps-3
            pointer-events-none
          "
        >
          <svg
            class="w-4 h-4 text-muted"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 20 20"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"
            />
          </svg>
        </div>
        <%= text_field_tag :query, params[:query], placeholder: "Search for players", class: "block py-2.5 ps-10 text-sm text-ink border border-line rounded-xl w-full sm:w-80 bg-surface placeholder:text-muted focus:ring-accent focus:border-accent" %>
      <% end %>
    </div>
  </div>
</div>

<div
  class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 content-start col-span-full"
  data-controller="swap"
>
  <%= render @pods %>
  <% if @round.byes.present? %>
    <div
      class="flex flex-col bg-surface border border-line rounded-2xl"
    >
      <div class="flex justify-between items-center">
        <h5 class="px-5 pt-5 pb-3 font-display text-2xl font-semibold tracking-tight text-ink">
          Byes
        </h5>
      </div>
      <ul class="grow flex flex-col divide-y divide-line border-t border-line">
        <% @round.byes.sort_by {|r| -r.event_participant.rank_score }.each do |result| %>
          <li class="px-5 py-3">
            <%= result_badge(result, result.event_participant) %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag "player_list", class: "col-span-full block p-0 bg-surface border border-line rounded-2xl overflow-hidden" do %>
  <div class="relative overflow-x-auto sm:rounded-lg">
    <table
      class="w-full text-sm text-left rtl:text-right text-muted"
    >
      <thead
        class="text-[11px] tracking-wide text-muted uppercase bg-ground"
      >
        <tr>
          <th scope="col" class="px-6 py-3 text-left">Player</th>
          <th scope="col" class="px-6 py-3 text-center">Pod</th>
          <th scope="col" class="px-6 py-3 text-right">Seat</th>
        </tr>
      </thead>
      <tbody>
        <% @users_map.keys.sort_by { |k| @users_map[k][:name] }.each.with_index do |k, i| %>
          <tr
            class="border-b border-line last:border-b-0"
          >
            <td
              scope="row"
              data-tooltip-target="tooltip-pairings-<%= k %>"
              class="px-6 py-4 text-left font-medium text-ink whitespace-nowrap"
            >
              <%= truncate(@users_map[k][:name]) %>
            </td>
            <td class="px-6 py-4 text-center">
              <%= link_to @users_map[k][:pod], "#pod_#{@users_map[k][:pod_id]}", target: "_top", data: { controller: 'scroller'}, class: "text-accent hover:underline" %>
            </td>
            <td class="px-6 py-4 text-right"><%= @users_map[k][:seating] %></td>
            <div
              id="tooltip-pairings-<%= k %>"
              role="tooltip"
              class="
                absolute z-10 invisible inline-block px-3 py-2 text-sm
                font-medium text-ink transition-opacity duration-300
                bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
              "
            >
              <%= @users_map[k][:name] %>
              <br>

              <%= @users_map[k][:tp].obfuscated_key %>
              <div class="tooltip-arrow" data-popper-arrow="true"></div>
            </div>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
