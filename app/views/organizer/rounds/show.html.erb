<% content_for :permanent_modal, "1" %>
<%# Live: pod states arrive on the round stream; a change that moves a pod's staff buttons morph-refreshes the page. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from LiveBroadcasts.round_stream(@round.id) %>
<%= render "organizer/tournaments/shell", tournament: @round.event %>
<%= content_for :sub_navigation do %>
  <ul class="<%= PaletteHelper::SEGMENT_TRACK %> mb-3">
    <%= render partial: "round", collection: @round.event.rounds.sort_by(&:number) %>
    <%= render "future_rounds" %>
  </ul>
  <div class="flex flex-col gap-3 lg:flex-row lg:justify-between lg:items-center">
    <div class="flex flex-wrap items-center gap-2 text-sm font-medium">
      <%= link_to "Standings", play_standings_path(@round.event.slug), target: "_blank", rel: "noopener", class: small_button_classes(:secondary) %>
      <%= link_to t("rounds.print.pairings_link"), print_organizer_tournament_round_path(@round.event, @round), target: "_blank", rel: "noopener", class: small_button_classes(:secondary) %>
      <%= link_to t("rounds.print.slips_link"), slips_organizer_tournament_round_path(@round.event, @round), target: "_blank", rel: "noopener", class: small_button_classes(:secondary) %>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
      <% if @round.published? %>
        <% if @round.started? %>
          <span
            data-action="click->round-timer#toggleFullscreen"
            class="
              cursor-zoom-in font-display text-xl font-semibold tabular text-ink
              inline-flex items-center justify-center px-3 h-9 rounded-md
              bg-surface-raised border border-line shadow-card
            "
            data-controller="round-timer"
            data-round-timer-round-time-value="<%= @round.duration %>"
            data-round-timer-started-at-value="<%= @round.started_at.iso8601 %>"
            data-round-timer-finished-at-value="<%= @round.finished_at&.iso8601 %>"
            data-round-timer-finished-label-value="<%= t("rounds.finished_in", time: "%{time}") %>"
          ><% if @round.finished_at %><%= render "rounds/finished_clock", round: @round %><% else %><%= clock_text(@round.started_at, @round.duration&.to_i) %><% end %></span>
          <% unless @round.past? %>
            <%= button_to [:organizer, @round.event, @round.becomes(Round)], method: :patch, params: {round: {action: :close}}, form_class: "w-full sm:w-auto", class: button_classes(:primary, "w-full sm:w-auto", size: :sm) do %>
              <%= t("rounds.close") %>
              <%= icon("arrow-right", class: "ms-2") %>
            <% end %>
          <% end %>
        <% else %>
          <%= button_to [:organizer, @round.event, @round.becomes(Round)], params: {round: {action: :start}}, form_class: "w-full sm:w-auto", class: button_classes(:primary, "w-full sm:w-auto", size: :sm) do %>
            <%= icon("play", class: "me-2") %>
            Start
          <% end %>
        <% end %>
        <% if @round.past? && @round.is_a?(SwissRound) && @round.last_swiss_round? && @round.event.swiss? && @round.event.rounds_info[:top] %>
          <%= button_to [:organizer, @round.event], method: :patch, params: { tournament: { state: :single_elimination } }, form_class: "w-full sm:w-auto", class: button_classes(:primary, "w-full sm:w-auto", size: :sm) do %>
            <%= t("rounds.make_cut") %>
            <%= icon("scissors", class: "ms-2") %>
          <% end %>
        <% end %>
      <% else %>
        <%= button_to [:organizer, @round.event, @round.becomes(Round)], params: {round: {action: :publish}}, form_class: "w-full sm:w-auto", class: button_classes(:primary, "w-full sm:w-auto", size: :sm) do %>
          <%= icon("megaphone", class: "me-2") %>
          Publish
        <% end %>
      <% end %>

      <% if !@round.past? && @round.number > 1 %>
        <%= button_to [:organizer, @round.event, @round.becomes(Round)], method: :delete, data: {turbo_confirm: t("rounds.undo_confirm")}, form_class: "w-full sm:w-auto", class: button_classes(:danger, "w-full sm:w-auto", size: :sm) do %>
          <%= icon("arrow-counter-clockwise", class: "me-2") %>
          <%= t("rounds.undo") %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="col-span-full">
  <h1 class="mb-1 font-display text-xl font-semibold tracking-tight text-ink">
    Pairings
  </h1>

  <div class="py-2">
    <label for="table-search" class="sr-only">Search</label>
    <div class="relative mt-1">
      <div data-controller="pod-filter">
        <div
          class="
            absolute inset-y-0 rtl:inset-r-0 start-0 flex items-center ps-3
            pointer-events-none
          "
        >
          <svg
            class="w-4 h-4 text-muted"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 20 20"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"
            />
          </svg>
        </div>
        <%= text_field_tag :query, nil, id: "table-search", type: "search", autocomplete: "off", placeholder: "Search for players", data: { action: "input->pod-filter#filter", pod_filter_target: "input" }, class: "block h-10 ps-10 text-sm text-ink border border-line rounded-md w-full sm:w-80 bg-surface placeholder:text-muted focus:ring-accent focus:border-accent" %>
      </div>
    </div>
  </div>
</div>

<div
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-3 content-start col-span-full"
  data-controller="swap"
>
  <%= render @pods %>
  <% if @round.byes.present? %>
    <div
      class="flex flex-col bg-surface border border-line rounded-xl shadow-card overflow-clip"
    >
      <div class="flex justify-between items-center">
        <h5 class="px-4 pt-3 pb-2 font-display text-lg font-semibold tracking-tight text-ink">
          Byes
        </h5>
      </div>
      <ul class="grow flex flex-col divide-y divide-line border-t border-line">
        <% @round.ranked_byes.each do |result| %>
          <li class="px-4 h-8 flex items-center text-[13px]">
            <%= result_badge(result, result.event_participant) %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
