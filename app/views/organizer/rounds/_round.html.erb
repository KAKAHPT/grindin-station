<li>
  <% if @round == round %>
    <span class="<%= segment_classes(true) %> active" aria-current="page">
      <%= round.display_name %>
    </span>
  <% else %>
    <%= link_to [:organizer, round.event, round.becomes(Round)], class: segment_classes(false) do %>
      <%= round.display_name %>
    <% end %>
  <% end %>
</li>
