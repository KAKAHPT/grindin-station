<li class="me-2">
  <% if @round == round %>
    <span
      class="inline-block px-4 py-2.5 rounded-xl text-ground bg-accent font-semibold active"
      aria-current="page"
    >
      <%= round.display_name %>
    </span>
  <% else %>
    <%= link_to [:organizer, round.event, round.becomes(Round)], class: "inline-block px-4 py-2.5 rounded-xl hover:text-ink hover:bg-surface" do %>
      <%= round.display_name %>
    <% end %>
  <% end %>
</li>
