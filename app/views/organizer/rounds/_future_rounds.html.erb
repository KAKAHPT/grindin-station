<% ((@round.event.rounds.size + 1)..@round.event.number_of_swiss_rounds).each do |future_round| %>
  <li>
    <span
      class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-line-strong cursor-not-allowed"
    >
      Round #<%= future_round %>
    </span>
  </li>
<% end %>

<% (([@round.event.number_of_swiss_rounds + 1, @round.event.rounds.size + 1].max)..(@round.event.number_of_swiss_rounds + @round.event.number_of_single_elimination_rounds)).each do |future_elim_round| %>
  <li>
    <span
      class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-line-strong cursor-not-allowed"
    >
      <%= @round.event.single_elimination_round_name(future_elim_round) %>
    </span>
  </li>
<% end %>
