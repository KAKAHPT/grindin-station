<%= content_for :sub_navigation do %>
  <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">
    <%= t("organizer.staff.title", event: @tournament.name) %>
    <%= link_to t("organizer.staff.back"), [:organizer, @tournament], class: "float-right text-sm font-medium text-blue-700 hover:underline dark:text-blue-500" %>
  </h1>
<% end %>

<div class="col-span-full p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
  <ul class="divide-y divide-gray-200 dark:divide-gray-700">
    <li class="flex items-center justify-between py-3">
      <span class="text-gray-900 dark:text-white"><%= @tournament.event_organizer.name %></span>
      <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300"><%= t("organizer.staff.owner") %></span>
    </li>
    <% @staff.each do |staff| %>
      <li class="flex items-center justify-between py-3">
        <span class="text-gray-900 dark:text-white"><%= staff.user.name %> <span class="text-sm text-gray-500 dark:text-gray-400"><%= staff.user.email_address %></span></span>
        <span class="flex items-center gap-3">
          <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300"><%= t("organizer.staff.roles.#{staff.role}") %></span>
          <%= button_to t("organizer.staff.remove"), organizer_tournament_staff_path(@tournament, staff), method: :delete, data: { turbo_confirm: t("organizer.staff.confirm_remove", name: staff.user.name) }, class: "text-sm font-medium text-red-700 hover:underline dark:text-red-500" %>
        </span>
      </li>
    <% end %>
  </ul>
  <% if @staff.empty? %>
    <p class="py-3 text-gray-500 dark:text-gray-400"><%= t("organizer.staff.empty") %></p>
  <% end %>

  <%= form_with scope: :event_staff, url: organizer_tournament_staff_index_path(@tournament), class: "flex flex-wrap items-end gap-3 mt-4" do |f| %>
    <div>
      <%= f.label :email_address, t("organizer.staff.email"), class: "block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= f.email_field :email_address, required: true, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
    </div>
    <div>
      <%= f.label :role, t("organizer.staff.role"), class: "block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= f.select :role, EventStaff::ROLES.map { |role| [t("organizer.staff.roles.#{role}"), role] }, {}, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
    </div>
    <%= f.submit t("organizer.staff.add"), class: "text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700" %>
  <% end %>
</div>
