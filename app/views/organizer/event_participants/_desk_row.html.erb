<% participant = desk_row %>
<% standings = local_assigns.fetch(:standings, false) && !participant.waitlisted? %>
<% stats_id = dom_id(participant, :stats) %>
<tr
  id="<%= dom_id(participant) %>"
  class="h-[34px] text-[12px] odd:bg-white/[0.015] hover:bg-white/[0.04] transition-colors"
>
  <td class="px-2.5 tabular text-muted"><%= order[participant.id] %></td>
  <th
    scope="row"
    data-tooltip-target="tooltip-<%= participant.id %>"
    class="px-2.5 font-semibold whitespace-nowrap <%= participant.playing? ? "text-ink" : "text-muted line-through" %>"
  >
    <%= truncate(participant.name, length: 26) %>
  </th>
  <% columns = participant.standing_columns if standings %>
  <td class="px-2.5 tabular text-right font-display font-semibold <%= participant.playing? ? "text-accent" : "text-muted" %>"><%= standings ? columns[:points] : "–" %></td>
  <td class="px-2.5 tabular text-right"><%= standings ? rate_label(columns[@event.one_v_one? ? :omw : :owr]) : "–" %></td>
  <td class="px-2.5 tabular text-right whitespace-nowrap">
    <%= standings ? "#{participant.number_of_wins}-#{participant.number_of_losses}-#{participant.number_of_draws}" : "–" %>
  </td>
  <td class="px-2.5 whitespace-nowrap"><%= desk_chips(participant, @event) %></td>
  <td class="px-1">
    <button type="button" data-action="row-expander#toggle" aria-controls="<%= stats_id %>" aria-expanded="false"
            title="<%= t("organizer.roster.stats.show") %>"
            class="inline-flex size-6 items-center justify-center rounded-[4px] border border-line-strong text-muted font-display text-sm font-semibold hover:text-ink aria-expanded:text-accent aria-expanded:border-accent">
      <span data-sign aria-hidden="true">+</span><span class="sr-only"><%= t("organizer.roster.stats.show") %></span>
    </button>
  </td>
    <td class="px-2.5">
      <div class="flex justify-end gap-1 whitespace-nowrap">
        <% unless scorekeeper %>
          <%= link_to [:new, :organizer, @event, :infraction, { player_id: participant.player_id }], data: { turbo_frame: "modal" }, title: "Record Infraction", class: icon_button_classes(danger: true, size: :xs) do %>
            <%= icon("gavel") %><span class="sr-only">Record Infraction</span>
          <% end %>

          <% if participant.playing? %>
            <% if participant.waitlisted? && !@event.points_locked? %>
              <%= button_to [:promote, :organizer, @event, participant], method: :patch, title: t("organizer.roster.promote"), class: icon_button_classes(size: :xs) do %>
                <%= icon("arrow-up") %><span class="sr-only"><%= t("organizer.roster.promote") %></span>
              <% end %>
            <% end %>
            <%= button_to [:drop, :organizer, @event, participant], method: :patch, params: { reason: "drop" }, data: { turbo_confirm: t("organizer.roster.confirm_drop", name: participant.name) }, title: t("organizer.roster.drop"), class: icon_button_classes(danger: true, size: :xs) do %>
              <%= icon("user-minus") %><span class="sr-only"><%= t("organizer.roster.drop") %></span>
            <% end %>
            <%= button_to [:drop, :organizer, @event, participant], method: :patch, params: { reason: "no_show" }, data: { turbo_confirm: t("organizer.roster.confirm_no_show", name: participant.name) }, title: t("organizer.roster.no_show"), class: icon_button_classes(danger: true, size: :xs) do %>
              <%= icon("prohibit") %><span class="sr-only"><%= t("organizer.roster.no_show") %></span>
            <% end %>
          <% else %>
            <%= button_to [:organizer, @event, participant], method: :patch, params: { event_participant: { dropped: false } }, data: { turbo_confirm: t("organizer.roster.confirm_undo_drop", name: participant.name) }, title: t("organizer.roster.undo_drop"), class: icon_button_classes(size: :xs) do %>
              <%= icon("user-plus") %><span class="sr-only"><%= t("organizer.roster.undo_drop") %></span>
            <% end %>
          <% end %>
        <% end %>

        <% if participant.checked_in? %>
          <%= button_to [:undo_check_in, :organizer, @event, participant], method: :patch, title: t("organizer.roster.undo_check_in"), class: icon_button_classes(size: :xs) do %>
            <%= icon("arrow-counter-clockwise") %><span class="sr-only"><%= t("organizer.roster.undo_check_in") %></span>
          <% end %>
        <% else %>
          <%= button_to [:check_in, :organizer, @event, participant], method: :patch, title: t("organizer.roster.check_in"), class: icon_button_classes(size: :xs) do %>
            <%= icon("user-check") %><span class="sr-only"><%= t("organizer.roster.check_in") %></span>
          <% end %>
        <% end %>

        <% if participant.paid? %>
          <%= button_to [:mark_unpaid, :organizer, @event, participant], method: :patch, title: t("organizer.roster.mark_unpaid"), class: icon_button_classes(size: :xs) do %>
            <%= icon("x-circle") %><span class="sr-only"><%= t("organizer.roster.mark_unpaid") %></span>
          <% end %>
        <% else %>
          <%= button_to [:mark_paid, :organizer, @event, participant], method: :patch, title: t("organizer.roster.mark_paid"), class: icon_button_classes(size: :xs) do %>
            <%= icon("coins") %><span class="sr-only"><%= t("organizer.roster.mark_paid") %></span>
          <% end %>
        <% end %>
      </div>
    </td>
</tr>
<tr id="<%= stats_id %>" hidden class="h-8 bg-surface-raised text-[12px] text-muted">
  <td class="shadow-[inset_2px_0_0_var(--color-accent)]"></td>
  <td colspan="7" class="px-2.5">
    <% columns ||= participant.standing_columns %>
    <span class="inline-flex flex-wrap items-center gap-x-2 gap-y-1">
      <% if @event.one_v_one? %>
        <span><%= t("organizer.roster.stats.gw") %> <b class="text-ink font-semibold tabular"><%= rate_label(columns[:gw]) %></b></span>
        <span aria-hidden="true">·</span>
        <span><%= t("organizer.roster.stats.ogw") %> <b class="text-ink font-semibold tabular"><%= rate_label(columns[:ogw]) %></b></span>
      <% else %>
        <span><%= t("organizer.roster.stats.beaten") %> <b class="text-ink font-semibold"><%= columns[:beaten] %></b></span>
        <span aria-hidden="true">·</span>
        <span><%= t("organizer.roster.stats.unique") %> <b class="text-ink font-semibold"><%= columns[:unique] %></b></span>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5"><%= t("organizer.roster.stats.seats") %> <%= seat_grid(columns[:seats], seat_five: seat_five) %></span>
      <% end %>
      <span aria-hidden="true">·</span>
      <span><%= t("organizer.roster.stats.check_in") %> <b class="text-ink font-semibold tabular"><%= participant.checked_in_at ? l(participant.checked_in_at, format: "%H:%M") : "–" %></b></span>
      <span aria-hidden="true">·</span>
      <span><%= t("organizer.roster.stats.infractions") %>
        <% if participant.number_of_infractions.positive? %>
          <%= link_to participant.number_of_infractions, [:organizer, participant.event, participant, :infractions], data: { turbo_frame: "modal" }, class: "font-semibold text-danger hover:underline" %>
        <% else %>
          <b class="text-ink font-semibold">0</b>
        <% end %>
      </span>
    </span>
  </td>
</tr>
<div
  id="tooltip-<%= participant.id %>"
  role="tooltip"
  class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-ink bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip transition-opacity duration-300"
>
  <%= participant.name %>
  <br>
  <%= participant.obfuscated_key %>
  <div class="tooltip-arrow" data-popper-arrow="true"></div>
</div>
