<% role = current_user.staff_role_for(@event) %>
<% scorekeeper = role == "scorekeeper" %>
<% read_only = role == "caster" %>
<% content_for :title do %>
  <%= @event.name %>
  Participants
<% end %>

<% content_for :close do %>
  <% if @event.rounds.present? %>
    <%= link_to [:organizer, @event, @event.rounds.max_by(&:number).becomes(Round)], class: "ms-auto #{icon_button_classes}" do %>
      <svg
        class="w-3 h-3"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 14"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
        />
      </svg>
      <span class="sr-only">Close modal</span>
    <% end %>
  <% end %>
<% end %>

<% if @layout_mode == "application" %>
  <%= render "organizer/tournaments/shell", tournament: @event %>
<% end %>

<% if @layout_mode == "application" %>
  <% order = registration_order(@event) %>
  <% filter_link = ->(status) { [:organizer, @event, :event_participants, { layout: "application", status: (status unless params[:status] == status), query: params[:query] }] } %>
  <div class="col-span-full bg-surface border border-line rounded-xl shadow-card overflow-clip" data-controller="row-expander">
    <div class="flex flex-wrap items-center gap-x-[18px] gap-y-2 px-3.5 py-2 border-b border-line text-[12px] text-muted">
      <% [["enrolled", nil], ["checked_in", "bg-accent"], ["unpaid", "bg-warn"], ["no_decklist", "bg-[#a3adb8]"], ["waitlisted", "bg-info"], ["dropped", "bg-danger"]].each do |key, dot| %>
        <% count = { "unpaid" => -> { roster_unpaid_count(@event) },
                     "no_decklist" => -> { roster_no_decklist_count(@event) } }.fetch(key) { -> { @roster_counts[key.to_sym] } }.call %>
        <% label = capture do %>
          <% if dot %><span class="size-[7px] rounded-full <%= dot %>" aria-hidden="true"></span><% end %>
          <b id="roster_count_<%= key %>" class="font-display text-[13px] font-semibold text-ink"><%= count %></b>
          <%= t("organizer.roster.counters.#{key}") %>
        <% end %>
        <% if key.in?(%w[unpaid no_decklist]) %>
          <span class="inline-flex items-center gap-1.5"><%= label %></span>
        <% else %>
          <%= link_to label, filter_link.call(key), "aria-current": (params[:status] == key ? "true" : nil),
                      class: "inline-flex items-center gap-1.5 rounded-[4px] px-1 -mx-1 hover:text-ink aria-[current]:text-ink aria-[current]:bg-surface-raised" %>
        <% end %>
      <% end %>
      <div class="ms-auto flex w-full flex-wrap items-center gap-2 sm:w-auto">
      <div class="relative w-full sm:w-auto">
        <label for="query" class="sr-only">Search</label>
      <%= form_tag [:organizer, @event, :event_participants], data: { turbo_frame: "player_list" }, method: "get", remote: true do %>
        <%= hidden_field_tag :layout, "application" %>
        <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
        <div
          class="
            absolute inset-y-0 rtl:inset-r-0 start-0 flex items-center ps-2.5
            pointer-events-none
          "
        >
          <svg
            class="w-3.5 h-3.5 text-muted"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 20 20"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"
            />
          </svg>
        </div>

        <%= text_field_tag :query, params[:query], placeholder: "Search for players", class: "block h-8 ps-9 text-[12px] text-ink border border-line rounded-md w-full sm:w-64 bg-surface placeholder:text-muted focus:ring-accent focus:border-accent" %>
      <% end %>
      </div>
      <% unless scorekeeper || read_only %>
        <%= link_to [:new, :organizer, @event, :event_participant], data: { turbo_frame: "modal" }, class: button_classes(:primary, size: :xs) do %>
          <%= icon("plus") %>
          <%= t("organizer.roster.add_player") %>
        <% end %>
      <% end %>
      </div>
    </div>
    <% if @event_participants.present? %>
      <% standings = !@event.state.in?(%w[registration_open registration_closed]) %>
      <% seat_five = standings && @event.multiplayer? && seat_five?(@event_participants) %>
      <div class="overflow-x-auto">
        <table class="w-full text-left rtl:text-right text-ink">
          <thead class="sticky top-0 z-10 text-[10.5px] font-semibold tracking-[0.06em] text-muted uppercase bg-surface-raised border-b border-line-strong">
            <tr>
              <th scope="col" class="px-2.5 py-2 whitespace-nowrap">#</th>
              <th scope="col" class="px-2.5 py-2 whitespace-nowrap">Player</th>
              <th scope="col" class="px-2.5 py-2 whitespace-nowrap text-right"><%= t("standings.columns.points") %></th>
              <th scope="col" class="px-2.5 py-2 whitespace-nowrap text-right"><%= t(@event.one_v_one? ? "standings.columns.omw" : "standings.columns.owr") %></th>
              <th scope="col" class="px-2.5 py-2 whitespace-nowrap text-right">W-L-D</th>
              <th scope="col" class="px-2.5 py-2 whitespace-nowrap"><%= t("organizer.roster.column_desk") %></th>
              <th scope="col" class="px-1 py-2"><span class="sr-only"><%= t("organizer.roster.stats.show") %></span></th>
              <th scope="col" class="px-2.5 py-2 text-right"><%= t("organizer.roster.actions") %></th>
            </tr>
          </thead>
          <tbody id="<%= dom_id(@event, :event_participants) %>" class="divide-y divide-line/60">
            <%= render partial: "organizer/event_participants/desk_row", collection: @event_participants.sort_by { |p| order[p.id] }, locals: { order: order, standings: standings, seat_five: seat_five, scorekeeper: scorekeeper, read_only: read_only } %>
          </tbody>
        </table>
      </div>
      <%# Legend for the row action icons (they also carry a title tooltip). %>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5 border-t border-line text-[11px] text-muted" data-roster-legend>
        <span class="font-semibold uppercase tracking-[0.06em]"><%= t("organizer.roster.legend") %></span>
        <% [["gavel", t("organizer.roster.infraction")], ["arrow-up", t("organizer.roster.promote")], ["user-minus", t("organizer.roster.drop")],
            ["prohibit", t("organizer.roster.no_show")], ["user-plus", t("organizer.roster.undo_drop")], ["user-check", t("organizer.roster.check_in")],
            ["arrow-counter-clockwise", t("organizer.roster.undo_check_in")], ["coins", t("organizer.roster.mark_paid")], ["x-circle", t("organizer.roster.mark_unpaid")]].each do |name, label| %>
          <span class="inline-flex items-center gap-1"><%= icon(name) %><%= label %></span>
        <% end %>
      </p>
    <% else %>
      <p class="px-4 py-6 text-center text-[12px] text-muted">No players found</p>
    <% end %>
  </div>
<% else %>
<% if @event_participants.present? %>
  <div class="col-span-full">
  <div class="overflow-x-auto">
  <table class="w-full text-sm text-left rtl:text-right text-ink">
    <% if @layout_mode == "modal" %>
      <caption
        class="
          p-5 font-display text-lg font-semibold text-left rtl:text-right text-ink
          bg-surface
        "
      >
        Tournament Participants
        <p class="mt-1 font-body text-sm font-normal text-muted">
          Here you can find all
          <span
            class="font-bold"
            id="<%= dom_id(@event, :participants_count) %>"
          >
            <%= @event.event_participants_count %>
          </span>
          tournament participants. On the bottom of the table you will find a
          button to export this table for printing / sharing.
        </p>
      </caption>
    <% end %>
    <thead
      class="sticky top-0 z-10 text-[10.5px] tracking-[0.06em] text-muted uppercase bg-surface-raised/95 backdrop-blur border-b border-line-strong"
    >
      <tr>
        <% case @event.state %>
        <% when 'registration_open', 'registration_closed' %>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap">Name</th>
        <% else %>
          <th
            scope="col"
            class="px-2.5 py-3 whitespace-nowrap text-center"
            data-tooltip-target="tooltip-rank"
          >
            Rank
          </th>
          <th scope="col" class="px-1 py-3"><span class="sr-only"><%= t("play.standings.movement") %></span></th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap">Player</th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-points">
            <%= t("standings.columns.points") %>
          </th>
          <% if @event.one_v_one? %>
            <% %w[omw gw ogw].each do |column| %>
              <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-<%= column %>">
                <%= t("standings.columns.#{column}") %>
              </th>
            <% end %>
            <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right"><%= t("standings.columns.win_rate") %></th>
          <% else %>
            <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right"><%= t("standings.columns.win_rate") %></th>
            <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-owr">
              <%= t("standings.columns.owr") %>
            </th>
            <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-beaten">
              <%= t("standings.columns.beaten") %>
            </th>
            <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-unique">
              <%= t("standings.columns.unique") %>
            </th>
            <th scope="col" class="px-2.5 py-3 whitespace-nowrap">
              <%= t("standings.columns.seats") %>
            </th>
          <% end %>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-wld">
            W-L-D
          </th>
          <div
            id="tooltip-rank"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            Player rank is calculated according to the tiebreakers you can see
            in this table:
            <br>
            <%= t(@event.one_v_one? ? "standings.order_tooltip_one_v_one" : "standings.order_tooltip") %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <div
            id="tooltip-points"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            <%= t("standings.help.points", win: @event.points_win, draw: @event.points_draw, loss: @event.points_loss) %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <% if @event.one_v_one? %>
            <% %w[omw gw ogw].each do |column| %>
              <div
                id="tooltip-<%= column %>"
                role="tooltip"
                class="
                  absolute z-10 invisible inline-block px-3 py-2 text-sm
                  font-medium text-ink transition-opacity duration-300
                bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
                "
              >
                <%= t("standings.help.#{column}") %>
                <div class="tooltip-arrow" data-popper-arrow="true"></div>
              </div>
            <% end %>
          <% else %>
            <div
              id="tooltip-owr"
              role="tooltip"
              class="
                absolute z-10 invisible inline-block px-3 py-2 text-sm
                font-medium text-ink transition-opacity duration-300
              bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
              "
            >
              <%= t("standings.help.owr") %>
              <div class="tooltip-arrow" data-popper-arrow="true"></div>
            </div>
            <div
              id="tooltip-beaten"
              role="tooltip"
              class="
                absolute z-10 invisible inline-block px-3 py-2 text-sm
                font-medium text-ink transition-opacity duration-300
              bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
              "
            >
              <%= t("standings.help.beaten") %>
              <div class="tooltip-arrow" data-popper-arrow="true"></div>
            </div>
            <div
              id="tooltip-unique"
              role="tooltip"
              class="
                absolute z-10 invisible inline-block px-3 py-2 text-sm
                font-medium text-ink transition-opacity duration-300
              bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
              "
            >
              <%= t("standings.help.unique") %>
              <div class="tooltip-arrow" data-popper-arrow="true"></div>
            </div>
          <% end %>
          <div
            id="tooltip-wld"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            W-L-D is the tournament track record expressed in:
            <br>
            Wins - Losses - Draws
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
        <% end %>
      </tr>
    </thead>
    <tbody id="<%= dom_id(@event, :event_participants) %>" class="divide-y divide-line/60">
      <% seat_five = !@event.state.in?(%w[registration_open registration_closed]) && @event.multiplayer? && seat_five?(@event_participants) %>
      <%= render partial: "organizer/event_participants/event_participant", collection: @event_participants, locals: { seat_five: seat_five, scorekeeper: scorekeeper } %>
    </tbody>
  </table>
  </div>
  </div>
<% else %>
  No players found
<% end %>

<% end %>

<% content_for :footer do %>
  <%= link_to [:organizer, @event, :event_participants, print: true], class: "ms-3 #{small_button_classes(:secondary)}" do %>
    Print
  <% end %>
  <% if @event.rounds.present? %>
    <%= link_to [:organizer, @event, @event.rounds.max_by(&:number).becomes(Round)], class: "ms-3 #{small_button_classes(:secondary)}" do %>
      Close
    <% end %>
  <% end %>
<% end %>
