<% scorekeeper = current_user.staff_role_for(@event) == "scorekeeper" %>
<% content_for :title do %>
  <%= @event.name %>
  Participants
<% end %>

<% content_for :close do %>
  <% if @event.rounds.present? %>
    <%= link_to [:organizer, @event, @event.rounds.max_by(&:number).becomes(Round)], class: "ms-auto #{icon_button_classes}" do %>
      <svg
        class="w-3 h-3"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 14"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
        />
      </svg>
      <span class="sr-only">Close modal</span>
    <% end %>
  <% end %>
<% end %>

<%= content_for :sub_navigation do %>
  <nav class="flex mb-5" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
      <li class="inline-flex items-center">
        <%= link_to root_url, class:"inline-flex items-center text-muted hover:text-ink" do %>
          <svg
            class="w-5 h-5 mr-2.5"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
            ></path>
          </svg>
          Home
        <% end %>
      </li>
      <li>
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-line"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <%= link_to [:organizer, :tournaments], class: 'ml-1 text-muted hover:text-ink md:ml-2' do %>
            Tournaments
          <% end %>
        </div>
      </li>
      <li>
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-line"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <%= link_to [:organizer, @event], class: 'ml-1 text-muted hover:text-ink md:ml-2' do %>
            <%= @event.name %>
          <% end %>
        </div>
      </li>
      <li>
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-line"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span
            class="ml-1 text-ink md:ml-2"
            aria-current="page"
          >
            Players
          </span>
        </div>
      </li>
    </ol>
  </nav>

  <h1 class="font-display text-xl font-semibold text-ink sm:text-2xl">
    <%= @event.name %>
    Participants (
    <%= @event.event_participants_count %>
    )
    <% unless scorekeeper %>
      <%= link_to [:new, :organizer, @event, :event_participant], data: {turbo_frame: "modal"}, class: button_classes(:primary, "float-right font-body") do %>
        <%= icon("plus", class: "me-2") %>
        Add player
      <% end %>
    <% end %>
  </h1>

  <div class="<%= PaletteHelper::SEGMENT_TRACK %> mt-3">
    <%= link_to t("organizer.roster.all"), [:organizer, @event, :event_participants, { layout: "application", query: params[:query] }], class: segment_classes(params[:status].blank?) %>
    <% Organizer::EventParticipantsController::STATUSES.each do |status| %>
      <%= link_to [:organizer, @event, :event_participants, { layout: "application", status: status, query: params[:query] }], class: segment_classes(params[:status] == status) do %>
        <%= t("organizer.roster.statuses.#{status}") %>
        <span id="roster_count_<%= status %>" class="px-1.5 min-w-5 text-center rounded-md bg-ground/60 text-xs tabular text-muted"><%= @roster_counts[status.to_sym] %></span>
      <% end %>
    <% end %>
  </div>

  <div class="pt-2">
    <label for="table-search" class="sr-only">Search</label>
    <div class="relative mt-1">
      <%= form_tag [:organizer, @event, :event_participants], data: { turbo_frame: "player_list" }, method: "get", remote: true do %>
        <%= hidden_field_tag :layout, "application" %>
        <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
        <div
          class="
            absolute inset-y-0 rtl:inset-r-0 start-0 flex items-center ps-3
            pointer-events-none
          "
        >
          <svg
            class="w-4 h-4 text-muted"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 20 20"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"
            />
          </svg>
        </div>

        <%= text_field_tag :query, params[:query], placeholder: "Search for players", class: "block h-10 ps-10 text-sm text-ink border border-line rounded-md w-full sm:w-80 bg-surface placeholder:text-muted focus:ring-accent focus:border-accent" %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @event_participants.present? %>
  <div class="col-span-full <%= "bg-surface border border-line rounded-2xl shadow-card overflow-clip" if @layout_mode == "application" %>">
  <div class="overflow-x-auto">
  <table class="w-full text-sm text-left rtl:text-right text-ink">
    <% if @layout_mode == "modal" %>
      <caption
        class="
          p-5 font-display text-lg font-semibold text-left rtl:text-right text-ink
          bg-surface
        "
      >
        Tournament Participants
        <p class="mt-1 font-body text-sm font-normal text-muted">
          Here you can find all
          <span
            class="font-bold"
            id="<%= dom_id(@event, :participants_count) %>"
          >
            <%= @event.event_participants_count %>
          </span>
          tournament participants. On the bottom of the table you will find a
          button to export this table for printing / sharing.
        </p>
      </caption>
    <% end %>
    <thead
      class="sticky top-0 z-10 text-[11px] tracking-wide text-muted uppercase bg-surface-raised/95 backdrop-blur border-b border-line-strong"
    >
      <tr>
        <% case @event.state %>
        <% when 'registration_open', 'registration_closed' %>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap">Name</th>
        <% else %>
          <th
            scope="col"
            class="px-2.5 py-3 whitespace-nowrap text-center"
            data-tooltip-target="tooltip-rank"
          >
            Rank
          </th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap">Player</th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-points">
            <%= t("standings.columns.points") %>
          </th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-owr">
            <%= t("standings.columns.owr") %>
          </th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-beaten">
            <%= t("standings.columns.beaten") %>
          </th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-unique">
            <%= t("standings.columns.unique") %>
          </th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap">
            <%= t("standings.columns.seats") %>
          </th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" data-tooltip-target="tooltip-wld">
            W-L-D
          </th>
          <div
            id="tooltip-rank"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            Player rank is calculated according to the tiebreakers you can see
            in this table:
            <br>
            <%= t("standings.order_tooltip") %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <div
            id="tooltip-points"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            <%= t("standings.help.points", win: @event.points_win, draw: @event.points_draw, loss: @event.points_loss) %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <div
            id="tooltip-owr"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            <%= t("standings.help.owr") %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <div
            id="tooltip-beaten"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            <%= t("standings.help.beaten") %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <div
            id="tooltip-unique"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            <%= t("standings.help.unique") %>
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
          <div
            id="tooltip-wld"
            role="tooltip"
            class="
              absolute z-10 invisible inline-block px-3 py-2 text-sm
              font-medium text-ink transition-opacity duration-300
            bg-ground border border-line rounded-lg shadow-sm opacity-0 tooltip
            "
          >
            W-L-D is the tournament track record expressed in:
            <br>
            Wins - Losses - Draws
            <div class="tooltip-arrow" data-popper-arrow="true"></div>
          </div>
        <% end %>
        <% if @layout_mode == "application" %>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap"><%= t("organizer.roster.columns.check_in") %></th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap"><%= t("organizer.roster.columns.paid") %></th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap"><%= t("organizer.roster.columns.waitlist") %></th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap"><%= t("organizer.roster.columns.drop_reason") %></th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right" title="Infractions">
            <%= icon("gavel", class: "text-sm") %><span class="sr-only">Infractions</span>
          </th>
          <th scope="col" class="px-2.5 py-3 whitespace-nowrap text-right">
            <span class="sr-only">Actions</span>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody id="<%= dom_id(@event, :event_participants) %>" class="divide-y divide-line/60">
      <% seat_five = !@event.state.in?(%w[registration_open registration_closed]) && seat_five?(@event_participants) %>
      <%= render partial: "organizer/event_participants/event_participant", collection: @event_participants, locals: { seat_five: seat_five, scorekeeper: scorekeeper } %>
    </tbody>
  </table>
  </div>
  </div>
<% else %>
  No players found
<% end %>

<% content_for :footer do %>
  <%= link_to [:organizer, @event, :event_participants, print: true], class: "ms-3 #{small_button_classes(:secondary)}" do %>
    Print
  <% end %>
  <% if @event.rounds.present? %>
    <%= link_to [:organizer, @event, @event.rounds.max_by(&:number).becomes(Round)], class: "ms-3 #{small_button_classes(:secondary)}" do %>
      Close
    <% end %>
  <% end %>
<% end %>
