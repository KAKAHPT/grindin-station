<%= modal_form_for [:organizer, @event_participant.event, @event_participant], html: { data: { turbo: false } } do |f| %>
  <% content_for :title do %>
    Add Player to
    <%= @event_participant.event.name %>
  <% end %>

  <% if @event_participant.errors.present? %>
    <%= safe_join(@event_participant.errors.full_messages, tag.br) %>
  <% end %>

  <p class="form-help my-2">
    A new account will be created if the Player doesn't have one yet.
  </p>

  <%= f.email_field_with_label :player_email, placeholder: "player@grindin-station.test" %>
  <%= f.text_field_with_label :player_name, placeholder: "John Smith" %>
  <%= f.text_field_with_label :decklist, placeholder: "https://moxfield.com/xyz" %>
  <%= f.check_box_with_label :accepted_terms, label: {text: "Player has read and accepted event rules"} %>

  <% content_for :footer do %>
    <%= f.submit %>
    <%= link_to [:organizer, @event_participant.event], class: "ms-3 #{small_button_classes(:ghost)}" do %>
      Cancel
    <% end %>
  <% end %>
<% end %>
