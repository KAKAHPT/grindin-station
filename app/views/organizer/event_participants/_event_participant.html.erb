<tr
  id="<%= dom_id(event_participant) %>"
  class="<%= event_participant.playing? ? "" : "line-through text-muted" %> h-[34px] text-[12px] odd:bg-white/[0.015] hover:bg-white/[0.04] transition-colors"
>
  <% case @event.state %>
  <% when 'registration_open', 'registration_closed' %>
    <th
      scope="row"
      data-tooltip-target="tooltip-<%= event_participant.id %>"
      class="px-2.5 py-1 font-semibold text-ink whitespace-nowrap"
    >
      <%= truncate(event_participant.name, length: 22) %>
    </th>
  <% else %>
    <th
      scope="row"
      class="px-2.5 py-1 text-center whitespace-nowrap"
    >
      <span class="tabular text-muted"><%= event_participant.rank %></span>
    </th>
    <th
      scope="row"
      data-tooltip-target="tooltip-<%= event_participant.id %>"
      class="px-2.5 py-1 font-semibold text-ink whitespace-nowrap"
    >
      <%= truncate(event_participant.name, length: 22) %>
    </th>
    <% columns = event_participant.standing_columns %>
    <td class="px-2.5 py-1 tabular text-right font-display font-semibold text-accent"><%= columns[:points] %></td>
    <td class="px-2.5 py-1 tabular text-right"><%= win_rate_label(event_participant.win_rate) %></td>
    <td class="px-2.5 py-1 tabular text-right">
      <%= number_to_percentage(columns[:owr] * 100, precision: 1) %>
    </td>
    <td class="px-2.5 py-1 tabular text-right"><%= columns[:beaten] %></td>
    <td class="px-2.5 py-1 tabular text-right"><%= columns[:unique] %></td>
    <td class="px-2.5 py-1 text-nowrap">
      <%= seat_grid(columns[:seats], seat_five: local_assigns.fetch(:seat_five, false)) %>
    </td>
    <td class="px-2.5 py-1 tabular text-right text-nowrap">
      <%= event_participant.number_of_wins -%>
      &nbsp;-&nbsp;
      <%= event_participant.number_of_losses -%>
      &nbsp;-&nbsp;
      <%= event_participant.number_of_draws -%>
    </td>
  <% end %>
  <div
    id="tooltip-<%= event_participant.id %>"
    role="tooltip"
    class="
      absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium
      text-ink transition-opacity duration-300 bg-ground border border-line rounded-lg
    shadow-sm opacity-0 tooltip
    "
  >
    <%= event_participant.name %>
    <br>

    <%= event_participant.obfuscated_key %>
    <div class="tooltip-arrow" data-popper-arrow="true"></div>
  </div>
</tr>
