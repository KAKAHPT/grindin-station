<tr
  id="<%= dom_id(event_participant) %>"
  class="<%= event_participant.playing? ? "" : "line-through text-muted" %> h-12 odd:bg-white/[0.015] hover:bg-white/[0.04] transition-colors"
>
  <% case @event.state %>
  <% when 'registration_open', 'registration_closed' %>
    <th
      scope="row"
      data-tooltip-target="tooltip-<%= event_participant.id %>"
      class="px-2.5 py-2 font-semibold text-ink whitespace-nowrap"
    >
      <%= truncate(event_participant.name, length: 22) %>
    </th>
  <% else %>
    <th
      scope="row"
      class="px-2.5 py-2 text-center whitespace-nowrap"
    >
      <%= standings_rank(event_participant.rank, @event) %>
    </th>
    <th
      scope="row"
      data-tooltip-target="tooltip-<%= event_participant.id %>"
      class="px-2.5 py-2 font-semibold text-ink whitespace-nowrap"
    >
      <%= truncate(event_participant.name, length: 22) %>
    </th>
    <% columns = event_participant.standing_columns %>
    <td class="px-2.5 py-2 tabular text-right font-display font-semibold text-accent"><%= columns[:points] %></td>
    <td class="px-2.5 py-2 tabular text-right">
      <%= number_to_percentage(columns[:owr] * 100, precision: 1) %>
    </td>
    <td class="px-2.5 py-2 tabular text-right"><%= columns[:beaten] %></td>
    <td class="px-2.5 py-2 tabular text-right"><%= columns[:unique] %></td>
    <td class="px-2.5 py-2 text-nowrap">
      <%= seat_pips(columns[:seats], seat_five: local_assigns.fetch(:seat_five, false)) %>
    </td>
    <td class="px-2.5 py-2 tabular text-right text-nowrap">
      <%= event_participant.number_of_wins -%>
      &nbsp;-&nbsp;
      <%= event_participant.number_of_losses -%>
      &nbsp;-&nbsp;
      <%= event_participant.number_of_draws -%>
    </td>
  <% end %>
  <% if @layout_mode == "application" %>
    <td class="px-2.5 py-2 tabular whitespace-nowrap"><%= event_participant.checked_in_at ? l(event_participant.checked_in_at, format: "%H:%M") : "-" %></td>
    <td class="px-2.5 py-2"><%= event_participant.paid? ? icon("check") : "-" %></td>
    <td class="px-2.5 py-2"><%= event_participant.waitlisted? && event_participant.playing? ? event_participant.waitlist_position : "-" %></td>
    <td class="px-2.5 py-2"><%= event_participant.dropped? ? t("organizer.roster.drop_reasons.#{event_participant.drop_reason || 'drop'}") : "-" %></td>
    <td class="px-2.5 py-2 tabular text-right">
      <% if event_participant.number_of_infractions > 0 %>
        <%= link_to event_participant.number_of_infractions, [:organizer, event_participant.event, event_participant, :infractions], data: { turbo_frame: "modal" }, title: "View infractions", class: "inline-flex size-7 items-center justify-center rounded-full bg-danger/15 text-danger font-display text-sm font-semibold hover:bg-danger/25" %>
      <% else %>
        <span class="text-muted">-</span>
      <% end %>
    </td>
    <td class="px-2.5 py-2">
      <div class="flex justify-end gap-1 whitespace-nowrap">
        <% unless scorekeeper %>
          <%= link_to [:new, :organizer, @event, :infraction, { player_id: event_participant.player_id }], data: { turbo_frame: "modal" }, title: "Record Infraction", class: icon_button_classes(danger: true) do %>
            <%= icon("gavel") %><span class="sr-only">Record Infraction</span>
          <% end %>

          <% if event_participant.playing? %>
            <% if event_participant.waitlisted? && !@event.points_locked? %>
              <%= button_to [:promote, :organizer, @event, event_participant], method: :patch, title: t("organizer.roster.promote"), class: icon_button_classes do %>
                <%= icon("arrow-up") %><span class="sr-only"><%= t("organizer.roster.promote") %></span>
              <% end %>
            <% end %>
            <%= button_to [:drop, :organizer, @event, event_participant], method: :patch, params: { reason: "drop" }, data: { turbo_confirm: t("organizer.roster.confirm_drop", name: event_participant.name) }, title: t("organizer.roster.drop"), class: icon_button_classes(danger: true) do %>
              <%= icon("user-minus") %><span class="sr-only"><%= t("organizer.roster.drop") %></span>
            <% end %>
            <%= button_to [:drop, :organizer, @event, event_participant], method: :patch, params: { reason: "no_show" }, data: { turbo_confirm: t("organizer.roster.confirm_no_show", name: event_participant.name) }, title: t("organizer.roster.no_show"), class: icon_button_classes(danger: true) do %>
              <%= icon("prohibit") %><span class="sr-only"><%= t("organizer.roster.no_show") %></span>
            <% end %>
          <% else %>
            <%= button_to [:organizer, @event, event_participant], method: :patch, params: { event_participant: { dropped: false } }, data: { turbo_confirm: t("organizer.roster.confirm_undo_drop", name: event_participant.name) }, title: t("organizer.roster.undo_drop"), class: icon_button_classes do %>
              <%= icon("user-plus") %><span class="sr-only"><%= t("organizer.roster.undo_drop") %></span>
            <% end %>
          <% end %>
        <% end %>

        <% if event_participant.checked_in? %>
          <%= button_to [:undo_check_in, :organizer, @event, event_participant], method: :patch, title: t("organizer.roster.undo_check_in"), class: icon_button_classes do %>
            <%= icon("arrow-counter-clockwise") %><span class="sr-only"><%= t("organizer.roster.undo_check_in") %></span>
          <% end %>
        <% else %>
          <%= button_to [:check_in, :organizer, @event, event_participant], method: :patch, title: t("organizer.roster.check_in"), class: icon_button_classes do %>
            <%= icon("user-check") %><span class="sr-only"><%= t("organizer.roster.check_in") %></span>
          <% end %>
        <% end %>

        <% if event_participant.paid? %>
          <%= button_to [:mark_unpaid, :organizer, @event, event_participant], method: :patch, title: t("organizer.roster.mark_unpaid"), class: icon_button_classes do %>
            <%= icon("x-circle") %><span class="sr-only"><%= t("organizer.roster.mark_unpaid") %></span>
          <% end %>
        <% else %>
          <%= button_to [:mark_paid, :organizer, @event, event_participant], method: :patch, title: t("organizer.roster.mark_paid"), class: icon_button_classes do %>
            <%= icon("coins") %><span class="sr-only"><%= t("organizer.roster.mark_paid") %></span>
          <% end %>
        <% end %>
      </div>
    </td>
  <% end %>
  <div
    id="tooltip-<%= event_participant.id %>"
    role="tooltip"
    class="
      absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium
      text-ink transition-opacity duration-300 bg-ground border border-line rounded-lg
    shadow-sm opacity-0 tooltip
    "
  >
    <%= event_participant.name %>
    <br>

    <%= event_participant.obfuscated_key %>
    <div class="tooltip-arrow" data-popper-arrow="true"></div>
  </div>
</tr>
