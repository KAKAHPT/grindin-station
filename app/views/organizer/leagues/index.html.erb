<div class="col-span-full flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-display text-2xl font-semibold text-ink"><%= t("organizer.leagues.title") %></h1>
  <%= link_to t("organizer.leagues.new"), new_organizer_league_path, class: button_classes(:primary, size: :sm) %>
</div>

<% if @leagues.any? %>
  <div class="col-span-full grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
    <%= render @leagues %>
  </div>
<% else %>
  <p class="col-span-full card px-4 py-8 text-center text-[13px] text-muted"><%= t("organizer.leagues.empty") %></p>
<% end %>
