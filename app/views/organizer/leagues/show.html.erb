<div class="col-span-full flex flex-wrap items-end justify-between gap-3">
  <div class="min-w-0">
    <%= link_to t("organizer.leagues.title"), organizer_leagues_path, class: "text-[12px] font-semibold uppercase tracking-[0.08em] text-accent hover:underline" %>
    <div class="mt-1 flex flex-wrap items-center gap-2">
      <h1 class="font-display text-2xl font-semibold text-ink"><%= @league.name %></h1>
      <% if @league.play_mode.present? %>
        <%= desk_chip(:info) { @league.play_mode_scheduled? ? "Scheduled" : "Pick-up" } %>
      <% end %>
      <% if @league.state.in?(%w[play finals]) %>
        <%= desk_chip(:ok) { @league.state == "finals" ? "Finals" : "Playing" } %>
      <% end %>
    </div>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if @league.pickup_play_mode? && @league.state.in?(%w[play finals]) %>
      <%= link_to create_pickup_pod_organizer_league_path(@league), data: { "turbo-method": :post }, class: button_classes(:primary, size: :xs) do %>
        <%= icon("plus-circle") %>
        Create pick-up pod
      <% end %>
    <% end %>
    <%= link_to t("organizer.shell.view_public"), league_path(@league), target: "_blank", rel: "noopener", class: button_classes(:secondary, size: :sm) %>
    <%= link_to t("organizer.tournaments.edit"), edit_organizer_league_path(@league), class: button_classes(:ghost, size: :sm) %>
  </div>
</div>

<section class="col-span-full card overflow-clip">
  <h2 class="card-title"><%= t("organizer.leagues.details") %></h2>
  <table class="ctable">
    <tbody>
      <tr>
        <td>When</td>
        <td class="r">
          <time data-controller="date" data-date-timestamp-value="<%= @league.start_time.iso8601 %>"></time>
          –
          <time data-controller="date" data-date-timestamp-value="<%= @league.end_time.iso8601 %>"></time>
        </td>
      </tr>
      <% if @league.address.present? %>
        <tr><td>Where</td><td class="r"><%= @league.address.titleize %></td></tr>
      <% end %>
      <tr>
        <td>Participants</td>
        <td class="r tabular">
          <%= @league.event_participants.size %> registered · min <%= @league.minimum_participants || "–" %> · max <%= @league.maximum_participants || "–" %>
        </td>
      </tr>
      <% if @league.wager_percentage.present? %>
        <tr><td>Wager</td><td class="r font-display font-semibold text-accent tabular"><%= @league.wager_percentage %>%</td></tr>
      <% end %>
      <tr>
        <td>Circuit</td>
        <td class="r"><%= @league.circuit ? link_to(@league.circuit.name, circuit_path(@league.circuit), class: "text-accent hover:underline") : "Not assigned to a circuit" %></td>
      </tr>
    </tbody>
  </table>
</section>

<% if @league.prizes.present? %>
  <section class="col-span-full card overflow-clip md:col-span-1">
    <h2 class="card-title">Prizes</h2>
    <div class="markdown px-4 text-[13px] text-muted"><%= marksmithed(@league.prizes) %></div>
  </section>
<% end %>

<% if @league.description.present? %>
  <section class="col-span-full card overflow-clip">
    <h2 class="card-title">Description</h2>
    <div class="markdown px-4 text-[13px] text-muted"><%= marksmithed(@league.description) %></div>
  </section>
<% end %>

<% if @league.state.in?(%w[play finals]) || @league.finished? %>
  <section class="col-span-full card overflow-clip">
    <h2 class="card-title">Quick Standings</h2>
    <% standings = @league.event_participants.playing.order(league_score: :desc).limit(5) %>
    <% if standings.any? %>
      <table class="ctable">
        <thead>
          <tr><th>#</th><th>Player</th><th class="r">Score</th><th class="r">W</th><th class="r">D</th><th class="r">L</th></tr>
        </thead>
        <tbody>
          <% standings.each_with_index do |ep, idx| %>
            <tr>
              <td class="text-muted tabular"><%= idx + 1 %></td>
              <td class="font-semibold"><%= ep.player_name %></td>
              <td class="r font-display font-semibold text-accent tabular"><%= number_to_currency(ep.league_score, precision: 2, delimiter: '.', separator: ',') %></td>
              <td class="r tabular"><%= ep.number_of_wins %></td>
              <td class="r tabular"><%= ep.number_of_draws %></td>
              <td class="r tabular"><%= ep.number_of_losses %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @league.event_participants.playing.count > 5 %>
        <p class="border-t border-line px-4 py-2.5 text-[12px] text-muted">
          Showing top 5 of <%= @league.event_participants.playing.count %> players.
          <%= link_to "View all standings", league_path(@league), class: "text-accent hover:underline" %>
        </p>
      <% end %>
    <% else %>
      <p class="px-4 py-6 text-center text-[12px] text-muted">No standings yet.</p>
    <% end %>
  </section>
<% end %>
