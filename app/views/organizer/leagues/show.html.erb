<% content_for :mosaic, "1" %>
<div class="col-span-full flex flex-wrap items-end justify-between gap-3">
  <div class="min-w-0">
    <%= link_to t("organizer.leagues.title"), organizer_leagues_path, class: "text-[12px] font-semibold uppercase tracking-[0.08em] text-accent hover:underline" %>
    <div class="mt-1 flex flex-wrap items-center gap-2">
      <h1 class="font-display text-2xl font-semibold text-ink"><%= @league.name %></h1>
      <% if @league.play_mode.present? && !@league.play_mode_open_tables? %>
        <%= desk_chip(:info) { @league.play_mode_scheduled? ? "Scheduled" : "Pick-up" } %>
      <% end %>
      <% if @league.state.in?(%w[play finals]) && !@league.play_mode_open_tables? %>
        <%= desk_chip(:ok) { @league.state == "finals" ? "Finals" : "Playing" } %>
      <% end %>
    </div>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if @league.pickup_play_mode? && @league.state.in?(%w[play finals]) %>
      <%= link_to create_pickup_pod_organizer_league_path(@league), data: { "turbo-method": :post }, class: button_classes(:primary, size: :xs) do %>
        <%= icon("plus-circle") %>
        Create pick-up pod
      <% end %>
    <% end %>
    <%= link_to t("organizer.shell.view_public"), league_path(@league), target: "_blank", rel: "noopener", class: button_classes(:secondary, size: :sm) %>
    <%# An open-tables league is edited in its own tab. %>
    <% unless @league.play_mode_open_tables? %>
      <%= link_to t("organizer.tournaments.edit"), edit_organizer_league_path(@league), class: button_classes(:ghost, size: :sm) %>
    <% end %>
  </div>
</div>

<% if @league.play_mode_open_tables? %>
  <%= render "organizer/leagues/desk", league: @league %>
  <div class="col-span-full -mb-4 pt-2"><%= render "shared/tabs", pages: true, tabs: organizer_league_tabs(@league, @tab) %></div>
<% end %>

<%# The open tab's page, joined to its tab. %>
<% if @league.play_mode_open_tables? %><div class="col-span-full tab-page grid gap-4" data-tab-page="<%= @tab %>"><% end %>
<% if @league.play_mode_open_tables? && @tab == "edit" %>
  <section class="card overflow-clip" data-league-edit>
    <%= render "form", league: @league %>
    <div class="flex items-center border-t border-line px-[18px] py-3"><%= content_for(:footer) %></div>
  </section>
<% elsif @league.play_mode_open_tables? && @tab == "tables" %>
  <%= render "organizer/leagues/desk_tables", league: @league %>
<% elsif @league.play_mode_open_tables? && @tab == "players" %>
  <%# Who is in the league, by registration; the organizer can take a player out until the cut, or readmit one. %>
  <% roster = @league.event_participants.sort_by(&:created_at) %>
  <section class="col-span-full card overflow-clip" data-league-roster>
    <h2 class="card-title"><%= t("league_desk.players", count: roster.count(&:enrolled?)) %></h2>
    <% if roster.any? %>
      <ul class="divide-y divide-line text-[13px]">
        <% roster.each do |participant| %>
          <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-2" data-roster-player="<%= participant.id %>">
            <span class="<%= participant.dropped? ? "text-muted line-through" : "text-ink" %>"><%= participant.name %></span>
            <span class="flex items-center gap-3">
              <% if participant.dropped? %>
                <span class="text-[12px] text-muted"><%= t("league_desk.dropped") %></span>
              <% elsif participant.waitlisted? %>
                <span class="text-[12px] text-muted"><%= t("league_desk.waitlisted", position: participant.waitlist_position) %></span>
              <% end %>
              <% if participant.dropped? && !@league.finals? && !@league.finished? %>
                <%= button_to t("league_desk.readmit"), readmit_participant_organizer_league_path(@league, participant_id: participant.id), method: :patch,
                              class: button_classes(:ghost, size: :xs), form: { data: { turbo_confirm: t("league_desk.confirm_readmit", name: participant.name) } } %>
              <% end %>
              <% unless participant.dropped? || @league.finals? || @league.finished? %>
                <%= button_to t("league_desk.drop"), drop_participant_organizer_league_path(@league, participant_id: participant.id), method: :patch,
                              class: button_classes(:ghost, size: :xs), form: { data: { turbo_confirm: t("league_desk.confirm_drop", name: participant.name) } } %>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-4 py-6 text-center text-[12.5px] text-muted"><%= t("league_desk.no_players") %></p>
    <% end %>
  </section>
<% elsif @league.play_mode_open_tables? %>
  <%# The league's settings as the organizer set them, in the viewer's language. %>
  <% label = ->(attribute) { Event.human_attribute_name(attribute) } %>
  <% limit = ->(value) { value.presence || t("league_desk.no_limit") } %>
  <section class="col-span-full card overflow-clip" data-league-details>
    <h2 class="card-title"><%= t("organizer.leagues.details") %></h2>
    <table class="ctable">
      <tbody>
        <tr>
          <td><%= label.(:start_time) %></td>
          <td class="r"><time data-controller="date" data-date-timestamp-value="<%= @league.start_time.iso8601 %>"></time></td>
        </tr>
        <tr>
          <td><%= label.(:end_time) %></td>
          <td class="r"><time data-controller="date" data-date-timestamp-value="<%= @league.end_time.iso8601 %>"></time></td>
        </tr>
        <% if @league.address.present? %>
          <tr><td><%= label.(:address) %></td><td class="r"><%= @league.address %></td></tr>
        <% end %>
        <tr>
          <td><%= t("league_desk.registered") %></td>
          <td class="r tabular" data-detail="registered"><%= @league.event_participants.size %><% if @league.maximum_participants&.to_f&.finite? %> / <%= @league.maximum_participants.to_i %><% end %></td>
        </tr>
        <tr><td><%= label.(:starting_points) %></td><td class="r tabular"><%= @league.starting_points %></td></tr>
        <tr><td><%= label.(:wager_percentage) %></td><td class="r font-display font-semibold text-accent tabular"><%= @league.wager_percentage.to_i %>%</td></tr>
        <tr><td><%= label.(:draw_rule) %></td><td class="r" data-detail="draw_rule"><%= t("league_desk.draw_#{@league.draw_rule}") %></td></tr>
        <tr>
          <td><%= label.(:top_cut_size) %></td>
          <td class="r"><%= @league.top_cut_size.to_i.zero? ? t("league_desk.no_cut") : t("league_desk.top", size: @league.top_cut_size) %></td>
        </tr>
        <tr><td><%= label.(:min_games_for_cut) %></td><td class="r tabular"><%= @league.min_games_for_cut %></td></tr>
        <tr><td><%= label.(:max_games_per_week) %></td><td class="r tabular"><%= limit.(@league.max_games_per_week) %></td></tr>
        <tr><td><%= label.(:max_games_vs_same_opponent) %></td><td class="r tabular"><%= limit.(@league.max_games_vs_same_opponent) %></td></tr>
        <tr><td><%= t("league_desk.clock_minutes") %></td><td class="r tabular"><%= @league.round_minutes %></td></tr>
        <% if Features.on?(:circuits) && @league.circuit %>
          <tr><td><%= label.(:circuit_id) %></td><td class="r"><%= link_to @league.circuit.name, circuit_path(@league.circuit), class: "text-accent hover:underline" %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <% [[:prizes, @league.prizes], [:rules, @league.rules], [:description, @league.description]].each do |attribute, text| %>
    <% next if text.blank? %>
    <section class="col-span-full card overflow-clip">
      <h2 class="card-title"><%= label.(attribute) %></h2>
      <div class="markdown px-4 text-[13px] text-muted"><%= marksmithed(text) %></div>
    </section>
  <% end %>
<% else %>
<section class="col-span-full card overflow-clip">
  <h2 class="card-title"><%= t("organizer.leagues.details") %></h2>
  <table class="ctable">
    <tbody>
      <tr>
        <td>When</td>
        <td class="r">
          <time data-controller="date" data-date-timestamp-value="<%= @league.start_time.iso8601 %>"></time>
          –
          <time data-controller="date" data-date-timestamp-value="<%= @league.end_time.iso8601 %>"></time>
        </td>
      </tr>
      <% if @league.address.present? %>
        <tr><td>Where</td><td class="r"><%= @league.address.titleize %></td></tr>
      <% end %>
      <tr>
        <td>Participants</td>
        <td class="r tabular">
          <%= @league.event_participants.size %> registered · min <%= @league.minimum_participants || "–" %> · max <%= @league.maximum_participants || "–" %>
        </td>
      </tr>
      <% if @league.wager_percentage.present? %>
        <tr><td>Wager</td><td class="r font-display font-semibold text-accent tabular"><%= @league.wager_percentage %>%</td></tr>
      <% end %>
      <tr>
        <td>Circuit</td>
        <td class="r"><%= @league.circuit ? link_to(@league.circuit.name, circuit_path(@league.circuit), class: "text-accent hover:underline") : "Not assigned to a circuit" %></td>
      </tr>
    </tbody>
  </table>
</section>

<% if @league.prizes.present? %>
  <section class="col-span-full card overflow-clip md:col-span-1">
    <h2 class="card-title">Prizes</h2>
    <div class="markdown px-4 text-[13px] text-muted"><%= marksmithed(@league.prizes) %></div>
  </section>
<% end %>

<% if @league.description.present? %>
  <section class="col-span-full card overflow-clip">
    <h2 class="card-title">Description</h2>
    <div class="markdown px-4 text-[13px] text-muted"><%= marksmithed(@league.description) %></div>
  </section>
<% end %>

<% end %>
<% if @league.play_mode_open_tables? %></div><% end %>

<% if (@league.state.in?(%w[play finals]) || @league.finished?) && !@league.play_mode_open_tables? %>
  <section class="col-span-full card overflow-clip">
    <h2 class="card-title">Quick Standings</h2>
    <% standings = @league.event_participants.playing.includes(:results, player: :user).order(league_score: :desc).limit(5) %>
    <% if standings.any? %>
      <table class="ctable">
        <thead>
          <tr><th>#</th><th>Player</th><th class="r">Score</th><th class="r">W</th><th class="r">D</th><th class="r">L</th></tr>
        </thead>
        <tbody>
          <% standings.each_with_index do |ep, idx| %>
            <tr>
              <td class="text-muted tabular"><%= idx + 1 %></td>
              <td class="font-semibold"><%= ep.player_name %></td>
              <td class="r font-display font-semibold text-accent tabular"><%= number_to_currency(ep.league_score, precision: 2, delimiter: '.', separator: ',') %></td>
              <td class="r tabular"><%= ep.number_of_wins %></td>
              <td class="r tabular"><%= ep.number_of_draws %></td>
              <td class="r tabular"><%= ep.number_of_losses %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @league.event_participants.playing.count > 5 %>
        <p class="border-t border-line px-4 py-2.5 text-[12px] text-muted">
          Showing top 5 of <%= @league.event_participants.playing.count %> players.
          <%= link_to "View all standings", league_path(@league), class: "text-accent hover:underline" %>
        </p>
      <% end %>
    <% else %>
      <p class="px-4 py-6 text-center text-[12px] text-muted">No standings yet.</p>
    <% end %>
  </section>
<% end %>
