<% tone = { "play" => :ok, "finals" => :ok, "finished" => :missing, "canceled" => :bad }.fetch(league.state, :info) %>
<%= link_to [:organizer, league], class: "card block px-4 py-3.5 transition-colors hover:border-line-strong" do %>
  <div class="flex items-center justify-between gap-3">
    <h3 class="min-w-0 truncate font-display text-[15px] font-semibold text-ink"><%= league.name %></h3>
    <%= desk_chip(tone) { league.state.humanize } %>
  </div>
  <p class="mt-1.5 text-[12px] text-muted">
    <%= [league.start_time && l(league.start_time, format: "%-d %b %Y"), t("organizer.tournaments.enrolled", count: league.event_participants_count)].compact.join(" · ") %>
  </p>
<% end %>
