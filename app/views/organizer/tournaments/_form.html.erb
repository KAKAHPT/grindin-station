<%# The tournament form (New tournament page and the Settings tab): one card, sections Event / Structure / Results.
    format-fields: the match length shows for 1v1, the pairing mode for multiplayer; untouched points and the top cut options follow the format. %>
<% locked = tournament.points_locked? %>
<%= modal_form_for [:organizer, tournament], html: { class: "p-[18px]", data: { turbo: false, controller: "format-fields", live_preview_target: "form",
                                                          format_fields_points_value: format_points_defaults.to_json,
                                                          format_fields_cut_options_value: Event::FORMATS.index_with { |format| top_cut_options(format) }.to_json } } do |f| %>
  <% if tournament.errors.present? %>
    <div class="mb-4 rounded-md border border-danger/40 bg-danger/[0.07] px-3 py-2 text-[12.5px] text-danger" role="alert">
      <%= safe_join(tournament.errors.full_messages, tag.br) %>
    </div>
  <% end %>

  <h2 class="form-section"><%= t("organizer.settings.event") %></h2>
  <%# One Format select: Commander / cEDH (pods) or a 1v1 game format. Pods or 1v1 is settled at creation; a 1v1
      event can still change its game format until the swiss starts. %>
  <div class="grid grid-cols-1 gap-x-3 sm:grid-cols-2">
    <%= f.select_with_label :game_format, tournament_format_options(tournament), { selected: tournament.game_format },
                            disabled: (tournament.persisted? && tournament.multiplayer?) || locked,
                            data: { format_fields_target: "format", action: "format-fields#change" } %>
    <%= tag.div hidden: !tournament.one_v_one?, data: { format_fields_target: "matchGames" } do %>
      <%= f.select_with_label :match_games, match_games_options, { selected: tournament.match_games }, disabled: locked %>
    <% end %>
  </div>
  <%= f.text_field_with_label :name, placeholder: t("organizer.settings.name_placeholder"), required: true %>
  <div class="grid grid-cols-1 gap-x-3 sm:grid-cols-2">
    <%= f.datetime_local_field_with_label :start_time, required: true %>
    <%= f.datetime_local_field_with_label :end_time, required: true %>
    <%= f.text_field_with_label :address, placeholder: t("organizer.settings.address_placeholder") %>
    <div>
      <%= f.text_field_with_label :country, maxlength: 2, placeholder: "PT", class: "uppercase" %>
      <p class="form-help -mt-3 mb-4"><%= t("organizer.settings.country_help") %></p>
    </div>
    <div class="grid grid-cols-[1fr_88px] gap-x-3">
      <%= f.number_field_with_label :price, placeholder: t("organizer.settings.price_placeholder"), min: 0, step: 0.01 %>
      <%= f.select_with_label :currency, currency_options, selected: tournament.currency %>
    </div>
    <%= f.number_field_with_label :minimum_participants, placeholder: "3" %>
    <%= f.number_field_with_label :maximum_participants, placeholder: t("organizer.settings.no_limit") %>
  </div>
  <%= f.file_field_with_label :cover %>
  <%= f.text_area_with_label :prizes, rows: 3, placeholder: "- 1st: Black Lotus\n- 2nd~4th: Timetwister" %>
  <%= f.text_area_with_label :schedule, rows: 3, placeholder: "- 9:00 Check-in\n- 10:00 First round" %>
  <%= f.text_area_with_label :rules, rows: 4 %>
  <%= f.text_area_with_label :description, rows: 3, placeholder: t("organizer.settings.description_placeholder") %>
  <%= f.check_box_with_label :featured %>
  <p class="form-help -mt-3 mb-4 ms-6"><%= t("organizer.settings.featured_help") %></p>

  <h2 class="form-section"><%= t("organizer.settings.structure") %></h2>
  <% if (suggestion = structure_suggestion(tournament)) %>
    <p class="form-help mb-3"><%= suggestion %></p>
  <% end %>
  <div class="grid grid-cols-1 gap-x-3 sm:grid-cols-2">
    <%= f.number_field_with_label :swiss_rounds_count, min: 1, step: 1, placeholder: t("organizer.structure_use_suggestion"), disabled: locked %>
    <%= f.select_with_label :top_cut_size, top_cut_options(tournament.format), { include_blank: t("organizer.structure_use_suggestion"), selected: tournament.top_cut_size }, disabled: locked, data: { format_fields_target: "topCut" } %>
    <%= f.number_field_with_label :round_minutes, min: 1, step: 1, disabled: locked %>
    <%= f.number_field_with_label :top_cut_round_minutes, min: 1, step: 1, disabled: locked %>
  </div>
  <%= tag.div hidden: tournament.one_v_one?, data: { format_fields_target: "pairing" } do %>
    <%= f.select_with_label :pairing_mode, pairing_mode_options, { selected: tournament.pairing_mode }, disabled: locked %>
    <p class="form-help -mt-3 mb-3">
      <%= safe_join(Event::PAIRING_MODES.map { |mode| "#{t("organizer.pairing_modes.#{mode}")}: #{t("organizer.pairing_help.#{mode}")}" }, tag.br) %>
    </p>
    <%= f.select_with_label :uneven_field, uneven_field_options, { selected: tournament.uneven_field }, disabled: locked %>
    <p class="form-help -mt-3 mb-3">
      <%= safe_join(Event::UNEVEN_FIELDS.map { |mode| "#{t("organizer.uneven_fields.#{mode}")}: #{t("organizer.uneven_help.#{mode}")}" }, tag.br) %>
    </p>
  <% end %>
  <p class="form-help mb-3"><%= t("organizer.points_help") %></p>
  <div class="grid grid-cols-2 gap-x-3 sm:grid-cols-4">
    <% Event::POINT_ATTRIBUTES.each do |attribute| %>
      <%= f.number_field_with_label attribute, min: (attribute == :points_win ? 1 : 0), step: 1, disabled: locked, data: { format_fields_target: "points", attribute: attribute, action: "input->format-fields#touch" } %>
    <% end %>
  </div>
  <p class="form-help mb-3"><%= t("organizer.points_bye_help") %></p>

  <h2 class="form-section"><%= t("organizer.settings.results") %></h2>
  <%= f.check_box_with_label :self_report_enabled %>
  <div class="grid grid-cols-1 gap-x-3 sm:grid-cols-2">
    <%= f.select_with_label :result_confirmation, result_confirmation_options, selected: tournament.result_confirmation %>
    <%= f.number_field_with_label :confirmation_timeout_minutes, min: 1, step: 1 %>
  </div>
  <p class="form-help mb-4"><%= t("organizer.confirmation_help") %></p>
  <%= f.select_with_label :top_cut_timeout_rule, top_cut_timeout_rule_options, selected: tournament.top_cut_timeout_rule %>
  <%= f.check_box_with_label :show_commanders_in_standings %>
  <%= f.check_box_with_label :show_decklists %>

  <h2 class="form-section"><%= t("organizer.settings.registration") %></h2>
  <%= f.check_box_with_label :waitlist_enabled %>
  <%= f.check_box_with_label :decklist_required %>
  <p class="form-help -mt-3 mb-4 ms-6"><%= t("organizer.settings.decklist_help") %></p>
  <%= f.check_box_with_label :self_check_in_enabled %>
  <%= f.number_field_with_label :check_in_opens_hours_before, min: 0, step: 1 %>
  <p class="form-help -mt-3 mb-4"><%= t("organizer.settings.check_in_help") %></p>

  <h2 class="form-section"><%= t("organizer.settings.standings") %></h2>
  <%# Beaten and Unique are pod tiebreakers: 1v1 has none of them. %>
  <%= tag.div hidden: tournament.one_v_one?, data: { format_fields_target: "standingsExtras" } do %>
    <%= f.check_box_with_label :show_beaten_in_standings %>
    <%= f.check_box_with_label :show_unique_in_standings %>
  <% end %>
  <%= f.check_box_with_label :hide_standings_until_finished %>
  <p class="form-help mb-4"><%= t("organizer.settings.standings_help") %></p>

  <div class="mt-2 flex flex-wrap justify-end gap-2 border-t border-line pt-4">
    <%= link_to t("organizer.settings.back"), (tournament.persisted? ? organizer_tournament_path(tournament) : organizer_tournaments_path), class: button_classes(:ghost, size: :sm) %>
    <%= f.submit %>
  </div>
<% end %>
