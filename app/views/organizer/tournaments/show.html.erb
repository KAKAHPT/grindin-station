<%= render "organizer/tournaments/shell", tournament: @tournament %>
<% counters = tournament_counters(@tournament) %>
<% structure = tournament_structure(@tournament) %>
<% yes_no = ->(on) { on ? t("organizer.overview.on") : t("organizer.overview.off") } %>

<div class="col-span-full kpi" data-overview-counters>
  <div class="card"><b class="tabular"><%= counters[:enrolled] %></b><span><%= t("organizer.overview.enrolled", count: counters[:waitlist]) %></span></div>
  <div class="card"><b class="tabular"><%= counters[:checked_in] %></b><span><%= t("organizer.roster.counters.checked_in") %></span></div>
  <div class="card"><b class="tabular"><%= counters[:unpaid] %></b><span><%= t("organizer.roster.counters.unpaid") %></span></div>
  <div class="card"><b class="tabular"><%= counters[:no_decklist] %></b><span><%= t("organizer.overview.without_decklist") %></span></div>
</div>

<div class="col-span-full grid grid-cols-1 gap-3.5 lg:grid-cols-2">
  <section class="card overflow-clip" data-overview-format>
    <h2 class="card-title"><%= t("organizer.overview.format") %></h2>
    <table class="ctable">
      <tbody>
        <% if @tournament.one_v_one? %>
          <tr>
            <td><%= t("organizer.overview.game_format") %></td>
            <td class="r"><%= play_label(@tournament.play) %></td>
          </tr>
        <% end %>
        <tr>
          <td><%= t("organizer.overview.swiss_rounds") %></td>
          <td class="r tabular"><%= t("organizer.overview.swiss_line", count: structure[:swiss], minutes: @tournament.round_minutes) %></td>
        </tr>
        <tr>
          <td><%= t("organizer.overview.top_cut") %></td>
          <td class="r tabular">
            <%= structure[:cut].positive? ? t("organizer.overview.cut_line", size: structure[:cut], minutes: @tournament.top_cut_round_minutes) : t("organizer.no_cut") %>
          </td>
        </tr>
        <% unless @tournament.one_v_one? %>
          <tr>
            <td><%= t("organizer.overview.pairing") %></td>
            <td class="r"><%= t("organizer.pairing_modes.#{@tournament.pairing_mode}") %></td>
          </tr>
          <tr>
            <td><%= t("organizer.overview.uneven_field") %></td>
            <td class="r"><%= uneven_field_name(@tournament) %></td>
          </tr>
        <% end %>
        <tr>
          <td><%= t("organizer.overview.points") %></td>
          <td class="r tabular"><%= tournament_points_line(@tournament) %></td>
        </tr>
        <tr>
          <td><%= t("organizer.overview.self_report") %></td>
          <td class="r">
            <% if @tournament.self_report_enabled %>
              <%= desk_chip(:ok) { t("organizer.overview.self_report_on", confirmation: t("organizer.overview.confirmation.#{@tournament.result_confirmation}")) } %>
            <% else %>
              <%= desk_chip(:missing) { yes_no.(false) } %>
            <% end %>
          </td>
        </tr>
        <tr>
          <td><%= t("organizer.overview.commanders") %></td>
          <td class="r"><%= desk_chip(@tournament.show_commanders_in_standings ? :ok : :missing) { yes_no.(@tournament.show_commanders_in_standings) } %></td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="card overflow-clip" data-overview-lately>
    <h2 class="card-title"><%= t("organizer.overview.lately.title") %></h2>
    <% lately = tournament_lately(@tournament) %>
    <% if lately.any? %>
      <table class="ctable">
        <tbody>
          <% lately.each do |text, time| %>
            <tr>
              <td><%= text %></td>
              <td class="r whitespace-nowrap text-muted"><%= t("organizer.judge_calls.ago", time: time_ago_in_words(time)) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-4 py-6 text-center text-[12px] text-muted"><%= t("organizer.overview.lately.empty") %></p>
    <% end %>
  </section>
</div>

<%# The downloads are for the roles allowed to export (Organizer::ExportsController). %>
<% if %w[organizer scorekeeper].include?(staff_role(@tournament)) %>
  <%= render "organizer/tournaments/export_card", tournament: @tournament %>
<% end %>
