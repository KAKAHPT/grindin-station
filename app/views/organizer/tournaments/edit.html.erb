<%= render "organizer/tournaments/shell", tournament: @tournament %>
<div class="col-span-full grid gap-4 xl:grid-cols-[minmax(0,720px)_minmax(0,1fr)]"
     data-controller="live-preview" data-live-preview-url-value="<%= preview_organizer_tournament_path(@tournament) %>">
<div class="w-full max-w-[720px] space-y-3.5">
  <div class="card" data-settings><%= render "form", tournament: @tournament %></div>

  <% if @tournament.available_states.key?("canceled") %>
    <section class="card border-danger/40 p-[18px]" data-danger-zone>
      <h2 class="form-section text-danger"><%= t("organizer.settings.danger_zone") %></h2>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="form-help max-w-md"><%= t("organizer.settings.cancel_help") %></p>
        <%= button_to t("organizer.settings.cancel_event"), organizer_tournament_path(@tournament), method: :patch,
                      params: { tournament: { state: "canceled" } },
                      data: { turbo_confirm: t("organizer.settings.cancel_confirm") }, class: button_classes(:danger, size: :sm) %>
      </div>
    </section>
  <% end %>
</div>
  <aside class="hidden xl:block sticky top-4 self-start" data-live-preview-pane>
    <div class="mb-2 flex items-baseline justify-between gap-3">
      <h2 class="form-section mb-0"><%= t("organizer.preview.title") %></h2>
      <p class="form-help"><%= t("organizer.preview.help") %></p>
    </div>
    <iframe data-live-preview-target="frame" title="<%= t("organizer.preview.title") %>"
            class="w-full rounded-xl border border-line bg-black" style="height: calc(100vh - 7rem)"></iframe>
  </aside>
</div>
