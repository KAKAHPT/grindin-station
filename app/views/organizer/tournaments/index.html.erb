<div class="col-span-full flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-display text-2xl font-semibold text-ink"><%= t("organizer.tournaments.title") %></h1>
  <div class="flex flex-wrap items-center gap-2.5">
    <span class="seg" data-tournaments-filter>
      <%= link_to t("organizer.tournaments.active"), organizer_tournaments_path, class: ("seg-on" unless @past), "aria-current": ("page" unless @past) %>
      <%= link_to t("organizer.tournaments.past"), organizer_tournaments_path(past: 1), class: ("seg-on" if @past), "aria-current": ("page" if @past) %>
    </span>
    <% if current_user.organizer? %>
      <%= link_to t("organizer.about.title"), edit_organizer_about_path, class: button_classes(:secondary, size: :xs), data: { organizer_about: true } %>
      <%= link_to t("organizer.tournaments.new"), new_organizer_tournament_path, class: button_classes(:primary, size: :xs) %>
    <% end %>
  </div>
</div>

<% if @tournaments.present? %>
  <div class="col-span-full grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
    <%= render partial: "tournament_card", collection: @tournaments, as: :tournament %>
  </div>
<% else %>
  <p class="col-span-full card px-4 py-8 text-center text-[13px] text-muted">
    <%= t(@past ? "organizer.tournaments.empty_past" : "organizer.tournaments.empty") %>
  </p>
<% end %>
