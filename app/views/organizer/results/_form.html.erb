<%= modal_form_for [:organizer, @result.event, @result.round.becomes(Round), @pod, @result], html: { data: { turbo: false } } do |f| %>
  <% content_for :title do %>
    Submit results for Pod
    <%= @pod.number %>
  <% end %>

  <% if @result.errors.present? %>
    <%= safe_join(@result.errors.full_messages, tag.br) %>
  <% end %>

  <% if @warning %>
    <p class="mb-4 rounded-md border border-warn/40 bg-warn/[0.07] p-3 text-[12.5px] text-warn"><%= t("results.later_round_warning") %></p>
    <label class="flex items-center gap-2 mb-4 text-sm">
      <%= check_box_tag :confirm, "1", false %>
      <%= t("results.confirm_correction") %>
    </label>
  <% end %>

  <% case @result.round %>
  <% when SwissRound %>
    <%= f.select_with_label :type, Result::SELECTABLE_SUBTYPES %>
  <% when SingleEliminationRound %>
    <%= f.select_with_label :type, Result::ELIMINATION_SELECTABLE_SUBYTPES %>
  <% end %>

  <%= f.select_with_label :event_participant_id, @pod.event_participants.includes(player: :user).map { |p| [p.name, p.id] }, include_blank: true %>

  <% if @pod.event.one_v_one? %>
    <%= f.select_with_label :games, winner_score_options(@pod.event) + draw_score_options(@pod.event).map { |label, value| ["#{t('rounds.draw')} #{label}", value] },
                            include_blank: true, selected: params.dig(:result, :games) %>
  <% end %>

  <% content_for :footer do %>
    <%= f.submit %>
    <%= link_to [:organizer, @result.event, @result.round.becomes(Round)], class: "ms-3 #{small_button_classes(:ghost)}" do %>
      Cancel
    <% end %>
  <% end %>
<% end %>
