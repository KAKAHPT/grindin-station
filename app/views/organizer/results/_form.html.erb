<%= modal_form_for [:organizer, @result.event, @result.round.becomes(Round), @pod, @result], html: { data: { turbo: false } } do |f| %>
  <% content_for :title do %>
    Submit results for Pod
    <%= @pod.number %>
  <% end %>

  <% if @result.errors.present? %>
    <%= safe_join(@result.errors.full_messages, tag.br) %>
  <% end %>

  <% if @warning %>
    <p class="mb-4 p-3 text-sm text-yellow-800 rounded-lg bg-yellow-50 dark:bg-gray-800 dark:text-yellow-300"><%= t("results.later_round_warning") %></p>
    <label class="flex items-center gap-2 mb-4 text-sm">
      <%= check_box_tag :confirm, "1", false %>
      <%= t("results.confirm_correction") %>
    </label>
  <% end %>

  <% case @result.round %>
  <% when SwissRound %>
    <%= f.select_with_label :type, Result::SELECTABLE_SUBTYPES %>
  <% when SingleEliminationRound %>
    <%= f.select_with_label :type, Result::ELIMINATION_SELECTABLE_SUBYTPES %>
  <% end %>

  <%= f.select_with_label :event_participant_id, @pod.event_participants.includes(player: :user).map { |p| [p.name, p.id] }, include_blank: true %>

  <% content_for :footer do %>
    <%= f.submit %>
    <%= link_to [:organizer, @result.event, @result.round.becomes(Round)], class:"py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700" do %>
      Cancel
    <% end %>
  <% end %>
<% end %>
