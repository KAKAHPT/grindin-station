<% tone = { "open" => :warn, "acknowledged" => :ink, "closed" => :muted } %>
<% table_label = judge_call.pod ? t("organizer.judge_calls.table", number: judge_call.pod.number) : t("organizer.judge_calls.no_table") %>
<tr id="<%= dom_id(judge_call) %>" class="<%= "opacity-70" if judge_call.closed? %>">
  <td class="font-display font-semibold tabular" title="<%= table_label %>">
    <span aria-hidden="true"><%= judge_call.pod&.number || "–" %></span><span class="sr-only"><%= table_label %></span>
  </td>
  <td class="font-semibold"><%= judge_call.participant&.player&.name || t("organizer.judge_calls.no_player") %></td>
  <td><%= judge_call.reason %></td>
  <td class="whitespace-nowrap text-muted"><%= t("organizer.judge_calls.ago", time: time_ago_in_words(judge_call.created_at)) %></td>
  <td><%= status_chip(tone.fetch(judge_call.status)) { t("organizer.judge_calls.statuses.#{judge_call.status}") } %></td>
  <td class="r">
    <span class="inline-flex flex-wrap justify-end gap-2">
      <% if judge_call.open? %>
        <%= button_to t("organizer.judge_calls.acknowledge"), acknowledge_organizer_tournament_judge_call_path(tournament, judge_call), method: :patch, class: button_classes(:secondary, size: :sm) %>
      <% end %>
      <% unless judge_call.closed? %>
        <%= button_to t("organizer.judge_calls.close"), close_organizer_tournament_judge_call_path(tournament, judge_call), method: :patch, class: button_classes(:primary, size: :sm) %>
      <% end %>
    </span>
  </td>
</tr>
