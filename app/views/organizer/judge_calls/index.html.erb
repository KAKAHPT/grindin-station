<%= render "organizer/tournaments/shell", tournament: @tournament %>

<section class="col-span-full card overflow-clip" data-judge-center>
  <h2 class="card-title"><%= t("organizer.judge_calls.active") %></h2>
  <% if @active_calls.any? %>
    <table class="ctable">
      <thead>
        <tr>
          <th><%= t("play.tables.table") %></th>
          <th><%= t("organizer.judge_calls.player") %></th>
          <th><%= t("organizer.judge_calls.reason") %></th>
          <th><%= t("organizer.judge_calls.opened") %></th>
          <th><%= t("organizer.judge_calls.status") %></th>
          <th class="r"><span class="sr-only"><%= t("organizer.judge_calls.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "judge_call", collection: @active_calls, locals: { tournament: @tournament } %>
      </tbody>
    </table>
  <% else %>
    <p class="px-4 py-6 text-center text-[12px] text-muted"><%= t("organizer.judge_calls.empty") %></p>
  <% end %>
</section>

<% if @closed_calls.any? %>
  <details class="col-span-full card overflow-clip">
    <summary class="card-title cursor-pointer text-muted hover:text-ink"><%= t("organizer.judge_calls.closed", count: Organizer::JudgeCallsController::CLOSED_SHOWN) %></summary>
    <table class="ctable text-muted">
      <tbody>
        <%= render partial: "judge_call", collection: @closed_calls, locals: { tournament: @tournament } %>
      </tbody>
    </table>
  </details>
<% end %>

<p class="col-span-full">
  <%= link_to t("organizer.judge_calls.infractions"), organizer_tournament_event_participants_path(@tournament, layout: "application"), class: button_classes(:secondary, size: :sm) %>
</p>
