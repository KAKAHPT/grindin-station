<%# Role-free state of a pod card (chips, report lines, seats with the winner): broadcast live to the round page. %>
<% seats = pod_seats(pod) %>
<% show_results = pod.round.started? && !pod.round.past? && pod.report_status != :completed %>
<%= tag.div id: "pod_#{pod.id}_state", class: "grow flex flex-col" do %>
  <div class="flex items-start justify-between gap-2 px-4 pt-3">
    <div class="flex flex-col gap-1.5 min-w-0 pt-0.5">
      <h5 class="font-display text-lg font-semibold leading-none tracking-tight text-ink">
        <%= t("play.tables.table") %> <%= pod.number %>
      </h5>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5">
        <%= pod_status_chip(pod) %>
        <% if pod.open_judge_call? %>
          <%= status_chip(:warn) { t("rounds.judge_called") } %>
        <% end %>
        <% if pod.extra_time.positive? %>
          <%= status_chip(:ink) { t("rounds.extra_time", minutes: pod.extra_time) } %>
        <% end %>
      </div>
    </div>
    <% if pod.round.started? %>
      <% result_label = pod.finished? ? "Change result" : "Insert result" %>
      <%= link_to [:new, :organizer, pod.event, pod.round.becomes(Round), pod, :result], data: {turbo_frame: "modal"}, title: result_label, class: icon_button_classes(size: :sm) do %>
        <%= icon("hand-deposit") %><span class="sr-only"><%= result_label %></span>
      <% end %>
    <% end %>
  </div>

  <% status_lines = [pod_reported_line(pod),
                      (pod_confirmed_line(pod) if %i[pending review].include?(pod.report_status))].compact %>
  <% if status_lines.any? || pod.report_status == :disputed %>
    <div class="px-4 pt-1 text-[11px] text-muted flex flex-col">
      <% status_lines.each do |line| %>
        <span><%= line %></span>
      <% end %>
      <% if pod.report_status == :disputed %>
        <span class="font-medium text-danger"><%= t("rounds.disputed") %></span>
      <% end %>
    </div>
  <% end %>

  <ol class="mt-2 grow flex flex-col divide-y divide-line/60 border-t border-line">
    <% pod.event_participants.each do |player| %>
      <% won = pod.current_results.find { |r| r.event_participant_id == player.id }.class.in?([Win, Advance]) %>
      <% if show_results %>
        <li
          data-tooltip-placement="left"
          data-tooltip-target="tooltip-pods-<%= player.id %>"
          data-pod-result-target="row"
          data-seat="<%= seats[player.id] %>"
          data-name="<%= player.name %>"
          data-action="click->pod-result#select keydown.enter->pod-result#select"
          role="button"
          tabindex="0"
          aria-pressed="false"
          class="group flex items-center gap-2.5 px-4 h-8 cursor-pointer transition-colors hover:bg-white/[0.04] focus-visible:outline-none focus-visible:bg-white/[0.04] data-selected:bg-accent/[0.08] data-selected:ring-1 data-selected:ring-inset data-selected:ring-accent/40"
        >
      <% else %>
        <li
          data-tooltip-placement="left"
          data-tooltip-target="tooltip-pods-<%= player.id %>"
          class="group flex items-center gap-2.5 px-4 h-8 transition-colors <%= won ? "bg-accent/[0.08]" : "hover:bg-white/[0.03]" %>"
        >
      <% end %>
        <span class="<%= PaletteHelper::SEAT_SQUARE_SM %> <%= won ? "text-accent" : "text-muted" %>"><%= seats[player.id] %></span>
        <span class="flex-1 min-w-0 truncate text-[13px]"><%= result_indicator(pod:, player:) %></span>
        <% unless pod.round.published? %>
          <%= link_to [:swap, :organizer, pod.event, pod.round.becomes(Round), :seatings], data: {action: 'click->swap#selectPlayer', 'swap-player-param' => player.id, 'swap-pod-param' => pod.id, 'turbo-method': 'patch'}, class: "hidden group-hover:inline-flex items-center text-muted border border-line hover:text-ink hover:border-muted rounded-[4px] text-xs px-1 py-0.5" do %>
            <%= icon("swap", class: "me-1") %>
            <span class="text-[0.5rem] leading-[0.5rem]">SWAP</span>
          <% end %>
        <% else %>
          <%= link_to [:new, :organizer, pod.event, pod.round.becomes(Round), pod, :infraction, { player_id: player.player_id }], data: {turbo_frame: "modal"}, class: "hidden group-hover:inline-flex items-center text-danger border border-danger/40 hover:bg-danger/10 rounded-[4px] text-xs px-1 py-0.5" do %>
            <%= icon("gavel", class: "me-1") %>
            <span class="text-[0.5rem] leading-[0.5rem]">PENALTY</span>
          <% end %>
        <% end %>
        <% if show_results %>
          <%= icon("trophy", class: "text-[14px] text-muted group-hover:text-accent group-data-selected:text-accent transition-colors") %>
        <% end %>
      </li>
      <div
        id="tooltip-pods-<%= player.id %>"
        role="tooltip"
        class="
          absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium
          text-ink bg-ground border border-line rounded-lg shadow-sm opacity-0
          tooltip transition-opacity duration-300
        "
      >
        <%= player.name %>
        <br>

        <%= player.obfuscated_key %>
        <div class="tooltip-arrow" data-popper-arrow="true"></div>
      </div>
    <% end %>
  </ol>
<% end %>
