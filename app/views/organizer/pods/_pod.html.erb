<% seats = pod_seats(pod) %>
<% staff_can_act = pod.round.started? && !pod.round.past? && %w[organizer judge].include?(staff_role) %>
<% show_results = pod.round.started? && !pod.round.past? && pod.report_status != :completed %>
<%= tag.div id: "pod_#{pod.id}",
            class: "scroll-mt-20 flex flex-col bg-surface border border-line rounded-2xl shadow-card overflow-clip",
            data: ({ controller: "pod-result", pod_result_template_value: t("rounds.player_wins", name: "%{name}") } if show_results) do %>
  <div class="flex items-start justify-between gap-3 px-5 pt-5">
    <div class="flex flex-col gap-2">
      <h5 class="font-display text-2xl font-semibold tracking-tight text-ink">
        <%= t("play.tables.table") %> <%= pod.number %>
      </h5>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <%= pod_status_chip(pod) %>
        <% if pod.open_judge_call? %>
          <%= status_chip(:warn) { t("rounds.judge_called") } %>
        <% end %>
        <% if pod.extra_time.positive? %>
          <%= status_chip(:ink) { t("rounds.extra_time", minutes: pod.extra_time) } %>
        <% end %>
      </div>
    </div>
    <% if pod.round.started? %>
      <%= link_to [:new, :organizer, pod.event, pod.round.becomes(Round), pod, :result], data: {turbo_frame: "modal"}, class: "shrink-0 #{small_button_classes(:secondary)}" do %>
        <%= icon("hand-deposit", class: "me-1") %>
        <% if pod.finished? %>
          Change
        <% else %>
          Insert
        <% end %>
        result
      <% end %>
    <% end %>
  </div>

  <div class="px-5 pt-2 text-sm text-muted flex flex-col gap-1">
    <% if (reported = pod_reported_line(pod)) %>
      <span><%= reported %></span>
    <% end %>
    <% if %i[pending review].include?(pod.report_status) && (confirmed = pod_confirmed_line(pod)) %>
      <span><%= confirmed %></span>
    <% end %>
    <% if pod.report_status == :disputed %>
      <span class="font-medium text-danger"><%= t("rounds.disputed") %></span>
    <% end %>
  </div>

  <ol class="mt-4 grow flex flex-col divide-y divide-line/60 border-t border-line">
    <% pod.event_participants.each do |player| %>
      <% won = pod.results.find { |r| r.event_participant_id == player.id }.class.in?([Win, Advance]) %>
      <% if show_results %>
        <li
          data-tooltip-placement="left"
          data-tooltip-target="tooltip-pods-<%= player.id %>"
          data-pod-result-target="row"
          data-seat="<%= seats[player.id] %>"
          data-name="<%= player.name %>"
          data-action="click->pod-result#select keydown.enter->pod-result#select"
          role="button"
          tabindex="0"
          aria-pressed="false"
          class="group flex items-center gap-3 px-5 h-12 cursor-pointer transition-colors hover:bg-white/[0.04] focus-visible:outline-none focus-visible:bg-white/[0.04] data-selected:bg-accent/[0.08] data-selected:ring-1 data-selected:ring-inset data-selected:ring-accent/40"
        >
      <% else %>
        <li
          data-tooltip-placement="left"
          data-tooltip-target="tooltip-pods-<%= player.id %>"
          class="group flex items-center gap-3 px-5 h-12 transition-colors <%= won ? "bg-accent/[0.08]" : "hover:bg-white/[0.03]" %>"
        >
      <% end %>
        <span class="<%= PaletteHelper::SEAT_SQUARE %> <%= won ? "text-accent" : "text-muted" %>"><%= seats[player.id] %></span>
        <span class="flex-1 min-w-0 truncate text-[15px]"><%= result_indicator(pod:, player:) %></span>
        <% unless pod.round.published? %>
          <%= link_to [:swap, :organizer, pod.event, pod.round.becomes(Round), :seatings], data: {action: 'click->swap#selectPlayer', 'swap-player-param' => player.id, 'swap-pod-param' => pod.id, 'turbo-method': 'patch'}, class: "hidden group-hover:inline-flex items-center text-muted border border-line hover:text-ink hover:border-muted rounded-full text-sm p-1" do %>
            <%= icon("swap", class: "me-1") %>
            <span class="text-[0.5rem] leading-[0.5rem]">SWAP</span>
          <% end %>
        <% else %>
          <%= link_to [:new, :organizer, pod.event, pod.round.becomes(Round), pod, :infraction, { player_id: player.player_id }], data: {turbo_frame: "modal"}, class: "hidden group-hover:inline-flex items-center text-danger border border-danger/40 hover:bg-danger/10 rounded-full text-sm p-1" do %>
            <%= icon("gavel", class: "me-1") %>
            <span class="text-[0.5rem] leading-[0.5rem]">PENALTY</span>
          <% end %>
        <% end %>
        <% if show_results %>
          <%= icon("trophy", class: "text-lg text-muted group-hover:text-accent group-data-selected:text-accent transition-colors") %>
        <% end %>
      </li>
      <div
        id="tooltip-pods-<%= player.id %>"
        role="tooltip"
        class="
          absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium
          text-ink bg-ground border border-line rounded-lg shadow-sm opacity-0
          tooltip transition-opacity duration-300
        "
      >
        <%= player.name %>
        <br>

        <%= player.obfuscated_key %>
        <div class="tooltip-arrow" data-popper-arrow="true"></div>
      </div>
    <% end %>
  </ol>

  <% if show_results || staff_can_act %>
  <div class="bg-ground/40 border-t border-line p-4 flex flex-col gap-2">
  <% if show_results %>
    <% pod.seatings.each do |seating| %>
      <%= button_to t("rounds.win", seat: seating.order), [:organizer, pod.event, pod.round.becomes(Round), pod, :results], params: { result: { type: "Win", event_participant_id: seating.event_participant_id } }, form: { class: "hidden", data: { pod_result_target: "winForm", seat: seating.order } }, class: button_classes(:secondary, "w-full") %>
    <% end %>
    <div data-pod-result-target="draw">
      <%= button_to t("rounds.draw"), [:organizer, pod.event, pod.round.becomes(Round), pod, :results], params: { result: { type: "Draw" } }, class: button_classes(:secondary, "w-full") %>
    </div>
    <div data-pod-result-target="confirm" class="grid grid-cols-[1fr_auto] gap-2" hidden>
      <button type="button" data-action="pod-result#confirm" class="<%= button_classes(:primary, "w-full min-w-0") %>">
        <%= icon("trophy") %><span data-pod-result-target="confirmLabel" class="truncate"></span>
      </button>
      <button type="button" data-action="pod-result#cancel" class="<%= button_classes(:ghost, "px-4") %>"><%= t("rounds.cancel") %></button>
    </div>
  <% end %>

  <% if staff_can_act %>
    <div class="grid grid-cols-2 gap-2">
      <%= button_to t("rounds.add_extra_time"), [:extra_time, :organizer, pod.event, pod.round.becomes(Round), pod], method: :patch, form_class: "contents", class: button_classes(:secondary, "w-full") %>
      <% if pod.round.is_a?(SingleEliminationRound) && !pod.finished? %>
        <%= button_to t("rounds.time_called"), timeout_organizer_tournament_round_pod_results_path(pod.event, pod.round.becomes(Round), pod), method: :post, data: { turbo_confirm: t("results.timeout_confirm") }, form_class: "contents", class: button_classes(:danger, "w-full") %>
      <% end %>
    </div>
  <% end %>
  </div>
  <% end %>
<% end %>
