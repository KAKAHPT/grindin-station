<% staff_can_act = pod.round.started? && !pod.round.past? && %w[organizer judge].include?(staff_role) %>
<% show_results = pod.round.started? && !pod.round.past? && pod.report_status != :completed %>
<%= tag.div id: "pod_#{pod.id}",
            class: "scroll-mt-20 flex flex-col bg-surface border border-line rounded-xl shadow-card overflow-clip",
            data: ({ controller: "pod-result", pod_result_template_value: t("rounds.player_wins", name: "%{name}") } if show_results) do %>
  <%= render "organizer/pods/state", pod: pod %>

  <% time_called = staff_can_act && pod.round.is_a?(SingleEliminationRound) && !pod.finished? %>
  <% if show_results || staff_can_act %>
  <div class="bg-ground/40 border-t border-line p-2.5">
    <% if show_results %>
      <% pod.seatings.each do |seating| %>
        <%= button_to t("rounds.win", seat: seating.order), [:organizer, pod.event, pod.round.becomes(Round), pod, :results], params: { result: { type: "Win", event_participant_id: seating.event_participant_id } }, form: { class: "hidden", data: { pod_result_target: "winForm", seat: seating.order } }, class: button_classes(:secondary, "w-full", size: :sm) %>
      <% end %>
    <% end %>
    <% draw_allowed = show_results && !pod.round.is_a?(SingleEliminationRound) %>
    <% footer_cols = if !draw_allowed && time_called then "grid-cols-[auto_auto] justify-end"
                     elsif !draw_allowed then "grid-cols-[auto] justify-end"
                     elsif time_called then "grid-cols-[1fr_auto_auto]"
                     elsif staff_can_act then "grid-cols-[1fr_auto]"
                     else "grid-cols-1"
                     end %>
    <%= tag.div class: ["grid gap-2", footer_cols],
                data: { pod_result_target: ("draw" if show_results) } do %>
      <% if draw_allowed %>
        <%= button_to t("rounds.draw"), [:organizer, pod.event, pod.round.becomes(Round), pod, :results], params: { result: { type: "Draw" } }, form_class: "contents", class: button_classes(:secondary, "w-full", size: :sm) %>
      <% end %>
      <% if staff_can_act %>
        <%= button_to t("rounds.add_extra_time"), [:extra_time, :organizer, pod.event, pod.round.becomes(Round), pod], method: :patch, form_class: "contents", class: button_classes(:ghost, nil, size: :sm) %>
      <% end %>
      <% if time_called %>
        <%= button_to t("rounds.time_called"), timeout_organizer_tournament_round_pod_results_path(pod.event, pod.round.becomes(Round), pod), method: :post, data: { turbo_confirm: t("results.timeout_confirm") }, form_class: "contents", class: button_classes(:danger, nil, size: :sm) %>
      <% end %>
    <% end %>
    <% if show_results %>
      <div data-pod-result-target="confirm" class="grid grid-cols-[1fr_auto] gap-2" hidden>
        <button type="button" data-action="pod-result#confirm" class="<%= button_classes(:primary, "w-full min-w-0", size: :sm) %>">
          <%= icon("trophy") %><span data-pod-result-target="confirmLabel" class="truncate"></span>
        </button>
        <button type="button" data-action="pod-result#cancel" class="<%= button_classes(:ghost, nil, size: :sm) %>"><%= t("rounds.cancel") %></button>
      </div>
    <% end %>
  </div>
  <% end %>
<% end %>
