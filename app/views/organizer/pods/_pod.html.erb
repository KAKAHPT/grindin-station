<div
  id="pod_<%= pod.id %>"
  class="
    scroll-mt-20 overflow-clip flex flex-col max-w-sm bg-white border
    border-gray-200 rounded-lg shadow hover:bg-gray-100 dark:bg-gray-800
    dark:border-gray-700 dark:hover:bg-gray-700
  "
>
  <div class="flex justify-between items-center">
    <h5
      class="
        px-6 pt-6 pb-3 mb-2 text-2xl font-bold tracking-tight text-gray-900
        dark:text-white
      "
    >
      Pod <%= pod.number %>
    </h5>
    <% if pod.round.started? %>
      <%= link_to [:new, :organizer, pod.event, pod.round.becomes(Round), pod, :result], data: {turbo_frame: "modal"}, class: "me-6 px-3 py-2 text-sm font-medium text-center inline-flex items-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" do %>
        <%= icon("hand-deposit", class: "me-1") %>
        <% if pod.finished? %>
          Change
        <% else %>
          Insert
        <% end %>
        result
      <% end %>
    <% end %>
  </div>
  <div class="px-6 pb-2 text-sm text-gray-700 dark:text-gray-400 flex flex-col gap-1">
    <div class="flex flex-wrap items-center gap-1">
      <%= pod_status_chip(pod) %>
      <% if pod.open_judge_call? %>
        <%= badge(color: "red") { t("rounds.judge_called") } %>
      <% end %>
      <% if pod.extra_time.positive? %>
        <%= badge(color: "purple") { t("rounds.extra_time", minutes: pod.extra_time) } %>
      <% end %>
      <% if pod.round.started? && !pod.round.past? && %w[organizer judge].include?(staff_role) %>
        <%= button_to t("rounds.add_extra_time"), [:extra_time, :organizer, pod.event, pod.round.becomes(Round), pod], method: :patch, class: "text-xs px-2 py-0.5 rounded border border-purple-700 text-purple-700 hover:bg-purple-700 hover:text-white dark:border-purple-500 dark:text-purple-400" %>
      <% end %>
    </div>
    <% if (reported = pod_reported_line(pod)) %>
      <span><%= reported %></span>
    <% end %>
    <% if %i[pending review].include?(pod.report_status) && (confirmed = pod_confirmed_line(pod)) %>
      <span><%= confirmed %></span>
    <% end %>
    <% if pod.report_status == :disputed %>
      <span class="font-medium text-red-700 dark:text-red-400"><%= t("rounds.disputed") %></span>
    <% end %>
  </div>
  <ol
    class="
      font-normal text-gray-700 dark:text-gray-400 grow flex flex-col
      justify-items-stretch
    "
  >
    <% pod.event_participants.each do |player| %>
      <li
        data-tooltip-placement="left"
        data-tooltip-target="tooltip-pods-<%= player.id %>"
        class="group list-decimal grow list-inside last:rounded-b-lg px-6 py-3"
      >
        <%= result_indicator(pod:, player:) %>
        <% unless pod.round.published? %>
          <%= link_to [:swap, :organizer, pod.event, pod.round.becomes(Round), :seatings], data: {action: 'click->swap#selectPlayer', 'swap-player-param' => player.id, 'swap-pod-param' => pod.id, 'turbo-method': 'patch'}, class: "ms-2 float-end hidden group-hover:inline-flex text-purple-700 border border-purple-700 hover:bg-purple-700 hover:text-white focus:ring-4 focus:outline-none focus:ring-purple-300 font-medium rounded-full text-sm p-1 text-center items-center dark:border-purple-500 dark:text-purple-500 dark:hover:text-white dark:focus:ring-purple-800 dark:hover:bg-purple-500" do %>
            <%= icon("swap", class: "me-1") %>
            <span class="text-[0.5rem] leading-[0.5rem]">SWAP</span>
          <% end %>
        <% else %>
          <%= link_to [:new, :organizer, pod.event, pod.round.becomes(Round), pod, :infraction, { player_id: player.player_id }], data: {turbo_frame: "modal"}, class: "float-end hidden group-hover:inline-flex text-red-700 hover:text-white border border-red-700 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-full text-sm p-1 text-center items-center dark:border-red-500 dark:text-red-500 dark:hover:text-white dark:focus:ring-red-900 dark:hover:bg-red-600" do %>
            <%= icon("gavel", class: "me-1") %>
            <span class="text-[0.5rem] leading-[0.5rem]">PENALTY</span>
          <% end %>
        <% end %>
      </li>
      <div
        id="tooltip-pods-<%= player.id %>"
        role="tooltip"
        class="
          absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium
          text-white transition-opacity duration-300 bg-gray-900 rounded-lg
          shadow-sm opacity-0 tooltip dark:bg-gray-700
        "
      >
        <%= player.name %>
        <br>

        <%= player.obfuscated_key %>
        <div class="tooltip-arrow" data-popper-arrow="true"></div>
      </div>
    <% end %>
  </ol>
  <% if pod.round.started? && !pod.round.past? && pod.report_status != :completed %>
    <div class="px-6 py-3 flex flex-wrap gap-2 border-t border-gray-200 dark:border-gray-700">
      <% pod.seatings.each do |seating| %>
        <%= button_to t("rounds.win", seat: seating.order), [:organizer, pod.event, pod.round.becomes(Round), pod, :results], params: { result: { type: "Win", event_participant_id: seating.event_participant_id } }, class: "text-xs px-2 py-1 rounded border border-green-700 text-green-700 hover:bg-green-700 hover:text-white dark:border-green-500 dark:text-green-400" %>
      <% end %>
      <%= button_to t("rounds.draw"), [:organizer, pod.event, pod.round.becomes(Round), pod, :results], params: { result: { type: "Draw" } }, class: "text-xs px-2 py-1 rounded border border-yellow-600 text-yellow-700 hover:bg-yellow-600 hover:text-white dark:border-yellow-400 dark:text-yellow-300" %>
    </div>
  <% end %>
</div>
