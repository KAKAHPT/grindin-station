<% content_for :title, t("auth.reset_title") %>

<%= form_with url: password_path(params[:token]), method: :put, builder: ModalFormBuilder, id: "password-reset-form", data: { turbo: false } do |f| %>
  <%= f.password_field_with_label :password, required: true, autofocus: true, autocomplete: "new-password",
                                  placeholder: t("auth.placeholders.new_password"), minlength: 8, maxlength: 72,
                                  label: { text: t("accounts.show.new_password") } %>
  <%= f.password_field_with_label :password_confirmation, required: true, autocomplete: "new-password",
                                  placeholder: t("auth.placeholders.repeat_password"), minlength: 8, maxlength: 72,
                                  label: { text: t("accounts.confirm_new_password") } %>
  <%= f.submit t("auth.save_password"), class: button_classes(:primary, "w-full") %>
<% end %>

<div class="auth-foot" data-sign-up-copy>
  <%= t("auth.new_here") %> <%= link_to t("auth.create_account"), new_registration_path, data: modal_nav_data %>
  <div class="mt-1 text-[11.5px]"><%= t("auth.no_oauth_needed") %></div>
</div>
<div class="mt-2 text-center text-xs text-muted">
  <%= link_to t("auth.back_to_sign_in"), new_session_path, data: modal_nav_data, class: "hover:text-ink" %>
</div>
