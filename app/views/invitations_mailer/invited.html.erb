<p><%= t("invitations_mailer.invited.greeting", name: @user.name) %></p>
<p><%= t("invitations_mailer.invited.body", organizer: @event.event_organizer&.name, event: @event.name) %></p>
<% if @event.start_time %><p><%= l(@event.start_time, format: t("play.events.time_format")) %><% if @event.address.present? %> · <%= @event.address %><% end %></p><% end %>
<p><%= link_to t("invitations_mailer.invited.link"), play_event_url(@event.slug) %></p>
<p><%= t("invitations_mailer.invited.account") %></p>
