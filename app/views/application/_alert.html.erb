<div
  id="flash-alert"
  class="fixed bottom-4 right-4 z-50 flex max-w-[calc(100vw-2rem)] items-center gap-3 rounded-md border border-danger/40 bg-surface px-4 py-3 text-danger shadow-raised"
  role="alert"
>
  <span class="size-2 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
  <div class="text-[13px] font-medium text-ink"><%= alert %></div>
  <button type="button" class="<%= icon_button_classes(size: :xs) %> ms-auto" data-dismiss-target="#flash-alert" aria-label="Close">
    <span class="sr-only">Close</span>
    <svg class="size-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
    </svg>
  </button>
</div>
