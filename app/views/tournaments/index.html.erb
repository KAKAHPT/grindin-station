<% url_locale = params[:locale] %>
<%= render "shared/list_header", title: t("lists.tournaments.title"), lead: t("lists.tournaments.lead"), past: @past,
                                 path: ->(filter) { tournaments_path(filter: filter, locale: url_locale) } %>

<%= render "shared/ticket_grid", events: @ongoing, enrolled: @enrolled, heading: t("lists.ongoing") %>
<%= render "shared/ticket_grid", events: @tournaments, enrolled: @enrolled, paginate: @tournaments,
                                 heading: (t("lists.tournaments.title") if @ongoing.any?) %>

<% if @tournaments.none? %>
  <p class="col-span-full card px-4 py-8 text-center text-[13px] text-muted" data-list-empty>
    <%= t(@past ? "lists.empty_past" : "lists.empty_upcoming") %>
  </p>
<% end %>
