<div class="col-span-full mt-6 space-y-1 text-sm text-muted">
  <p><%= t("standings.help.points", win: event.points_win, draw: event.points_draw, loss: event.points_loss) %></p>
  <% if event.one_v_one? %>
    <p><%= t("standings.help.omw") %></p>
    <p><%= t("standings.help.gw") %></p>
    <p><%= t("standings.help.ogw") %></p>
    <p><%= t("standings.help.win_rate") %></p>
  <% else %>
    <p><%= t("standings.help.owr") %></p>
    <p><%= t("standings.help.win_rate") %></p>
    <% if local_assigns[:show_beaten] %><p><%= t("standings.help.beaten") %></p><% end %>
    <% if local_assigns[:show_unique] %><p><%= t("standings.help.unique") %></p><% end %>
  <% end %>
  <p><%= t("standings.help.seed") %></p>
  <p><%= t("standings.help.movement") %></p>
</div>
