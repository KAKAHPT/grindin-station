<% content_for :title, @user.display_name %>
<% content_for :description, t("profiles.description", name: @user.display_name) %>
<% content_for :wide_main, "1" %>
<div data-controller="profile-events" data-action="input->profile-events#search change->profile-events#season click->profile-events#year click->profile-events#toggle">
<section class="card">
  <div class="p-5">
    <div class="flex items-center gap-4">
      <% if @user.avatar.attached? %>
        <%= image_tag url_for(@user.avatar.variant(:thumb)), alt: "", width: 64, height: 64, class: "size-16 shrink-0 rounded-full object-cover border border-line" %>
      <% else %>
        <span data-profile-initials aria-hidden="true"
              class="inline-flex size-16 shrink-0 items-center justify-center rounded-full bg-surface-raised border border-line font-display text-xl font-semibold text-muted"><%= profile_initials(@user) %></span>
      <% end %>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2.5 min-w-0">
          <h1 class="font-display text-xl font-semibold truncate"><%= @user.display_name %></h1>
          <%= profile_team_tag(@user) %>
        </div>
        <p class="text-sm text-muted truncate">@<%= @user.handle %></p>
        <% if @user.country.present? %>
          <p data-profile-country class="text-sm text-muted"><%= country_name(@user.country) %></p>
        <% end %>
      </div>
      <div class="shrink-0" data-profile-follow><%= render "shared/follow_button", user: @user %></div>
    </div>
    <% if @user.bio.present? %>
      <div data-profile-bio class="mt-4 text-sm text-ink/90 space-y-2 break-words"><%= simple_format(@user.bio) %></div>
    <% end %>
  </div>
  <%# The band shows from day one, with zeros and dashes, so a new player sees what will fill in. %>
  <%= render "profiles/summary", summary: @summary %>
</section>

<% if @history.any? %>
  <%= render "profiles/toolbar", rows: @history %>
  <section class="card overflow-hidden">
    <table data-profile-events class="ctable" data-profile-events-target="table">
      <thead>
        <tr>
          <th data-sort="date" aria-sort="descending" class="cursor-pointer text-ink" tabindex="0" data-profile-events-target="header" data-action="click->profile-events#sort keydown->profile-events#sort"><%= t("profiles.columns.date") %></th>
          <th data-sort="name" class="cursor-pointer" tabindex="0" data-profile-events-target="header" data-action="click->profile-events#sort keydown->profile-events#sort"><%= t("profiles.columns.event") %></th>
          <th data-sort="position" class="r cursor-pointer" tabindex="0" data-profile-events-target="header" data-action="click->profile-events#sort keydown->profile-events#sort"><%= t("profiles.columns.result") %></th>
          <th><%= t("profiles.columns.commander") %></th>
          <th class="w-9"><span class="sr-only"><%= t("profiles.details") %></span></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "profiles/event_row", collection: @history, as: :row %>
        <tr data-no-match hidden data-profile-events-target="noMatch"><td colspan="5" class="py-7 text-center text-[13px] text-muted"><%= t("profiles.no_match") %></td></tr>
      </tbody>
    </table>
    <% if @history.size > 6 %>
      <div class="flex justify-center p-2.5 border-t border-line">
        <button type="button" data-more data-profile-events-target="more" data-action="profile-events#more" data-show-all="<%= t("profiles.show_all", count: "%{count}") %>"
                data-show-less="<%= t("profiles.show_less") %>"
                class="<%= button_classes(:secondary, size: :sm) %>"><%= t("profiles.show_all", count: @history.size) %></button>
      </div>
    <% end %>
  </section>
<% else %>
  <%# A profile with no events yet: say what will appear here, and point the owner at the events list. %>
  <div class="mt-6 p-4 card text-sm text-muted" data-profile-empty>
    <p class="text-ink"><%= t("profiles.no_events") %></p>
    <p class="mt-1"><%= t("profiles.no_events_hint") %></p>
    <% if current_user == @user %>
      <p class="mt-3"><%= link_to t("profiles.find_events"), events_path(locale: params[:locale]), class: button_classes(:secondary, size: :sm), data: { find_events: true } %></p>
    <% end %>
  </div>
<% end %>
</div>

<section data-profile-comments class="mt-6 p-4 rounded-2xl border border-dashed border-line text-sm text-muted">
  <h2 class="mb-1 text-[11px] font-semibold uppercase tracking-wide"><%= t("profiles.comments") %></h2>
  <p><%= t("profiles.comments_soon") %></p>
</section>
