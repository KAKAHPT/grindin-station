<%# The profile band: stats strip, achievements box and most played commanders (server totals; the profile
    events controller recomputes them from the visible rows). %>
<% label = "text-[10.5px] font-semibold uppercase tracking-[0.06em] text-muted" %>
<% number = "block font-display text-xl font-bold text-ink tabular leading-tight" %>
<div data-profile-summary class="bg-surface-raised border-t border-line rounded-b-[12px]">
  <div class="pf-stats">
    <% { events: [:events, summary.events], top_cuts: [:top_cuts, summary.top_cuts],
         win_rate: [:win_rate, profile_percent(summary.win_rate)],
         conversion: [:conversion_rate, profile_percent(summary.conversion_rate)] }.each do |stat, (key, value)| %>
      <div>
        <b data-stat="<%= stat %>" class="<%= number %>"><%= value %></b>
        <span class="<%= label %>"><%= t("profiles.stats.#{key}") %></span>
      </div>
    <% end %>
  </div>

  <div class="mx-4 mt-3 grid grid-cols-3 border border-line-strong rounded-[10px] bg-surface">
    <% { wins: [:wins, summary.wins, "M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z M7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3"],
         top4: [:top4, summary.top4, "M12 10a5 5 0 1 0 0 10a5 5 0 1 0 0-10Z m-3.5 .5-3-7.5h4l2.5 5 2.5-5h4l-3 7.5"],
         cuts: [:top_cuts, summary.top_cuts, "M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-4Z m-3 9 2 2 4-4"] }.each do |ach, (key, value, path)| %>
      <div class="flex items-center gap-3 px-4 py-3 min-w-0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true" class="size-7 shrink-0 text-muted max-sm:hidden"><path d="<%= path %>"/></svg>
        <div class="min-w-0">
          <b data-ach="<%= ach %>" class="<%= number %>"><%= value %></b>
          <span class="<%= label %>"><%= t("profiles.achievements.#{key}") %></span>
        </div>
      </div>
    <% end %>
  </div>

  <div class="px-4 pt-3 pb-3.5">
    <h2 class="mb-1.5 <%= label %>"><%= t("profiles.commanders") %></h2>
    <ul data-commanders class="grid grid-cols-1 sm:grid-cols-2 gap-x-[18px] gap-y-1">
      <% summary.commanders.each do |name, count| %>
        <% share = profile_share(count, summary.events) %>
        <li class="grid grid-cols-[1fr_auto] items-center gap-x-2.5 text-[12.5px]">
          <b class="font-display text-xs font-semibold text-ink truncate"><%= name %></b>
          <span class="text-[11.5px] text-muted tabular"><%= count %> · <%= profile_percent(share) %></span>
          <span class="col-span-full h-[3px] rounded-sm bg-line" aria-hidden="true"><i class="block h-full rounded-sm bg-muted" style="width: <%= share %>%"></i></span>
        </li>
      <% end %>
      <% if summary.commanders.empty? %>
        <li class="text-[11.5px] text-muted">–</li>
      <% end %>
    </ul>
  </div>
</div>
