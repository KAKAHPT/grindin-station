<%= render "admin/nav", active: :accounts %>

<section class="col-span-full card overflow-clip" data-admin-accounts>
  <h2 class="card-title"><%= t("admin.accounts.title") %> <span class="text-muted tabular" data-accounts-total><%= @total %></span></h2>
  <%= form_with url: admin_accounts_path, method: :get, class: "flex flex-wrap items-end gap-2 border-b border-line px-3.5 py-3" do |f| %>
    <label class="field w-full sm:w-72">
      <%= t("admin.accounts.search") %>
      <%= f.search_field :q, value: @q, class: "field-input" %>
    </label>
    <%= f.submit t("admin.events.filter"), name: nil, class: button_classes(:primary, size: :sm) %>
    <%= link_to t("admin.events.clear"), admin_accounts_path, class: button_classes(:ghost, size: :sm) %>
  <% end %>
  <div class="overflow-x-auto">
    <table class="ctable">
      <thead>
        <tr>
          <th><%= t("admin.accounts.name") %></th>
          <th><%= t("admin.accounts.email") %></th>
          <th><%= t("admin.accounts.role") %></th>
          <th><%= t("admin.accounts.confirmed") %></th>
          <th class="r"><%= t("admin.accounts.registered") %></th>
          <th class="r"><span class="sr-only"><%= t("admin.accounts.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @accounts.each do |account| %>
          <% roles = [(t("admin.accounts.roles.admin") if account.admin?), (t("admin.accounts.roles.organizer") if account.event_organizer)].compact %>
          <tr data-account="<%= account.id %>">
            <%# The name keeps one line and sets the column's width; a very long one is cut with "…" (full name on hover). %>
            <td class="font-semibold">
              <div class="flex items-center gap-1.5 whitespace-nowrap">
                <% if account.anonymized? %>
                  <span class="text-muted"><%= t("admin.accounts.deleted") %></span>
                <% elsif account.handle.present? %>
                  <%= link_to account.name, profile_path(account.handle), class: "block max-w-56 truncate hover:text-accent", title: account.name, data: { account_name: true } %>
                <% else %>
                  <span class="block max-w-56 truncate" title="<%= account.name %>" data-account-name><%= account.name %></span>
                <% end %>
                <% if account.blocked? %><span data-blocked><%= desk_chip(:bad) { t("admin.accounts.blocked_chip") } %></span><% end %>
              </div>
              <% if account.handle.present? && !account.anonymized? %>
                <div class="max-w-56 truncate text-[12px] font-normal text-muted">@<%= account.handle %></div>
              <% end %>
            </td>
            <td class="whitespace-nowrap text-muted"><%= account.email_address %></td>
            <td class="whitespace-nowrap"><%= roles.presence&.join(", ") || t("admin.accounts.roles.player") %></td>
            <td data-confirmed="<%= account.confirmed? %>"><%= account.confirmed? ? t("admin.accounts.yes") : t("admin.accounts.no") %></td>
            <td class="r whitespace-nowrap text-muted tabular"><%= l(account.created_at.to_date) %></td>
            <td class="r">
              <%# Admins and deleted accounts have no block or delete here. %>
              <% back = { q: @q, page: params[:page] }.compact %>
              <div class="flex justify-end gap-1.5">
                <% unless account.confirmed? || account.anonymized? %>
                  <%= button_to t("admin.accounts.resend"), resend_confirmation_admin_account_path(account, **back), class: button_classes(:ghost, size: :sm) %>
                <% end %>
                <% unless account.admin? || account.anonymized? %>
                  <% if account.blocked? %>
                    <%= button_to t("admin.accounts.unblock"), unblock_admin_account_path(account, **back), method: :patch, class: button_classes(:ghost, size: :sm) %>
                  <% else %>
                    <%= button_to t("admin.accounts.block"), block_admin_account_path(account, **back), method: :patch, class: button_classes(:ghost, size: :sm), form: { data: { turbo_confirm: t("admin.accounts.block_confirm", email: account.email_address) } } %>
                  <% end %>
                  <%= button_to t("admin.accounts.delete"), admin_account_path(account, **back), method: :delete, class: button_classes(:danger, size: :sm), form: { data: { turbo_confirm: t("admin.accounts.delete_confirm", email: account.email_address) } } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
<div class="col-span-full"><%= paginate @accounts %></div>
