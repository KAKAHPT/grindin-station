<%# Top bar of every page layout (application, play, public). Phones keep the mark, the viewer and the
    bell in the bar; the nav links, language switch (EN / PT / ES) and account links fold under the hamburger (Stimulus menu).
    Local modal_sign_in: true opens Sign in in the modal frame (only the application layout has one). %>
<% here = ->(path) { request.path == path || request.path.start_with?("#{path}/") } %>
<% links = [[t("topbar.events"), events_path(locale: params[:locale]), here.(events_path)],
            [t("topbar.rankings"), rankings_path(locale: params[:locale]), here.(rankings_path)],
            [t("topbar.circuits"), circuits_path(locale: params[:locale]), here.(circuits_path)],
            [t("topbar.organizers"), organizers_path(locale: params[:locale]), here.(organizers_path) || request.path.start_with?("/o/")],
            [t("topbar.feed"), feed_path(locale: params[:locale]), here.(feed_path)]] %>
<header class="topbar" data-controller="menu" data-topbar>
  <div class="topbar-in">
    <%= link_to root_path(locale: params[:locale]), class: "topbar-brand" do %>
      <%= render "shared/mark", size: 30, rotating: true, id_suffix: "topbar" %>
      <span class="sr-only"><%= t("app.name") %></span>
    <% end %>

    <div id="topbar-panel" class="topbar-panel" data-menu-target="panel" data-open="false">
      <nav class="topbar-links" aria-label="<%= t("app.name") %>">
        <% links.each do |label, path, on| %>
          <%= link_to label, path, class: ("on" if on), "aria-current": ("page" if on) %>
        <% end %>
      </nav>
      <span class="topbar-sp"></span>
      <span class="lang" title="<%= t("topbar.language") %>" data-lang-switch>
        <%# Each code posts to LocalesController#update, which stores the locale cookie and comes back to this page. %>
        <% I18n.available_locales.each do |code| %>
          <% on = code == I18n.locale %>
          <%= button_to code.to_s.upcase, locale_path, params: { locale: code }, form_class: "contents",
                        class: ("on" if on), lang: code, data: { locale: code }, "aria-pressed": on.to_s %>
        <% end %>
      </span>
      <% if authenticated? %>
        <% if current_user.staff? %>
          <%= link_to organizer_path_builder, class: ["topbar-chip", ("on" if organizer_mode?)], data: { organizer_mode: true } do %>
            <i aria-hidden="true"></i><%= t("topbar.organizer_mode") %>
          <% end %>
        <% end %>
        <% if current_user.admin? %>
          <%= link_to admin_root_path, class: ["topbar-chip", ("on" if admin_mode?)], data: { admin_mode: true } do %>
            <i aria-hidden="true"></i><%= t("topbar.admin") %>
          <% end %>
        <% end %>
        <%= link_to t("accounts.nav"), account_path(locale: params[:locale]), class: "topbar-link" %>
        <%= link_to t("topbar.logout"), session_path(Current.session), data: { turbo_method: :delete }, class: "topbar-link" %>
      <% end %>
    </div>

    <div class="topbar-end">
      <% if authenticated? %>
        <%# A rejected handle edit (account form re-rendered) must not build a profile link from the unsaved handle. %>
        <span data-play-player class="topbar-user"><%= current_user.handle_changed? ? current_user.display_name : profile_link(current_user) %></span>
        <%= render "notifications/bell" %>
      <% else %>
        <%= link_to t("topbar.sign_in"), new_session_path(locale: params[:locale]),
                    data: ({ turbo_frame: "modal" } if local_assigns[:modal_sign_in]),
                    class: small_button_classes(:secondary) %>
      <% end %>
      <button type="button" class="topbar-burger" data-menu-target="button" data-action="menu#toggle"
              aria-controls="topbar-panel" aria-expanded="false">
        <span class="sr-only"><%= t("topbar.menu") %></span>
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
