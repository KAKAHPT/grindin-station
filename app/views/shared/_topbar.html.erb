<%# Top bar of every page layout (application, play, public). The viewer is their picture alone. Phones keep the mark, that picture and the
    bell in the bar; the nav links and the language switch (EN / PT / ES) fold under the hamburger (Stimulus menu).
    Local modal_sign_in: true opens Sign in in the modal frame (only the application layout has one). %>
<% here = ->(path) { request.path == path || request.path.start_with?("#{path}/") } %>
<%# A paused module (config/features.yml) has no link. %>
<% links = [[t("topbar.events"), events_path(locale: params[:locale]), here.(events_path)],
            ([t("topbar.my_events"), my_events_path(locale: params[:locale]), here.(my_events_path)] if authenticated?),
            ([t("topbar.rankings"), rankings_path(locale: params[:locale]), here.(rankings_path)] if Features.on?(:rankings)),
            ([t("topbar.circuits"), circuits_path(locale: params[:locale]), here.(circuits_path)] if Features.on?(:circuits)),
            ([t("topbar.organizers"), organizers_path(locale: params[:locale]), here.(organizers_path) || request.path.start_with?("/o/")] if Features.on?(:organizers)),
            ([t("topbar.feed"), feed_path(locale: params[:locale]), here.(feed_path)] if Features.on?(:feed))].compact %>
<header class="topbar" data-controller="menu" data-topbar>
  <div class="topbar-in">
    <%= link_to root_path(locale: params[:locale]), class: "topbar-brand" do %>
      <%= render "shared/mark", size: 30, rotating: true, id_suffix: "topbar" %>
      <span data-brand-name><%= t("app.name") %></span>
    <% end %>

    <div id="topbar-panel" class="topbar-panel" data-menu-target="panel" data-open="false">
      <nav class="topbar-links" aria-label="<%= t("app.name") %>">
        <% links.each do |label, path, on| %>
          <%= link_to label, path, class: ("on" if on), "aria-current": ("page" if on) %>
        <% end %>
      </nav>
      <span class="topbar-sp"></span>
      <span class="lang" title="<%= t("topbar.language") %>" data-lang-switch>
        <%# Each code posts to LocalesController#update, which stores the locale cookie and comes back to this page. %>
        <% I18n.available_locales.each do |code| %>
          <% on = code == I18n.locale %>
          <%= button_to code.to_s.upcase, locale_path, params: { locale: code }, form_class: "contents",
                        class: ("on" if on), lang: code, data: { locale: code }, "aria-pressed": on.to_s %>
        <% end %>
      </span>
    </div>

    <div class="topbar-end">
      <% if authenticated? %>
        <%# The viewer: their picture alone (or initials), no name beside it; hovering or tapping it opens their
            menu: profile, events, account, log out and, under a rule, Organizer mode and Admin. %>
        <% unsaved = current_user.handle_changed? %>
        <% profile = current_user.handle.present? && !unsaved && current_user.profile_visible_to?(nil) %>
        <div class="topbar-me" data-user-menu>
          <span class="topbar-me-trigger" tabindex="0" data-play-player title="<%= current_user.display_name %>">
            <span class="sr-only"><%= current_user.display_name %></span>
            <%# A picture just refused by the account form is not stored: it has nothing to show. %>
            <% if current_user.avatar.attached? && current_user.avatar.blob.persisted? && !current_user.attachment_changes.key?("avatar") %>
              <%= image_tag url_for(current_user.avatar.variant(:thumb)), alt: "", width: 28, height: 28, class: "size-7 shrink-0 rounded-full object-cover border border-line" %>
            <% else %>
              <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-line bg-surface-raised text-[11px] font-semibold text-muted" aria-hidden="true"><%= current_user.display_name.split.first(2).pluck(0).join.upcase %></span>
            <% end %>
          </span>
          <div class="topbar-me-menu" data-user-menu-panel>
            <div class="topbar-me-card">
              <% if profile %><%= link_to t("topbar.my_profile"), profile_path(current_user.handle, locale: params[:locale]) %><% end %>
              <%= link_to t("topbar.my_events"), my_events_path(locale: params[:locale]) %>
              <%= link_to t("accounts.nav"), account_path(locale: params[:locale]) %>
              <%= link_to t("topbar.logout"), session_path(Current.session), data: { turbo_method: :delete } %>
              <% if current_user.staff? || current_user.admin? %>
                <hr>
                <% if current_user.staff? %>
                  <%= link_to t("topbar.organizer_mode"), organizer_path_builder, class: ("on" if organizer_mode?), data: { organizer_mode: true } %>
                <% end %>
                <% if current_user.admin? %>
                  <%= link_to t("topbar.admin"), admin_root_path, class: ("on" if admin_mode?), data: { admin_mode: true } %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
        <%= render "notifications/bell" %>
      <% else %>
        <%= link_to t("topbar.sign_in"), new_session_path(locale: params[:locale]),
                    data: ({ turbo_frame: "modal" } if local_assigns[:modal_sign_in]),
                    class: small_button_classes(:secondary) %>
      <% end %>
      <button type="button" class="topbar-burger" data-menu-target="button" data-action="menu#toggle"
              aria-controls="topbar-panel" aria-expanded="false">
        <span class="sr-only"><%= t("topbar.menu") %></span>
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
