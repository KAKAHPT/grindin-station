<%# The viewer's own way out on a /my-events ticket: Drop cancels a tournament registration before the swiss and
    drops the player afterwards; Leave takes them out of a league. While the player is still in and the event has
    not finished. The rest (check-in, decklist) is in shared/_event_ticket_panel. %>
<% if event.is_a?(Tournament) && participant.playing? && !event.finished? %>
  <%= button_to t("my_events.drop"), tournament_event_participant_path(event, participant, locale: params[:locale]),
                method: :delete, params: { from: "my_events" }, form_class: "contents", class: button_classes(:secondary, size: :xs),
                data: { my_drop: true, turbo_confirm: t(event.points_locked? ? "my_events.drop_confirm" : "play.events.cancel_confirm") } %>
<% elsif event.is_a?(League) && !participant.dropped? && !event.finished? && !event.finals? %>
  <%= button_to t("leagues.registration.leave"), league_registration_path(event, locale: params[:locale]),
                method: :delete, params: { from: "my_events" }, form_class: "contents", class: button_classes(:secondary, size: :xs),
                data: { my_leave: true, turbo_confirm: t("leagues.registration.confirm_leave") } %>
<% elsif participant.dropped? %>
  <span data-my-dropped><%= desk_chip(:missing) { t("my_events.dropped") } %></span>
<% end %>
