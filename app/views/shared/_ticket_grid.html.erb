<%# A grid of event tickets (shared/_event_ticket) under an optional heading. Locals: events, enrolled (counts by
    event id), heading (optional), paginate (optional Kaminari collection). %>
<% if events.any? %>
  <section class="col-span-full" data-ticket-grid>
    <% if local_assigns[:heading] %>
      <h2 class="mb-3 font-display text-[17px] font-semibold text-ink"><%= heading %></h2>
    <% end %>
    <div class="lp-evl">
      <% events.each do |event| %>
        <%= render "shared/event_ticket", event: event, enrolled: enrolled.fetch(event.id, 0) %>
      <% end %>
    </div>
    <% if local_assigns[:paginate] %>
      <div class="mt-4"><%= paginate paginate %></div>
    <% end %>
  </section>
<% end %>
