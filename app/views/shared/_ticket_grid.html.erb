<%# A grid of event tickets (shared/_event_ticket) under an optional heading. Locals: events, enrolled (counts by
    event id), heading (optional), paginate (optional Kaminari collection), large (optional: the organizer page's
    tickets), dense (optional: /events, up to four per row), list (optional: /events?view=list, one shared/_event_row
    per event in a card). %>
<% if events.any? %>
  <section class="col-span-full" data-ticket-grid>
    <% if local_assigns[:heading] %>
      <h2 class="mb-3 font-display text-[17px] font-semibold text-ink"><%= heading %></h2>
    <% end %>
    <% if local_assigns[:list] %>
      <div class="card divide-y divide-line" data-event-list>
        <% events.each do |event| %>
          <%= render "shared/event_row", event: event, enrolled: enrolled.fetch(event.id, 0) %>
        <% end %>
      </div>
    <% else %>
      <div class="<%= class_names("lp-evl", "lp-evl-lg" => local_assigns[:large], "lp-evl-dense" => local_assigns[:dense]) %>">
        <% events.each do |event| %>
          <% count = enrolled.fetch(event.id, 0) %>
          <%= render "shared/event_ticket", event: event, enrolled: count, sold_out: event.sold_out?(count), large: local_assigns[:large] %>
        <% end %>
      </div>
    <% end %>
    <% if local_assigns[:paginate] %>
      <div class="mt-4"><%= paginate paginate %></div>
    <% end %>
  </section>
<% end %>
