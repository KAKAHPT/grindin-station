<%# Head of an event list (/events, /tournaments, /leagues, /my-events): a banner with the title, the lead and,
    when path is given, the Upcoming · Past switch beside a row of leaning commander arts; one art changes every few
    seconds, each card in turn (artswap_controller). Locals: title, lead; optional path (a lambda taking the
    filter, nil or "past") with past (bool). %>
<% arts = (1..48).map { |n| image_path("landing/c#{n}.jpg") } %>
<header class="evb col-span-full" data-list-header>
  <div class="evb-art" aria-hidden="true" data-controller="artswap" data-artswap-urls-value="<%= arts.to_json %>">
    <% arts.rotate(3).first(6).each do |src| %>
      <img src="<%= src %>" alt="" width="240" height="175" decoding="async" data-artswap-target="card">
    <% end %>
  </div>
  <div class="evb-in">
    <p class="evb-eye"><%= t("app.name") %></p>
    <h1><%= title %></h1>
    <p class="evb-lead"><%= lead %></p>
    <% if (path = local_assigns[:path]) %>
      <span class="seg evb-seg" data-list-filter>
        <%= link_to t("lists.upcoming"), path.(nil), class: ("seg-on" unless past), "aria-current": ("page" unless past) %>
        <%= link_to t("lists.past"), path.("past"), class: ("seg-on" if past), "aria-current": ("page" if past) %>
      </span>
    <% end %>
  </div>
</header>
