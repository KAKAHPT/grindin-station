<%# Active filters as chips (M13): chips = [[label, value, url without it]], clear_url: back to no filters. %>
<% if chips.any? %>
  <div class="flex flex-wrap items-center gap-1.5 mb-3" data-filter-chips>
    <% chips.each do |label, value, without| %>
      <span class="filter-chip" data-chip>
        <%= label %> <b class="font-semibold text-ink"><%= value %></b>
        <%= link_to "✕", without, class: "opacity-70 hover:opacity-100 hover:text-ink", "aria-label": t("filters.remove", label: label) %>
      </span>
    <% end %>
    <%= link_to t("filters.clear_all"), clear_url, class: "filter-chip bg-transparent hover:text-ink", data: { clear_all: true } %>
  </div>
<% end %>
