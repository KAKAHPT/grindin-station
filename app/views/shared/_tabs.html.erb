<%# Route tabs (underline teal). Local tabs: array of { label:, path:, active:, badge:, badge_data: } (badge optional;
    a tab without a path shows disabled). Optional local trailing: markup for the right end of the bar. Optional local
    pages: true draws them as the tabs of a folder, the open one joined to the .tab-page under it. %>
<nav class="tabs <%= "tabs-pages" if local_assigns[:pages] %>" data-tabs>
  <% tabs.each do |tab| %>
    <% if tab[:path] %>
      <%= link_to tab[:path], class: tab_classes(tab[:active]), "aria-current": ("page" if tab[:active]) do %>
        <%= tab[:label] %>
        <% if tab[:badge].present? %>
          <%= tag.span tab[:badge], class: "tab-badge tabular", data: tab[:badge_data] %>
        <% end %>
      <% end %>
    <% else %>
      <span class="tab tab-off" aria-disabled="true"><%= tab[:label] %></span>
    <% end %>
  <% end %>
  <% if local_assigns[:trailing].present? %><span class="ms-auto self-center shrink-0 ps-3 <%= local_assigns[:pages] ? "pe-8 py-3" : "pb-1.5" %>"><%= trailing %></span><% end %>
</nav>
