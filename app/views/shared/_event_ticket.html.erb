<%# One event ticket (option 4C), on the landing and the event lists: the cover on top with the date, name,
    format line, organizer with the state tag at the right, then the stub with the enrolled count, View event and, while a tournament's registration is open,
    Register (Join waiting list once it is sold out). Past events too.
    Locals: event (Tournament or League, cover and organizer preloaded), enrolled (count), sold_out (optional,
    computed from enrolled when not given), large (optional: the /events variant with a taller cover, the time and
    address and a description excerpt). Pieces from EventTicketHelper. %>
<% sold_out = local_assigns.fetch(:sold_out) { event.sold_out?(enrolled) } %>
<% large = local_assigns[:large] %>
<% href = ticket_href(event) %>
<%= tag.article class: ["card lp-evr", ("lp-evr-lg" if large)], data: { upcoming_event: event.slug, sold_out: ticket_sold_out?(event, sold_out) || nil } do %>
  <div class="lp-evr-cov">
    <div class="lp-evr-ban" style="background-image: url('<%= ticket_banner(event) %>')" aria-hidden="true"></div>
    <div class="lp-evr-shade" aria-hidden="true"></div>
    <div class="lp-evr-date">
      <b><%= l(event.start_time, format: "%d") %></b>
      <span><%= l(event.start_time, format: "%b · %a") %></span>
    </div>
  </div>
  <div class="lp-evr-bd">
    <h3 class="lp-evr-t"><%= link_to event.name, href %></h3>
    <p class="lp-evr-m"><%= ticket_line(event) %></p>
    <% if large %>
      <p class="lp-evr-m" data-ticket-when><%= ticket_when_where(event) %></p>
      <% if (excerpt = ticket_excerpt(event)) %>
        <p class="lp-evr-x" data-ticket-excerpt><%= excerpt %></p>
      <% end %>
    <% end %>
    <div class="lp-evr-orgrow">
      <%= ticket_organizer(event) %>
      <%= ticket_state_line(event, sold_out) %>
    </div>
  </div>
  <div class="lp-evr-stub">
    <p class="lp-evr-n"><%= ticket_enrolled(event, enrolled) %></p>
    <div class="lp-evr-act">
      <%= link_to t("landing.upcoming.view"), href, class: button_classes(:secondary, size: :xs) %>
      <%= ticket_register_button(event, sold_out) %>
    </div>
  </div>
<% end %>
