<%# One event ticket (option 4C), on the landing and the event lists: the cover on top with the state chip and the
    date, name, format line and organizer, then the perforated stub with the enrolled count, View event and, while
    a tournament's registration is open, Register. Past events too. A tournament opens at /t/:slug, a league at
    /leagues/:id. Locals: event (Tournament or League, cover and organizer preloaded), enrolled (count). %>
<% url_locale = params[:locale] %>
<% href = event.is_a?(League) ? league_path(event, locale: url_locale) : play_event_path(event.slug, locale: url_locale) %>
<% banner = if event.cover.attached? && event.cover.representable?
             rails_representation_path(event.cover.representation(resize_to_limit: [480, 480]), only_path: true)
           else
             image_path("landing/c#{Zlib.crc32(event.slug) % 48 + 1}.jpg")
           end %>
<% organizer = event.event_organizer&.user&.name %>
<% max = event.maximum_participants %>
<% city = event.address.to_s.split(",").last.to_s.strip.presence %>
<% line = [city, event_format_label(event),
           (t("organizer.shell.swiss_rounds", count: event.swiss_rounds_count) if event.swiss_rounds_count.to_i.positive?),
           (t("organizer.top_cut_option", size: event.top_cut_size) if event.top_cut_size.to_i.positive?),
           (tag.span(tournament_price(event), class: "whitespace-nowrap") if event.price.to_d.zero? || event.currency)]
          .compact %>
<article class="card lp-evr" data-upcoming-event="<%= event.slug %>">
  <div class="lp-evr-cov">
    <div class="lp-evr-ban" style="background-image: url('<%= banner %>')" aria-hidden="true"></div>
    <div class="lp-evr-shade" aria-hidden="true"></div>
    <div class="lp-evr-st"><%= event_state_chip(event, (event.rounds_count if event.rounds_count.positive?)) %></div>
    <div class="lp-evr-date">
      <b><%= l(event.start_time, format: "%d") %></b>
      <span><%= l(event.start_time, format: "%b · %a") %></span>
    </div>
  </div>
  <div class="lp-evr-bd">
    <h3 class="lp-evr-t"><%= link_to event.name, href %></h3>
    <p class="lp-evr-m"><%= safe_join(line, " · ") %></p>
    <% if organizer %>
      <p class="lp-evr-org"><i aria-hidden="true"><%= organizer.split.first(2).map { |word| word[0] }.join.upcase %></i><%= organizer %></p>
    <% end %>
  </div>
  <div class="lp-evr-stub">
    <p class="lp-evr-n"><b><%= enrolled %></b><%= max.infinite? ? t("landing.upcoming.enrolled") : t("landing.upcoming.of_max", max: max) %></p>
    <div class="lp-evr-act">
      <%= link_to t("landing.upcoming.view"), href, class: button_classes(:secondary, size: :sm) %>
      <% if event.is_a?(Tournament) && event.registration_open? %>
        <%= link_to t("landing.upcoming.register"), href, class: button_classes(:primary, size: :sm), data: { register: true } %>
      <% end %>
    </div>
  </div>
</article>
