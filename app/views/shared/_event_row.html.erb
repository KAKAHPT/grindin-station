<%# One event as a list row (/events?view=list), the same data as shared/_event_ticket: cover thumbnail, name and
    format line, date and city, organizer and state line, enrolled count with View event and Register. Stacks on
    phones. Locals: event (cover and organizer preloaded), enrolled (count). %>
<% sold_out = event.sold_out?(enrolled) %>
<% href = ticket_href(event) %>
<%= tag.article class: "grid grid-cols-[48px_1fr] items-center gap-x-3 gap-y-2 p-3 md:grid-cols-[48px_minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_auto]",
                data: { event_row: true, upcoming_event: event.slug, sold_out: ticket_sold_out?(event, sold_out) || nil } do %>
  <img src="<%= ticket_banner(event, size: 160) %>" alt="" class="size-12 rounded-md object-cover" loading="lazy">
  <div class="min-w-0">
    <h3 class="truncate text-[14px] font-semibold text-ink"><%= link_to event.name, href, class: "hover:underline" %></h3>
    <p class="truncate text-xs text-muted"><%= ticket_line(event) %></p>
  </div>
  <div class="col-span-2 min-w-0 text-xs text-muted md:col-span-1" data-row-when>
    <p class="text-ink"><%= l(event.start_time, format: "%d %b %Y · %H:%M") %></p>
    <p class="truncate"><%= ticket_city(event) %></p>
  </div>
  <div class="col-span-2 min-w-0 md:col-span-1">
    <%= ticket_organizer(event) %>
    <%= ticket_state_line(event, sold_out) %>
  </div>
  <div class="col-span-2 flex items-center gap-3 md:col-span-1 md:justify-end">
    <p class="lp-evr-n"><%= ticket_enrolled(event, enrolled) %></p>
    <div class="lp-evr-act">
      <%= link_to t("landing.upcoming.view"), href, class: button_classes(:secondary, size: :xs) %>
      <%= ticket_register_button(event, sold_out) %>
    </div>
  </div>
<% end %>
