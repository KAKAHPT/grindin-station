<%# A GET filter form (M13): fields are [name, type, options, selected, label] with type :search (options = the
    placeholder), :segment (options = [[label, value]], links to the current query with that value; a hidden field keeps
    it for the other fields; the links go to the current page with only the bar's params) or :select (options =
    [[label, value]], submits on change via submit-on-change). Locals:
    url:, fields:, count: (text on the right), hidden: {} (extra hidden fields, e.g. the tab). %>
<% hidden = local_assigns.fetch(:hidden, {}) %>
<%# Segment links keep only this bar's own params (its fields and hidden fields) and point at the current page. %>
<% kept = params.permit(*fields.map { |field| field.first.to_s }).to_h.merge(hidden.stringify_keys).compact_blank %>
<%= form_with url: url, method: :get, local: true, data: { turbo_frame: "_top", filter_bar: true },
              class: "flex flex-wrap items-center gap-2 my-3.5" do %>
  <% hidden.each do |name, value| %>
    <%= hidden_field_tag name, value, id: nil %>
  <% end %>
  <% fields.each do |name, type, options, selected, label| %>
    <% case type %>
    <% when :search %>
      <label class="flex flex-1 min-w-[200px] items-center gap-2 h-9 px-2.5 rounded-md border border-line-strong bg-ground text-muted">
        <svg aria-hidden="true" class="size-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <%= search_field_tag name, selected, id: nil, placeholder: options, "aria-label": options,
                             class: "flex-1 min-w-0 border-0 bg-transparent p-0 text-[13px] text-ink placeholder:text-muted focus:ring-0" %>
      </label>
    <% when :segment %>
      <%= hidden_field_tag name, selected, id: nil %>
      <span class="seg" role="group" aria-label="<%= label %>">
        <% options.each do |text, value| %>
          <% href = url_for(kept.merge(name.to_s => value, "only_path" => true)) %>
          <%= link_to text, href, class: ("seg-on" if value.to_s == selected.to_s),
                      "aria-current": (value.to_s == selected.to_s).to_s %>
        <% end %>
      </span>
    <% when :select %>
      <%= select_tag name, options_for_select(options, selected), id: nil, "aria-label": label,
                     class: "field-input w-auto h-9 pr-8 text-[12.5px]",
                     data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
    <% end %>
  <% end %>
  <button type="submit" class="sr-only"><%= t("filters.apply") %></button>
  <span class="ml-auto text-xs text-muted" data-filter-count><%= count %></span>
<% end %>
