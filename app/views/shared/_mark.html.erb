<%# The Grindin Station mark: a dark steel wheel with a thin teal rim and thickness, and a teal cut stone, point
    down, in its sunken hub. Locals: size (px, default 30), rotating (true only in the top bar and the
    event-header corner; the wheel turns, each layer about its own centre so the thickness keeps pointing down:
    see .gslogo .gear in application.css). Each mark carries its own <defs>; the ids get a deterministic suffix
    (local id_suffix, else a per-request counter) so several marks can share a page and a Turbo morph refresh sees
    identical markup (the wheel keeps turning instead of restarting). %>
<% size = local_assigns.fetch(:size, 30) %>
<% @mark_seq = @mark_seq.to_i + 1 %>
<% uid = "-#{local_assigns[:id_suffix] || @mark_seq}" %>
<% if local_assigns[:rotating] %>
<svg class="<%= ["gslogo", local_assigns[:class]].compact.join(" ") %>" viewBox="0 0 100 100" width="<%= size %>" height="<%= size %>" aria-hidden="true" focusable="false" data-rotating>
<% else %>
<svg class="<%= ["gslogo", local_assigns[:class]].compact.join(" ") %>" viewBox="0 0 100 100" width="<%= size %>" height="<%= size %>" aria-hidden="true" focusable="false">
<% end %>
