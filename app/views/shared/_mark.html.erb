<%# The small mark: the G tile of the logo (shared/_logo), for the places too small for the whole name: the top bar,
    the event-header corner, the round-clock screen. Locals: size (the tile's height in px, default 30), class. %>
<% size = local_assigns.fetch(:size, 30) %>
<span class="<%= ["gslogo", "gsl", local_assigns[:class]].compact.join(" ") %>" style="font-size: <%= (size / 1.3).round(2) %>px" aria-hidden="true"><span class="gsl-flap"><span>G</span></span></span>
