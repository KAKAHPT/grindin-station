<%# The Grindin Station mark: point-down teal slab, dark gear, teal S. Locals: size (px, default 30), rotating
    (true only in the top bar and the event-header corner; the gear turns, see .gslogo .gear in application.css).
    Each mark carries its own gradient <defs>; the ids get a deterministic suffix (local id_suffix, else a per-request
    counter) so several marks can share a page and a Turbo morph refresh sees identical markup (the gear keeps
    turning instead of restarting). %>
<% size = local_assigns.fetch(:size, 30) %>
<% @mark_seq = @mark_seq.to_i + 1 %>
<% uid = "-#{local_assigns[:id_suffix] || @mark_seq}" %>
<% if local_assigns[:rotating] %>
<svg class="<%= ["gslogo", local_assigns[:class]].compact.join(" ") %>" viewBox="0 0 100 100" width="<%= size %>" height="<%= size %>" aria-hidden="true" focusable="false" data-rotating>
<% else %>
<svg class="<%= ["gslogo", local_assigns[:class]].compact.join(" ") %>" viewBox="0 0 100 100" width="<%= size %>" height="<%= size %>" aria-hidden="true" focusable="false">
<% end %>
<defs><linearGradient id="gsT<%= uid %>" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#6ff2e0"/><stop offset=".6" stop-color="#2dd4bf"/><stop offset="1" stop-color="#139c8b"/></linearGradient><linearGradient id="gsG<%= uid %>" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2b3138"/><stop offset="1" stop-color="#0d0f11"/></linearGradient><radialGradient id="gsS<%= uid %>" cx=".5" cy=".3" r=".7"><stop offset="0" stop-color="#8ff7e8"/><stop offset="1" stop-color="#2dd4bf"/></radialGradient></defs><g transform="translate(0 91) scale(1 -1)"><path d="M50 7c2.4 0 4.6 1.3 5.8 3.4l37 64c2.4 4.2-.6 9.6-5.8 9.6H13c-5.2 0-8.2-5.4-5.8-9.6l37-64C45.4 8.3 47.6 7 50 7Z" fill="url(#gsT<%= uid %>)"/><path d="M50 15.5 82 72H18L50 15.5Z" fill="none" stroke="#fff" stroke-opacity=".16" stroke-width="1.2"/></g><g transform="translate(0 -21)"><g class="gear"><path fill="url(#gsG<%= uid %>)" fill-rule="evenodd" d="M68.20 58.00 L68.03 60.51 L72.10 62.22 L71.31 65.22 L66.92 64.70 L64.72 68.70 L63.11 70.62 L65.40 74.40 L63.00 76.37 L59.75 73.37 L55.62 75.31 L53.19 75.92 L52.82 80.32 L49.72 80.50 L48.86 76.16 L44.38 75.31 L42.04 74.37 L39.16 77.72 L36.55 76.04 L38.40 72.02 L35.28 68.70 L33.94 66.57 L29.64 67.58 L28.52 64.68 L32.37 62.53 L31.80 58.00 L31.97 55.49 L27.90 53.78 L28.69 50.78 L33.08 51.30 L35.28 47.30 L36.89 45.38 L34.60 41.60 L37.00 39.63 L40.25 42.63 L44.38 40.69 L46.81 40.08 L47.18 35.68 L50.28 35.50 L51.14 39.84 L55.62 40.69 L57.96 41.63 L60.84 38.28 L63.45 39.96 L61.60 43.98 L64.72 47.30 L66.06 49.43 L70.36 48.42 L71.48 51.32 L67.63 53.47Z M63.5 58 a13.5 13.5 0 1 0 -27 0 a13.5 13.5 0 1 0 27 0Z"/><circle cx="50" cy="58" r="13.5" fill="#15181b"/></g><path d="M55.6 51.6c-.9-2.3-3.1-3.5-5.6-3.5-3.3 0-5.6 1.9-5.6 4.5 0 6.3 11.6 3.3 11.6 9.9 0 3.1-2.8 5.1-6.2 5.1-3 0-5.5-1.4-6.4-4.1" fill="none" stroke="url(#gsS<%= uid %>)" stroke-width="4" stroke-linecap="round" transform="translate(0.3 0.15)"/></g>
</svg>
