# Secrets referenced by config/deploy.yml (registry/password, env/secret, accessories/*/env/secret).
# Everything is read from ENV: GitHub Actions maps repository secrets to ENV in .github/workflows/deploy.yml;
# for a manual deploy, export the same variables in your shell first.
# DO NOT ENTER RAW CREDENTIALS HERE! This file is committed to git.

# ghcr.io token (GITHUB_TOKEN in Actions, or a PAT with write:packages locally).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Postgres accessory superuser (grindin) password: the accessory and bin/backup only.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
# The app connects as grindin_app (no superuser; created by config/postgres/init.sql) over the kamal Docker
# network. postgis:// keeps the postgis adapter (postgres:// would switch it to postgresql).
POSTGRES_APP_PASSWORD=$POSTGRES_APP_PASSWORD
PRIMARY_DATABASE_URL=postgis://grindin_app:$POSTGRES_APP_PASSWORD@grindin-station-db:5432/grindin_station_production
CACHE_DATABASE_URL=postgis://grindin_app:$POSTGRES_APP_PASSWORD@grindin-station-db:5432/grindin_station_production_cache
QUEUE_DATABASE_URL=postgis://grindin_app:$POSTGRES_APP_PASSWORD@grindin-station-db:5432/grindin_station_production_queue
CABLE_DATABASE_URL=postgis://grindin_app:$POSTGRES_APP_PASSWORD@grindin-station-db:5432/grindin_station_production_cable

# Optional: sign in with Google / Discord (buttons hide when the client id is empty).
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
DISCORD_CLIENT_ID=$DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=$DISCORD_CLIENT_SECRET

# Optional: outgoing mail (password reset). SMTP is used only when SMTP_ADDRESS is set.
SMTP_ADDRESS=$SMTP_ADDRESS
SMTP_PORT=$SMTP_PORT
SMTP_DOMAIN=$SMTP_DOMAIN
SMTP_USER_NAME=$SMTP_USER_NAME
SMTP_PASSWORD=$SMTP_PASSWORD
