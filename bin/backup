#!/usr/bin/env bash
# Daily Postgres backup for the grindin-station-db Kamal accessory. Runs on the VPS host (see config/backup.cron).
#   bin/backup            dump the primary database, copy it off-site if RCLONE_REMOTE is set, keep the newest KEEP dumps
#   bin/backup --dry-run  skip pg_dump and rclone; only run the rotation against existing dumps (used by the tests)
# ENV: BACKUP_DIR (default /var/backups/grindin-station), KEEP (default 14), RCLONE_REMOTE (e.g. b2:grindin-backups).
# Safe to re-run: each run writes one new timestamped dump and the rotation always converges to KEEP files.
set -euo pipefail

BACKUP_DIR=${BACKUP_DIR:-/var/backups/grindin-station}
KEEP=${KEEP:-14}
DB_CONTAINER=${DB_CONTAINER:-grindin-station-db}
DB_NAME=${DB_NAME:-grindin_station_production}
DRY_RUN=false

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    *) echo "usage: bin/backup [--dry-run]" >&2; exit 64 ;;
  esac
done

if ! [[ "$KEEP" =~ ^[1-9][0-9]*$ ]]; then
  echo "KEEP must be a positive integer (got '$KEEP')" >&2
  exit 64
fi

mkdir -p "$BACKUP_DIR"

if [ "$DRY_RUN" = true ]; then
  echo "dry run: skipping pg_dump and rclone"
else
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  target="$BACKUP_DIR/$stamp.dump"
  partial="$target.partial"
  # Write to a temporary name first so a failed dump never counts as a backup in the rotation.
  trap 'rm -f "$partial"' EXIT
  docker exec "$DB_CONTAINER" pg_dump -U grindin -Fc "$DB_NAME" > "$partial"
  mv "$partial" "$target"
  trap - EXIT
  echo "wrote $target"

  if [ -n "${RCLONE_REMOTE:-}" ]; then
    rclone copy "$target" "$RCLONE_REMOTE"
    echo "copied $target to $RCLONE_REMOTE"
  fi
fi

# Rotation: timestamped names sort chronologically; delete everything but the newest KEEP dumps.
dumps=()
while IFS= read -r file; do
  dumps+=("$file")
done < <(find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.dump' | sort)

excess=$(( ${#dumps[@]} - KEEP ))
if [ "$excess" -gt 0 ]; then
  for file in "${dumps[@]:0:$excess}"; do
    rm -f -- "$file"
    echo "removed $file"
  done
fi
echo "kept $(( ${#dumps[@]} < KEEP ? ${#dumps[@]} : KEEP )) dump(s) in $BACKUP_DIR"
